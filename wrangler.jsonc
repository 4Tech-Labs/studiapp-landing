{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studiapp-landing",
  "compatibility_date": "2026-09-01",
  // Worker de solo assets estáticos: los requests a estáticos son gratis e ilimitados en el plan Free.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
