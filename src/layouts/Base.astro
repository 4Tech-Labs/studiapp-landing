---
import { Font } from 'astro:assets';
import { SITE } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = SITE.title, description = SITE.description, noindex = false } = Astro.props;
// Con build.format 'file' el pathname llega como /pagina.html; la URL pública es /pagina (Cloudflare sirve el .html sin extensión).
const cleanPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(cleanPath, SITE.url).href;
const ogImage = new URL(SITE.ogImage, SITE.url).href;
const id = (h: string) => `${SITE.url}/#${h}`;

// Mismo grafo que el original inyectaba por JS, ahora renderizado en build.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': id('organization'),
      name: SITE.name,
      url: `${SITE.url}/`,
      email: SITE.email,
      logo: new URL('/apple-touch-icon.png', SITE.url).href,
    },
    {
      '@type': 'WebSite',
      '@id': id('website'),
      url: `${SITE.url}/`,
      name: SITE.name,
      inLanguage: SITE.lang,
      publisher: { '@id': id('organization') },
    },
    {
      '@type': 'WebPage',
      '@id': id('webpage'),
      url: canonical,
      name: title,
      description,
      inLanguage: SITE.lang,
      isPartOf: { '@id': id('website') },
      about: { '@id': id('app') },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': id('app'),
      name: SITE.name,
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Web',
      description: SITE.description,
      inLanguage: SITE.lang,
      publisher: { '@id': id('organization') },
    },
  ],
};
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-inter-tight" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-outfit" />
    <Font cssVariable="--font-instrument-serif" />

    <slot name="head" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <slot />
  </body>
</html>
