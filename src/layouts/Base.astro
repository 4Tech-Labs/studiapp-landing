---
import { Font } from 'astro:assets';
import { SITE, SOCIAL, COMPANY, TEAM, PRODUCT, SERVICES } from '../data/site';
import { BUILD_DATE } from '../lib/build-date';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Página de un producto (StudIApp): el WebPage trata del SoftwareApplication y no de la empresa. */
  product?: boolean;
}

const { title = SITE.title, description = SITE.description, noindex = false, product = false } = Astro.props;
// Con build.format 'file' el pathname llega como /pagina.html; la URL pública es /pagina (Cloudflare sirve el .html sin extensión).
const cleanPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(cleanPath, SITE.url).href;
const id = (h: string) => `${SITE.url}/#${h}`;
// Iconos de la pestaña: el "4" del logo 4TL en el sitio de la empresa; el robot en la página de StudIApp.
const iconPrefix = product ? '/studiapp-' : '/';
// Imagen al compartir: la de la empresa, o la de StudIApp en su página.
const ogImage = new URL(product ? PRODUCT.ogImage : SITE.ogImage, SITE.url).href;
const ogImageAlt = product ? `${PRODUCT.name}: ${PRODUCT.tagline}` : `${COMPANY.name}: convertimos tus ideas en software a la medida`;
// Perfiles de la empresa en redes: enlazan la organización con su página de LinkedIn, etc.
const sameAs = Object.values(SOCIAL).filter(Boolean);
const team = TEAM.map((m) => ({ '@type': 'Person', name: m.name, jobTitle: m.role, ...(m.linkedin && { sameAs: [m.linkedin] }) }));
const founders = team.filter((m) => /cofundador/i.test(m.jobTitle));
const phone = COMPANY.phone.replace(/\s/g, '');
// Miga de pan de las páginas interiores (Inicio › página). El home y las páginas fuera del índice no la llevan.
const crumb = cleanPath !== '/' && !noindex ? (product ? PRODUCT.name : title.split(' | ')[0]) : '';

// La organización es la empresa (dueña del dominio y del sitio); el producto es el SoftwareApplication de su catálogo.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      // ProfessionalService (un tipo de negocio local) suma la dirección y el área de servicio a la organización.
      '@type': ['Organization', 'ProfessionalService'],
      '@id': id('organization'),
      name: COMPANY.name,
      alternateName: COMPANY.alternateNames,
      legalName: COMPANY.legalName,
      description: SITE.description,
      ...(COMPANY.taxId && { taxID: COMPANY.taxId }),
      ...(COMPANY.foundingDate && { foundingDate: COMPANY.foundingDate }),
      url: `${SITE.url}/`,
      email: SITE.email,
      telephone: phone,
      address: { '@type': 'PostalAddress', ...COMPANY.postalAddress },
      areaServed: { '@type': 'Country', name: 'Colombia' },
      logo: new URL('/4techlabs-logo.png', SITE.url).href,
      image: new URL(SITE.ogImage, SITE.url).href,
      contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: SITE.email, telephone: phone, availableLanguage: ['es'] },
      ...(sameAs.length > 0 && { sameAs }),
      ...(founders.length > 0 && { founder: founders }),
      ...(team.length > 0 && { employee: team }),
      memberOf: { '@type': 'Organization', name: 'NVIDIA Inception Program', url: 'https://www.nvidia.com/en-us/startups/' },
      // Los servicios de la sección Servicios del home, cada uno con su ancla
      ...(SERVICES.length > 0 && {
        knowsAbout: SERVICES.map((s) => s.title),
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: 'Servicios de desarrollo de software',
          itemListElement: SERVICES.map((s) => ({
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: s.title, description: s.text, url: `${SITE.url}/#${s.id}`, provider: { '@id': id('organization') } },
          })),
        },
      }),
    },
    {
      '@type': 'WebSite',
      '@id': id('website'),
      url: `${SITE.url}/`,
      // name y alternateName son los que Google usa para el nombre del sitio en los resultados
      name: SITE.name,
      alternateName: COMPANY.alternateNames,
      inLanguage: SITE.lang,
      publisher: { '@id': id('organization') },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: SITE.lang,
      dateModified: BUILD_DATE,
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
      isPartOf: { '@id': id('website') },
      about: { '@id': id(product ? 'app' : 'organization') },
      ...(crumb && { breadcrumb: { '@id': `${canonical}#breadcrumb` } }),
    },
    ...(crumb
      ? [
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonical}#breadcrumb`,
            itemListElement: [
              { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
              { '@type': 'ListItem', position: 2, name: crumb, item: canonical },
            ],
          },
        ]
      : []),
    {
      '@type': 'SoftwareApplication',
      '@id': id('app'),
      name: PRODUCT.name,
      url: new URL(PRODUCT.path, SITE.url).href,
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Web',
      description: PRODUCT.description,
      inLanguage: SITE.lang,
      publisher: { '@id': id('organization') },
    },
  ],
};
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Las páginas fuera del índice (404, /og) no declaran URL canónica. En las demás, Google puede mostrar la imagen
        grande y el fragmento completo en los resultados. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" href={`${iconPrefix}favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${iconPrefix}favicon-96.png`} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={`${iconPrefix}apple-touch-icon.png`} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {/* Última modificación (fecha del último commit): la misma del sitemap y del JSON-LD */}
    <meta property="og:updated_time" content={BUILD_DATE} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <Font cssVariable="--font-hero" preload />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload />

    <slot name="head" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
    {
      // Visitas en cifras agregadas, sin cookies. No en las páginas fuera del índice (/og, 404): no son visitas reales.
      SITE.analyticsToken && !noindex && (
        <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: SITE.analyticsToken })}></script>
      )
    }
  </head>
  <body>
    <slot />
    <script>
      // Respaldo de la ola de los titulares (WaveTitle); en las páginas sin titulares con ola no hace nada.
      import '../scripts/wave-title';
    </script>
  </body>
</html>
