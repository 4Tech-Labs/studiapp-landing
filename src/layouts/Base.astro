---
import { Font } from 'astro:assets';
import { SITE, SOCIAL, COMPANY, TEAM, PRODUCT } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Página de un producto (StudIApp): el WebPage trata del SoftwareApplication y no de la empresa. */
  product?: boolean;
}

const { title = SITE.title, description = SITE.description, noindex = false, product = false } = Astro.props;
// Con build.format 'file' el pathname llega como /pagina.html; la URL pública es /pagina (Cloudflare sirve el .html sin extensión).
const cleanPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(cleanPath, SITE.url).href;
const ogImage = new URL(SITE.ogImage, SITE.url).href;
const id = (h: string) => `${SITE.url}/#${h}`;
// Perfiles de la empresa en redes: enlazan la organización con su página de LinkedIn, etc.
const sameAs = Object.values(SOCIAL).filter(Boolean);
const team = TEAM.map((m) => ({ '@type': 'Person', name: m.name, jobTitle: m.role, ...(m.linkedin && { sameAs: [m.linkedin] }) }));

// La organización es la empresa (dueña del dominio y del sitio); el producto es el SoftwareApplication de su catálogo.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': id('organization'),
      name: COMPANY.name,
      legalName: COMPANY.legalName,
      ...(COMPANY.taxId && { taxID: COMPANY.taxId }),
      ...(COMPANY.foundingDate && { foundingDate: COMPANY.foundingDate }),
      url: `${SITE.url}/`,
      email: SITE.email,
      telephone: COMPANY.phone.replace(/\s/g, ''),
      address: { '@type': 'PostalAddress', ...COMPANY.postalAddress },
      logo: new URL('/4techlabs-logo.png', SITE.url).href,
      ...(sameAs.length > 0 && { sameAs }),
      ...(team.length > 0 && { employee: team }),
      memberOf: { '@type': 'Organization', name: 'NVIDIA Inception Program', url: 'https://www.nvidia.com/en-us/startups/' },
    },
    {
      '@type': 'WebSite',
      '@id': id('website'),
      url: `${SITE.url}/`,
      name: SITE.name,
      inLanguage: SITE.lang,
      publisher: { '@id': id('organization') },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: SITE.lang,
      isPartOf: { '@id': id('website') },
      about: { '@id': id(product ? 'app' : 'organization') },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': id('app'),
      name: PRODUCT.name,
      url: new URL(PRODUCT.path, SITE.url).href,
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Web',
      description: PRODUCT.description,
      inLanguage: SITE.lang,
      publisher: { '@id': id('organization') },
    },
  ],
};
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload />

    <slot name="head" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <slot />
  </body>
</html>
