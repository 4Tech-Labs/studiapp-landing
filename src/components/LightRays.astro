---
// Haces de luz en WebGL2 (port sin React de <LightRays /> de React Bits, ver src/lib/light-rays.js).
// Las props son las mismas del componente original; se pasan al script como JSON en data-options.
// Llena su contenedor: el padre necesita position relative y un alto. No recibe clics (pointer-events: none).
interface Props {
  raysOrigin?: 'top-center' | 'top-left' | 'top-right' | 'left' | 'right' | 'bottom-center' | 'bottom-left' | 'bottom-right';
  raysColor?: string;
  raysSpeed?: number;
  lightSpread?: number;
  rayLength?: number;
  rayDensity?: number;
  tilt?: number;
  raySharpness?: number;
  glow?: number;
  haze?: number;
  atmosphere?: number;
  intensity?: number;
  pulsating?: boolean;
  fadeDistance?: number;
  saturation?: number;
  followMouse?: boolean;
  mouseInfluence?: number;
  cursorShadow?: boolean;
  clickPulse?: boolean;
  noiseAmount?: number;
  distortion?: number;
  intro?: boolean;
  lightMode?: boolean;
  opacity?: number;
  maxDevicePixelRatio?: number;
  class?: string;
}

// Astro agrega atributos data-astro-cid-* de quien usa el componente: no son opciones de los rayos.
const { class: className, ...props } = Astro.props;
const options = Object.fromEntries(Object.entries(props).filter(([key]) => !key.startsWith('data-')));
---

<div class:list={['light-rays', className]} data-light-rays data-options={JSON.stringify(options)}>
  <canvas class="light-rays-canvas" aria-hidden="true"></canvas>
</div>

<style>
  .light-rays {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
  }
  .light-rays-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { mountLightRays } from '../lib/light-rays.js';

  // Se monta (contexto WebGL + shaders) solo cuando el contenedor se acerca a la pantalla, no al cargar la página.
  const lazy = new IntersectionObserver(
    (entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        if (!isIntersecting) return;
        lazy.unobserve(target);
        const el = target as HTMLElement;
        mountLightRays(el, JSON.parse(el.dataset.options || '{}'));
      });
    },
    { rootMargin: '300px' },
  );
  document.querySelectorAll<HTMLElement>('[data-light-rays]').forEach((el) => lazy.observe(el));
</script>
