---
// Luz que recorre sin parar el filo de un botón; al pasar el mouse (o con el foco del teclado) se abre por casi todo
// el filo y el botón se ilumina desde abajo. Va como primer hijo del botón, que necesita position: relative e
// isolation: isolate y no lleva fondo propio: el relleno lo pinta este componente, 1 px más adentro del filo.
// La luz es el azul claro de los anillos: pensada para fondo oscuro.
interface Props {
  /** Relleno del botón (cualquier valor de background). */
  fill: string;
  /** Filo de 1 px por donde pasa la luz; del color del relleno, la luz es lo único que se ve en el borde. */
  edge: string;
}

const { fill, edge } = Astro.props;
---

<span aria-hidden="true" class="sweep" style={`--sweep-fill:${fill};--sweep-edge:${edge}`}><span class="glow"></span></span>

<style>
  /* La luz es un conic-gradient en un cuadrado más grande que el botón que gira con transform (corre en el hilo
     gráfico; animar el ángulo del degradado repintaría cada cuadro). El relleno la tapa salvo el último píxel. */
  @property --sweep-arc {
    syntax: '<percentage>';
    initial-value: 5%;
    inherits: false;
  }
  .sweep {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    overflow: hidden;
    background: var(--sweep-edge);
    pointer-events: none;
  }
  .sweep::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150%;
    aspect-ratio: 1;
    translate: -50% -50%;
    background: conic-gradient(
      transparent,
      #8fb3ff var(--sweep-arc),
      hsl(0 0% 100%) calc(var(--sweep-arc) * 2),
      #8fb3ff calc(var(--sweep-arc) * 3),
      transparent calc(var(--sweep-arc) * 4)
    );
    animation: sweep-spin 3.5s linear infinite;
    transition: --sweep-arc 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .sweep::after {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    background: var(--sweep-fill);
  }
  .glow {
    position: absolute;
    inset: 1px;
    z-index: 1;
    border-radius: inherit;
    box-shadow: inset 0 -10px 22px -6px rgb(143 179 255 / 0.75);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  :global(:is(:hover, :focus-visible)) > .sweep::before {
    --sweep-arc: 18%;
  }
  :global(:is(:hover, :focus-visible)) > .sweep .glow {
    opacity: 1;
  }
  @keyframes sweep-spin {
    to {
      rotate: 1turn;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sweep::before {
      animation: none;
    }
  }
</style>
