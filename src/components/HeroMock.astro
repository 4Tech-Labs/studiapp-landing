---
/** Maqueta del panel (modo hero 'mock'). Textos adaptados a StudIApp; el original traía copy de una plantilla fintech. */
const rows = [
  { date: '18 mar', desc: 'Planeación anual · Matemáticas 5°', grade: 'Primaria', status: 'En revisión', tone: 'amber' },
  { date: '17 mar', desc: 'Periodo 1 · Lenguaje 9°', grade: 'Bachillerato', status: 'Completada', tone: 'green' },
  { date: '15 mar', desc: 'Semana 8 · Ciencias 3°', grade: 'Primaria', status: 'Completada', tone: 'green' },
  { date: '14 mar', desc: 'Ajuste PIAR · Grupo 7B', grade: 'Bachillerato', status: 'Completada', tone: 'green' },
];
---

<div role="img" aria-label="Vista previa del panel de StudIApp" class="mock">
  <div aria-hidden="true" class="top">
    <div class="brand">
      <span class="mark">S</span><span class="name">StudIApp</span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="hsl(184 5% 55%)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </div>
    <div class="search">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <span class="grow">Buscar planeaciones</span><span class="kbd">⌘K</span>
    </div>
    <div class="right">
      <span class="pill-btn">Nueva planeación</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="hsl(184 5% 55%)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
      <span class="avatar">LD</span>
    </div>
  </div>
  <div aria-hidden="true" class="cols">
    <div class="side">
      <div class="nav-item active">Inicio</div>
      <div class="nav-item"><span>Planeaciones</span><span class="count">10</span></div>
      <div class="nav-item">Plantillas</div>
      <div class="nav-item">Periodos</div>
      <div class="nav-item">Grupos</div>
      <div class="nav-item">Equipo</div>
      <div class="group">Flujos</div>
      <div class="nav-item">Anual</div>
      <div class="nav-item">Periódica</div>
      <div class="nav-item">Semanal</div>
      <div class="nav-item">DUA y PIAR</div>
    </div>
    <div class="main">
      <div class="welcome">Bienvenida, Laura</div>
      <div class="chips">
        <span class="chip primary">Nueva planeación</span><span class="chip">Anual</span><span class="chip">Periódica</span><span class="chip">Semanal</span><span class="chip">DUA / PIAR</span><span class="chip">Importar plantilla</span><span class="more">Personalizar</span>
      </div>
      <div class="cards">
        <div class="card">
          <div class="card-label">
            <span>Planeaciones generadas</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#0040a3" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <div class="big">128<span class="small"> este año</span></div>
          <div class="stats">
            <div><div class="k">Últimos 30 días</div></div>
            <div><div class="k">Completadas</div><div class="up">+64</div></div>
            <div><div class="k">Pendientes</div><div class="down">12</div></div>
          </div>
          <svg viewBox="0 0 400 80" preserveAspectRatio="none" class="chart">
            <defs><linearGradient id="mockFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#0040a3" stop-opacity="0.15"></stop><stop offset="100%" stop-color="#0040a3" stop-opacity="0"></stop></linearGradient></defs>
            <path d="M0,62 C40,58 60,34 100,38 C140,42 160,66 200,50 C240,34 260,18 300,26 C340,34 360,40 400,10 L400,80 L0,80 Z" fill="url(#mockFill)"></path>
            <path d="M0,62 C40,58 60,34 100,38 C140,42 160,66 200,50 C240,34 260,18 300,26 C340,34 360,40 400,10" fill="none" stroke="#0040a3" stroke-width="1.5" vector-effect="non-scaling-stroke"></path>
          </svg>
        </div>
        <div class="card">
          <div class="card-head">
            <span>Plantillas del colegio</span>
            <span class="icons">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="2"></circle><circle cx="12" cy="12" r="2"></circle><circle cx="12" cy="19" r="2"></circle></svg>
            </span>
          </div>
          <div class="row"><span class="k">Preescolar</span><span class="v">4 formatos</span></div>
          <div class="row"><span class="k">Primaria</span><span class="v">6 formatos</span></div>
          <div class="row"><span class="k">Bachillerato</span><span class="v">8 formatos</span></div>
        </div>
      </div>
      <div class="table">
        <div class="table-title">Actividad reciente</div>
        <div class="thead"><span>Fecha</span><span>Descripción</span><span class="r">Grado</span><span class="r">Estado</span></div>
        {
          rows.map((t) => (
            <div class="tr">
              <span class="k">{t.date}</span>
              <span class="d">{t.desc}</span>
              <span class="r d">{t.grade}</span>
              <span class="r">
                <span class:list={['badge', t.tone]}>{t.status}</span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .mock {
    background: hsl(0 0% 100%);
    border-radius: 10px;
    border: 1px solid var(--line);
    overflow: hidden;
    font-size: 11px;
    user-select: none;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    color: var(--ink);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .mark {
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: var(--ink);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 10px;
  }
  .name {
    font-weight: 500;
  }
  .search {
    flex: 1;
    min-width: 0;
    max-width: 320px;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 5px 10px;
    color: var(--muted);
    background: hsl(0 0% 96% / 0.5);
  }
  .grow {
    flex: 1;
  }
  .kbd {
    font-size: 10px;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0 4px;
    background: #fff;
  }
  .right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }
  .pill-btn {
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 4px 10px;
    font-weight: 500;
    white-space: nowrap;
  }
  .avatar {
    width: 24px;
    height: 24px;
    border-radius: 9999px;
    background: var(--accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 600;
  }
  .cols {
    display: flex;
    min-height: 0;
  }
  .side {
    width: 160px;
    flex-shrink: 0;
    border-right: 1px solid var(--line);
    padding: 12px 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .nav-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px;
    border-radius: 6px;
    color: var(--muted);
  }
  .nav-item.active {
    background: hsl(0 0% 96%);
    color: var(--ink);
    font-weight: 500;
  }
  .count {
    background: hsl(0 0% 96%);
    color: var(--ink);
    border-radius: 9999px;
    padding: 0 6px;
    font-size: 9px;
    font-weight: 500;
  }
  .group {
    padding: 16px 10px 4px;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .main {
    flex: 1;
    min-width: 0;
    background: hsl(0 0% 96% / 0.3);
    padding: clamp(12px, 2vw, 20px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .welcome {
    font-size: 14px;
    font-weight: 600;
  }
  .chips {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    font-size: 10px;
  }
  .chip {
    border-radius: 9999px;
    padding: 5px 12px;
    border: 1px solid var(--line);
    background: #fff;
  }
  .chip.primary {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
    font-weight: 500;
  }
  .more {
    margin-left: 6px;
    color: var(--muted);
  }
  .cards {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .card {
    flex: 1 1 220px;
    min-width: 0;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .card-label {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
  }
  .big {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .small {
    font-size: 12px;
    color: var(--muted);
    font-weight: 400;
  }
  .stats {
    display: flex;
    gap: 20px;
    font-size: 10px;
  }
  .k {
    color: var(--muted);
  }
  .up {
    color: #16a34a;
    font-weight: 500;
  }
  .down {
    color: #dc2626;
    font-weight: 500;
  }
  .chart {
    width: 100%;
    height: 80px;
    display: block;
    overflow: visible;
  }
  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
    font-weight: 500;
  }
  .icons {
    display: flex;
    gap: 10px;
    color: var(--muted);
  }
  .row {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    font-size: 12px;
  }
  .v {
    font-weight: 500;
  }
  .table {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 16px;
  }
  .table-title {
    font-weight: 500;
    margin-bottom: 10px;
  }
  .thead,
  .tr {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr 1fr;
    gap: 8px;
    align-items: center;
  }
  .thead {
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 10px;
  }
  .tr {
    padding: 8px 0;
    border-bottom: 1px solid hsl(0 0% 96%);
  }
  .d {
    font-weight: 500;
  }
  .r {
    text-align: right;
  }
  .badge {
    display: inline-block;
    border-radius: 9999px;
    padding: 2px 8px;
    font-size: 9px;
    font-weight: 500;
  }
  .badge.amber {
    background: #fef3c7;
    color: #b45309;
  }
  .badge.green {
    background: #dcfce7;
    color: #15803d;
  }
  @media (max-width: 899px) {
    .side {
      display: none;
    }
  }
  @media (max-width: 639px) {
    .search,
    .pill-btn {
      display: none;
    }
  }
</style>
