---
import VideoPlayer from './VideoPlayer.astro';
import Grainient from './Grainient.astro';
import { INCLUSION } from '../data/site';

// Misma paleta azul y ajustes del fondo de la tarjeta de StudIApp en el catálogo del home (Catalog.astro).
const GRAINIENT_BLUE = ['#eef5ff', '#cfe0ff', '#9ec0ff', '#7b93f5', '#5b6ee8'];
---

<!-- Misma tarjeta que Plantillas, espejada: el video a la izquierda en escritorio, el copy primero en móvil y en el DOM. -->
<section id="inclusion" aria-labelledby="inclusion-titulo" class="inclusion" data-screen-label="Inclusión">
  <div class="wrap">
    <div class="copy">
      <p class="kicker">DUA y PIAR</p>
      <h2 id="inclusion-titulo">{INCLUSION.title[0]} <span class="accent">{INCLUSION.title[1]}</span></h2>
      <p>{INCLUSION.text}</p>
    </div>
    <div class="art">
      <span class="art-bg" aria-hidden="true">
        <Grainient colors={GRAINIENT_BLUE} angle={55} flow={0.8} silk={0.35} grainAmount={0} dpr={1} />
      </span>
      <div class="media-box">
        <VideoPlayer label={INCLUSION.label} webm={INCLUSION.video.webm} mp4={INCLUSION.video.mp4} poster={INCLUSION.video.poster} />
      </div>
    </div>
  </div>
</section>

<style>
  .inclusion {
    margin-top: var(--gap);
    border-radius: var(--radius);
    background: hsl(0 0% 100%);
    box-shadow: inset 0 0 0 1px hsl(0 0% 93%);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0;
  }
  .wrap {
    width: 100%;
    display: flex;
    flex-direction: row-reverse; /* al envolver, el copy queda arriba */
    flex-wrap: wrap;
    align-items: stretch;
    gap: clamp(16px, 3vw, 48px);
    padding: clamp(16px, 2.4vw, 32px);
  }
  .copy {
    flex: 1 1 min(340px, 100%);
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    padding: clamp(24px, 4vw, 64px) clamp(8px, 3.5vw, 64px);
  }
  /* Misma etiqueta que "Características" y "Preguntas frecuentes". */
  .kicker {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(222 30% 48%);
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.25rem, 3.6vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    max-width: 16ch;
    text-wrap: balance;
  }
  .accent {
    color: var(--accent);
  }
  .copy p:not(.kicker) {
    margin: 8px 0 0;
    font-size: clamp(16px, 1.2vw, 17px);
    line-height: 1.6;
    color: hsl(210 10% 34%);
    max-width: 44ch;
    text-wrap: pretty;
  }
  /* Panel a la altura del copy con el fondo de la tarjeta de StudIApp en el catálogo: Grainient azul animado;
     este degradado queda de respaldo sin WebGL2. El video flota encima como la ventana del catálogo. */
  /* Más ancho y menos margen que la tarjeta del catálogo: el video trae texto de interfaz y necesita tamaño. */
  .art {
    position: relative;
    flex: 1.6 1 min(460px, 100%);
    min-width: 0;
    align-self: stretch;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: clamp(16px, 2.4vw, 32px);
    border-radius: 24px;
    background:
      radial-gradient(ellipse 70% 60% at 70% 75%, hsl(212 95% 80% / 0.55), transparent 70%),
      linear-gradient(55deg, #eef5ff 0%, #9ec0ff 55%, #7b93f5 100%);
  }
  .art-bg {
    position: absolute;
    inset: 0;
  }
  .media-box {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px hsl(232 30% 40% / 0.08),
      0 30px 60px -30px hsl(232 50% 30% / 0.45);
    display: flex;
    align-items: stretch;
    justify-content: stretch;
    background: hsl(220 24% 96%);
  }
</style>
