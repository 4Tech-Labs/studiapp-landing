---
import { Image } from 'astro:assets';
import companyLogo from '../assets/4techlabs-logo.png';
import { SITE, COMPANY, PRODUCT } from '../data/site';
import { foundingDate } from '../lib/legal';

// Identifica a la empresa dueña del sitio y de los productos del catálogo.
// Los datos salen de COMPANY, los mismos que usan las páginas legales.
const tel = `tel:${COMPANY.phone.replace(/\s/g, '')}`;
---

<section id="quienes-somos" aria-labelledby="nosotros-titulo" class="nosotros" data-screen-label="Quiénes somos">
  <div class="wrap">
    <div class="copy">
      <p class="kicker">Quiénes somos</p>
      <h2 id="nosotros-titulo">Somos <span class="accent">{COMPANY.name}</span></h2>
      <p>
        <strong>{COMPANY.legalName}</strong> es una empresa colombiana de desarrollo de software. Diseñamos y construimos aplicaciones web, móviles y soluciones con inteligencia artificial.
      </p>
      <p>
        Acompañamos a cada cliente desde la idea hasta el producto en producción. También creamos productos propios, como <a href={PRODUCT.path}>{PRODUCT.name}</a>, nuestra plataforma de planeación escolar con IA.
      </p>
    </div>

    <div class="card">
      <div class="logo">
        <Image src={companyLogo} alt={COMPANY.name} height={80} densities={[1, 2]} />
      </div>
      <dl class="facts">
        <div class="row">
          <dt>Razón social</dt>
          <dd>{COMPANY.legalName}</dd>
        </div>
        {
          COMPANY.taxId && (
            <div class="row">
              <dt>NIT</dt>
              <dd>{COMPANY.taxId}</dd>
            </div>
          )
        }
        {
          foundingDate && (
            <div class="row">
              <dt>Constitución</dt>
              <dd><time datetime={foundingDate.iso}>{foundingDate.text}</time></dd>
            </div>
          )
        }
        <div class="row">
          <dt>Sede</dt>
          <dd>{COMPANY.domicile}</dd>
        </div>
        <div class="row">
          <dt>Dirección</dt>
          <dd>{COMPANY.address}</dd>
        </div>
        <div class="row">
          <dt>Correo</dt>
          <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
        </div>
        <div class="row">
          <dt>Teléfono</dt>
          <dd><a href={tel}>{COMPANY.phone}</a></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .nosotros {
    margin-top: var(--gap);
    border-radius: var(--radius);
    background: linear-gradient(180deg, hsl(220 44% 96.5%) 0%, hsl(220 40% 98%) 100%);
    padding: clamp(56px, 7vw, 96px) clamp(20px, 4vw, 48px);
    scroll-margin-top: 14px;
  }
  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
  }
  .copy {
    flex: 1 1 min(400px, 100%);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  /* Misma etiqueta que "Características" y "Preguntas frecuentes". */
  .kicker {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(222 30% 48%);
  }
  /* Como en Plantillas, la otra sección a dos columnas. */
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.25rem, 3.6vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    max-width: 16ch;
    text-wrap: balance;
  }
  .accent {
    color: var(--accent);
  }
  .copy p:not(.kicker) {
    margin: 8px 0 0;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.6;
    color: hsl(210 10% 34%);
    max-width: 52ch;
    text-wrap: pretty;
  }
  .copy strong {
    font-weight: 600;
    color: var(--ink);
  }
  .copy p a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* Tarjeta blanca de las preguntas frecuentes abiertas. */
  .card {
    flex: 1 1 min(380px, 100%);
    min-width: 0;
    padding: 6px clamp(20px, 3vw, 32px);
    background: hsl(0 0% 100%);
    border-radius: 20px;
    box-shadow:
      inset 0 0 0 1px hsl(220 28% 91%),
      0 14px 30px -22px rgba(0, 64, 163, 0.45);
  }
  .logo {
    padding: 22px 0 18px;
    border-bottom: 1px solid hsl(220 28% 93%);
  }
  .logo :global(img) {
    display: block;
    width: auto;
    height: 80px;
  }
  .facts {
    margin: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 4px 20px;
    align-items: baseline;
    padding: 18px 0;
  }
  .row + .row {
    border-top: 1px solid hsl(220 28% 93%);
  }
  dt {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: hsl(222 30% 48%);
  }
  dd {
    margin: 0;
    font-size: clamp(15px, 1.2vw, 16px);
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  dd a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s ease;
  }
  dd a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  @media (max-width: 479px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
