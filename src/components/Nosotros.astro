---
import { Image } from 'astro:assets';
import companyLogo from '../assets/4techlabs-logo.png';
import { SITE, COMPANY, TEAM } from '../data/site';
import { foundingDate } from '../lib/legal';

// Identifica a la empresa detrás del producto: el dominio es el de la empresa y la marca es la del producto.
// Los datos salen de COMPANY, los mismos que usan las páginas legales.
const tel = `tel:${COMPANY.phone.replace(/\s/g, '')}`;
// Nombre y primer apellido: con dos apellidos (3 o más palabras) el primero es la penúltima palabra.
const initials = (name: string) => {
  const w = name.split(' ');
  return w[0][0] + (w.length >= 3 ? w[w.length - 2][0] : w.length === 2 ? w[1][0] : '');
};
---

<section id="quienes-somos" aria-labelledby="nosotros-titulo" class="nosotros" data-screen-label="Quiénes somos">
  <div class="wrap">
    <div class="copy">
      <p class="kicker">Quiénes somos</p>
      <h2 id="nosotros-titulo">Detrás de {SITE.name} está <span class="accent">{COMPANY.name}</span></h2>
      <p>
        {SITE.name} es un producto de <strong>{COMPANY.legalName}</strong>, una empresa colombiana de tecnología con sede en Cali que desarrolla herramientas de inteligencia artificial para la educación.
      </p>
      <p>
        Creamos {SITE.name} para que los docentes dediquen menos tiempo a los formatos y más a sus estudiantes. Por eso la plataforma se adapta al currículo, a las plantillas y al contexto de cada colegio, sin pedirle que cambie sus procesos.
      </p>
      {
        TEAM.length > 0 && (
          <div class="team">
            <h3 class="kicker">Equipo</h3>
            <ul>
              {TEAM.map((m) => (
                <li class="member">
                  <span class="initials" aria-hidden="true">{initials(m.name)}</span>
                  <span class="who">
                    <span class="name">{m.name}</span>
                    <span class="role">{m.role}</span>
                  </span>
                  {m.linkedin && (
                    <a href={m.linkedin} target="_blank" rel="noopener" class="in" aria-label={`${m.name} en LinkedIn`}>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
                        <rect x="2" y="9" width="4" height="12" />
                        <circle cx="4" cy="4" r="2" />
                      </svg>
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <div class="card">
      <div class="logo">
        <Image src={companyLogo} alt={COMPANY.name} height={80} densities={[1, 2]} />
      </div>
      <dl class="facts">
        <div class="row">
          <dt>Razón social</dt>
          <dd>{COMPANY.legalName}</dd>
        </div>
        {
          COMPANY.taxId && (
            <div class="row">
              <dt>NIT</dt>
              <dd>{COMPANY.taxId}</dd>
            </div>
          )
        }
        {
          foundingDate && (
            <div class="row">
              <dt>Constitución</dt>
              <dd><time datetime={foundingDate.iso}>{foundingDate.text}</time></dd>
            </div>
          )
        }
        <div class="row">
          <dt>Sede</dt>
          <dd>{COMPANY.domicile}</dd>
        </div>
        <div class="row">
          <dt>Dirección</dt>
          <dd>{COMPANY.address}</dd>
        </div>
        <div class="row">
          <dt>Correo</dt>
          <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
        </div>
        <div class="row">
          <dt>Teléfono</dt>
          <dd><a href={tel}>{COMPANY.phone}</a></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .nosotros {
    margin-top: var(--gap);
    border-radius: var(--radius);
    background: linear-gradient(180deg, hsl(220 44% 96.5%) 0%, hsl(220 40% 98%) 100%);
    padding: clamp(56px, 7vw, 96px) clamp(20px, 4vw, 48px);
    scroll-margin-top: 14px;
  }
  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
  }
  .copy {
    flex: 1 1 min(400px, 100%);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  /* Misma etiqueta que "Características" y "Preguntas frecuentes". */
  .kicker {
    margin: 0;
    font-family: var(--font-outfit);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(222 30% 48%);
  }
  /* Como en Plantillas, la otra sección a dos columnas. */
  h2 {
    margin: 0;
    font-family: var(--font-inter-tight);
    font-weight: 600;
    font-size: clamp(2.25rem, 3.6vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    max-width: 16ch;
    text-wrap: balance;
  }
  .accent {
    color: var(--accent);
  }
  .copy p:not(.kicker) {
    margin: 8px 0 0;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.6;
    color: hsl(210 10% 34%);
    max-width: 52ch;
    text-wrap: pretty;
  }
  .team {
    margin-top: 16px;
  }
  .team .kicker {
    margin-bottom: 12px;
  }
  .team ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: 10px;
    max-width: 52ch;
  }
  .member {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: hsl(0 0% 100%);
    border-radius: 16px;
    box-shadow: inset 0 0 0 1px hsl(220 28% 91%);
  }
  .initials {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-grad);
    box-shadow: var(--accent-shadow);
    color: hsl(0 0% 100%);
    font-family: var(--font-outfit);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .who {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .name {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }
  .role {
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .in {
    flex: none;
    width: 44px;
    height: 44px;
    margin: -4px -6px -4px 0;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    transition: background-color 0.2s ease;
  }
  .in:hover {
    color: var(--accent);
    background: hsl(222 100% 96%);
  }
  .copy strong {
    font-weight: 600;
    color: var(--ink);
  }
  /* Tarjeta blanca de las preguntas frecuentes abiertas. */
  .card {
    flex: 1 1 min(380px, 100%);
    min-width: 0;
    padding: 6px clamp(20px, 3vw, 32px);
    background: hsl(0 0% 100%);
    border-radius: 20px;
    box-shadow:
      inset 0 0 0 1px hsl(220 28% 91%),
      0 14px 30px -22px rgba(0, 64, 163, 0.45);
  }
  .logo {
    padding: 22px 0 18px;
    border-bottom: 1px solid hsl(220 28% 93%);
  }
  .logo :global(img) {
    display: block;
    width: auto;
    height: 80px;
  }
  .facts {
    margin: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 4px 20px;
    align-items: baseline;
    padding: 18px 0;
  }
  .row + .row {
    border-top: 1px solid hsl(220 28% 93%);
  }
  dt {
    font-family: var(--font-outfit);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: hsl(222 30% 48%);
  }
  dd {
    margin: 0;
    font-size: clamp(15px, 1.2vw, 16px);
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  dd a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s ease;
  }
  dd a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  @media (max-width: 479px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
