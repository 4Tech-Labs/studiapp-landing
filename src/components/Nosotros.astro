---
import { Image } from 'astro:assets';
import companyLogo from '../assets/4techlabs-logo.png';
import { SITE, COMPANY, PRODUCT, CATALOG } from '../data/site';
import GradientWaves from './GradientWaves.astro';
import ReflectiveCard from './ReflectiveCard.astro';
import WaveTitle from './WaveTitle.astro';

// Identifica a la empresa dueña del sitio y de los productos del catálogo.
// Los datos salen de COMPANY, los mismos que usan las páginas legales. La credencial lleva solo lo esencial
// (razón social, ciudad y NIT); la dirección y la fecha de constitución están en las páginas legales y en el JSON-LD.
// En la landing de StudIApp (variant product) va antes de Contacto con el mismo diseño: dice quién está detrás del
// producto y lleva al sitio de la empresa.
interface Props {
  variant?: 'company' | 'product';
}

const { variant = 'company' } = Astro.props;
const isProduct = variant === 'product';
// El otro producto propio, enlazado a su tarjeta en la sección Productos del home.
const complexipy = CATALOG.find((p) => p.id === 'complexipy-platform');
// "Cali, Valle del Cauca, Colombia" → "Cali, Colombia".
const place = COMPANY.domicile.split(',').map((part) => part.trim());
const city = place.length > 1 ? `${place[0]}, ${place[place.length - 1]}` : COMPANY.domicile;
---

<section
  id={isProduct ? 'empresa' : 'quienes-somos'}
  aria-labelledby="nosotros-titulo"
  class="nosotros"
  data-screen-label={isProduct ? COMPANY.name : 'Quiénes somos'}
>
  {/* Olas azules en tinta suave (lightMode) en la mitad inferior; sin WebGL2 queda el degradado de la sección. */}
  <div aria-hidden="true" class="waves">
    <GradientWaves
      lightMode
      horizonColor="#cfe0ff"
      waveColor="#3d7fd9"
      crestColor="#ffffff"
      speed={0.4}
      amplitude={2.5}
      relief={1}
      lightAngle={120}
      grain={0}
      brightness={1.3}
      dpr={1}
    />
  </div>
  <div class="wrap">
    <div class="copy">
      <p class="kicker">{isProduct ? 'Quién está detrás' : 'Quiénes somos'}</p>
      <h2 id="nosotros-titulo">
        <WaveTitle
          parts={isProduct
            ? [{ text: 'Un producto de' }, { text: COMPANY.name, accent: true, break: true }]
            : [{ text: 'Tus ideas,' }, { text: 'hechas realidad', accent: true }]}
        />
      </h2>
      <p>
        <strong>{COMPANY.legalName}</strong> es una empresa colombiana de desarrollo de software que construye aplicaciones web y móviles a la medida, automatiza procesos operativos y desarrolla productos propios como{' '}
        {/* En la landing de StudIApp el nombre va sin enlace: ya estás ahí */}
        {isProduct ? PRODUCT.name : <a href={PRODUCT.path}>{PRODUCT.name}</a>}, para la planeación curricular, y{' '}
        {complexipy ? <a href={`/#${complexipy.id}`}>{complexipy.name}</a> : 'Complexipy Platform'}, basada en el proyecto open source de nuestro cofundador con más de 7 millones de descargas.
      </p>
      {
        isProduct && (
          <a href="/" class="go">
            Conoce {COMPANY.name}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        )
      }
    </div>

    {/* Ficha de la empresa como credencial de vidrio (ReflectiveCard en modo glass): logo y NIT arriba, razón social
        en el centro y el contacto como pie, todo dentro de la tarjeta. Un clic en el correo o el teléfono lo copia.
        En reposo queda un poco inclinada hacia la luz de arriba a la derecha y con el brillo encendido: así se ve el
        efecto también en celular, donde no hay hover. */}
    <div class="side">
      <div class="credential">
        <ReflectiveCard
          theme="light"
          glass
          roughness={0.35}
          glare={0.6}
          tiltStrength={10}
          radius={26}
          restX={0.45}
          restY={-0.35}
          restLight={0.6}
        >
          <div class="id">
            <div class="id-top">
              <span class="logo">
                <Image src={companyLogo} alt={COMPANY.name} height={44} densities={[1, 2]} />
              </span>
              {
                COMPANY.taxId && (
                  <span class="nit">
                    <span class="nit-label">NIT</span>
                    <span class="nit-value">{COMPANY.taxId}</span>
                  </span>
                )
              }
            </div>
            <div class="id-name">
              <p class="legal">{COMPANY.legalName}</p>
              <p class="trade">Desarrollo de software · {city}</p>
            </div>
            <div class="id-foot">
              <button type="button" class="action" data-copy={SITE.email} aria-label={`Copiar correo ${SITE.email}`}>
                <span class="icon">
                  <svg class="icon-base" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                  </svg>
                  <svg class="icon-done" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m5 12.5 4.5 4.5L19 7.5" />
                  </svg>
                </span>
                {SITE.email}
                <span class="tip" aria-hidden="true">Copiado</span>
              </button>
              <button type="button" class="action" data-copy={COMPANY.phone} aria-label={`Copiar teléfono ${COMPANY.phone}`}>
                <span class="icon">
                  <svg class="icon-base" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                  <svg class="icon-done" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m5 12.5 4.5 4.5L19 7.5" />
                  </svg>
                </span>
                {COMPANY.phone}
                <span class="tip" aria-hidden="true">Copiado</span>
              </button>
            </div>
            <span class="sr-only" aria-live="polite" data-copy-status></span>
          </div>
        </ReflectiveCard>
      </div>
    </div>
  </div>
</section>

<style>
  /* overflow: clip y no hidden: hidden vuelve la sección un contenedor de scroll y la ola del título (WaveTitle)
     seguiría el scroll de la sección, que nunca se mueve, en vez del de la página */
  .nosotros {
    position: relative;
    overflow: clip;
    isolation: isolate;
    margin-top: var(--gap);
    border-radius: var(--radius);
    background: linear-gradient(180deg, hsl(220 44% 96.5%) 0%, hsl(220 40% 98%) 100%);
    padding: clamp(56px, 7vw, 96px) clamp(20px, 4vw, 48px);
    scroll-margin-top: 14px;
  }
  /* Safari < 16 no conoce overflow: clip (tampoco las animaciones ligadas al scroll: ahí la ola va por JavaScript) */
  @supports not (overflow: clip) {
    .nosotros {
      overflow: hidden;
    }
  }
  .waves {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
  }
  .copy {
    flex: 1 1 min(400px, 100%);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  /* Misma etiqueta que "Características" y "Preguntas frecuentes". */
  .kicker {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(222 30% 48%);
  }
  /* Título de sección: la misma escala en todo el home (32 a 54 px, 600, −0,025em) */
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    max-width: 16ch;
    text-wrap: balance;
  }
  .copy p:not(.kicker) {
    margin: 8px 0 0;
    font-size: clamp(16px, 1.2vw, 17px);
    line-height: 1.6;
    color: hsl(210 10% 34%);
    max-width: 52ch;
    text-wrap: pretty;
  }
  .copy strong {
    font-weight: 600;
    color: var(--ink);
  }
  .copy p a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* Enlace al sitio de la empresa (solo en la landing de StudIApp). De texto y no botón: la acción principal de esa
     página es el botón de Contacto, que viene justo después. */
  .go {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-size: 16px;
    font-weight: 600;
    color: var(--brand);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s ease;
  }
  .go:hover {
    color: var(--brand);
    text-decoration-color: currentColor;
  }
  .go svg {
    transition: transform 0.2s ease;
  }
  .go:hover svg {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .go:hover svg {
      transform: none;
    }
  }  /* Columna derecha: la credencial centrada. */
  .side {
    flex: 1 1 min(380px, 100%);
    min-width: 0;
    display: flex;
    justify-content: center;
  }
  .credential {
    width: min(100%, 400px);
  }
  /* Contenido de la credencial (va dentro del metal de ReflectiveCard, con su tinta y su tono apagado). */
  .id {
    min-height: 340px;
    display: flex;
    flex-direction: column;
    padding: 22px;
    font-family: var(--font-sans);
  }
  .id-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }
  .logo :global(img) {
    display: block;
    width: auto;
    height: 44px;
  }
  /* NIT como el número de una credencial: etiqueta pequeña y cifra en monoespaciada, alineados a la derecha. */
  .nit {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }
  .nit-label {
    font-size: 11px;
    line-height: 16px;
    color: var(--rc-muted);
  }
  .nit-value {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    line-height: 18px;
    color: var(--rc-ink);
  }
  .id-name {
    margin-top: auto;
  }
  .legal {
    margin: 0;
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--rc-ink);
  }
  .trade {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.4;
    color: var(--rc-muted);
  }
  /* Pie: correo y teléfono separados por una línea fina. Son botones: un clic copia el dato al portapapeles. */
  .id-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 16px;
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid rgb(24 24 27 / 0.08);
  }
  .action {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 13.5px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--rc-ink);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }
  /* En la tinta de la credencial; el azul aparece al pasar el mouse, junto con el subrayado. */
  .action:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .action:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 4px;
  }
  /* Ícono de línea fina; al copiar se cruza con un check. */
  .icon {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
  }
  .icon svg {
    position: absolute;
    inset: 0;
    transition:
      opacity 0.2s ease,
      transform 0.25s ease;
  }
  .icon-done {
    opacity: 0;
    transform: scale(0.6);
    color: #16a34a;
  }
  .action[data-copied] .icon-base {
    opacity: 0;
    transform: scale(0.6);
  }
  .action[data-copied] .icon-done {
    opacity: 1;
    transform: none;
  }
  /* Aviso "Copiado" que sube sobre el botón, sin mover nada alrededor. */
  .tip {
    position: absolute;
    bottom: 100%;
    left: 50%;
    padding: 4px 10px;
    border-radius: 9999px;
    background: var(--ink);
    color: hsl(0 0% 100%);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 0);
    transition:
      opacity 0.2s ease,
      transform 0.25s ease;
  }
  .action[data-copied] .tip {
    opacity: 1;
    transform: translate(-50%, -8px);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  // Correo y teléfono de la credencial: un clic copia el dato, el ícono pasa a check y sube el aviso "Copiado".
  // Si el portapapeles moderno no está disponible (http sin TLS, permisos), copia con un textarea temporal.
  const copy = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.append(area);
      area.select();
      const ok = document.execCommand('copy');
      area.remove();
      return ok;
    }
  };

  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    let timer = 0;
    button.addEventListener('click', async () => {
      const text = button.dataset.copy || '';
      if (!(await copy(text))) return;
      button.toggleAttribute('data-copied', true);
      if (status) status.textContent = `Copiado: ${text}`;
      clearTimeout(timer);
      timer = window.setTimeout(() => button.removeAttribute('data-copied'), 1600);
    });
  }
</script>
