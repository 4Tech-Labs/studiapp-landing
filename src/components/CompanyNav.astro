---
import { Image } from 'astro:assets';
import logo from '../assets/4techlabs-logo-4tl.png';
import { COMPANY } from '../data/site';

// Nav del sitio de la empresa: logo a la izquierda y enlaces al centro.
// Al hacer scroll la barra se vuelve un notch de vidrio pegado arriba: el logo pasa a la píldora y Contacto se vuelve botón.
const links = [
  { href: '/#productos', label: 'Productos' },
  { href: '/#equipo', label: 'Equipo' },
  { href: '/#quienes-somos', label: 'Nosotros' },
  { href: '/#respaldo', label: 'Respaldo' },
  { href: '/#contacto', label: 'Contacto', cta: true },
];
---

<!-- Centinela de 60 px en el tope del documento: cuando sale del viewport la nav se condensa (equivale a scrollY > 60). -->
<div class="cn-sentinel" aria-hidden="true" data-cn-sentinel></div>
<header class="cn" data-cn>
  <a href="/" aria-label={`${COMPANY.name}, inicio`} class="brand">
    <Image src={logo} alt="" height={34} densities={[1, 2]} loading="eager" />
  </a>
  <nav aria-label="Principal" class="links">
    <a href="/" aria-label={`${COMPANY.name}, inicio`} class="pill-logo">
      <Image src={logo} alt="" height={22} densities={[1, 2]} loading="eager" />
    </a>
    {links.map((l) => <a href={l.href} class:list={{ 'nav-cta': l.cta }}>{l.label}</a>)}
  </nav>
</header>

<style>
  /* Coreografía al condensarse (al bajar), en tres tiempos:
     1. el logo grande se encoge y se desvanece hacia la píldora mientras la barra sube al borde (notch);
     2. el logo pequeño entra en la píldora con un leve rebote;
     3. Contacto se llena de azul y se enciende su destello.
     Al volver arriba ocurre lo inverso, más rápido y sin rebote.
     Rendimiento: el desplazamiento de la barra es transform (no top), el fondo de Contacto anima background-color
     y sombras (no se intercambian degradados), y los brillos son pseudo-elementos que solo cambian de opacidad.
     El cambio lo dispara un IntersectionObserver (sin escuchar el scroll). */
  .cn-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 60px;
    pointer-events: none;
    visibility: hidden;
  }
  .cn {
    --ease: cubic-bezier(0.4, 0, 0.2, 1);
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-in: cubic-bezier(0.4, 0, 1, 1);
    --spring: cubic-bezier(0.34, 1.45, 0.64, 1);
    --top: calc(var(--gap) + 10px);
    position: fixed;
    top: var(--top);
    left: calc(var(--gap) + clamp(14px, 2.4vw, 36px));
    right: calc(var(--gap) + clamp(14px, 2.4vw, 36px));
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 52px;
    /* backwards y no both: una animación de opacidad/transform retenida al terminar convierte la nav en
       "backdrop root" y Chrome deja de difuminar lo que hay detrás de la píldora. */
    animation: cnIn 0.7s 0.1s var(--ease) backwards;
    transition: transform 0.4s var(--ease-out);
  }

  /* Logo grande */
  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    transform-origin: right center;
    transition:
      opacity 0.35s var(--ease) 0.1s,
      transform 0.45s var(--ease-out) 0.1s,
      filter 0.35s var(--ease) 0.1s,
      visibility 0s linear 0s;
  }
  .brand :global(img) {
    display: block;
    width: auto;
    height: 34px;
  }

  /* Píldora de enlaces */
  .links {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 5px;
    /* Radio finito (no 9999px) para que la transformación en notch interpole suave. */
    border-radius: 26px;
    border: 1px solid transparent;
    transition:
      background 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      border-radius 0.35s var(--ease-out),
      padding 0.35s var(--ease-out);
  }
  .links a {
    padding: 8px 13px;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 500;
    color: hsl(232 18% 22%);
    white-space: nowrap;
    transition: background 0.2s ease;
  }
  .links a:hover {
    color: hsl(232 30% 10%);
    background: hsl(232 40% 50% / 0.07);
  }
  .cn[data-scrolled] .links a:not(.pill-logo, .nav-cta):hover {
    background: linear-gradient(180deg, hsl(0 0% 100% / 0.75), hsl(0 0% 100% / 0.35));
    box-shadow:
      inset 0 1px 0 hsl(0 0% 100% / 0.9),
      0 2px 8px -3px hsl(232 50% 30% / 0.18);
  }

  /* Logo pequeño dentro de la píldora: colapsado (ancho 0 y fuera del orden de tabulación) hasta que la nav se condensa.
     El contenedor abre el espacio; la imagen entra aparte (escala, opacidad y desenfoque), que es lo que se ve. */
  .links .pill-logo {
    display: inline-flex;
    align-items: center;
    max-width: 0;
    margin: 0;
    padding: 0;
    border-radius: 0;
    border-right: 0 solid hsl(232 20% 40% / 0);
    overflow: hidden;
    visibility: hidden;
    transition:
      max-width 0.35s var(--ease-out) 0.05s,
      margin 0.35s var(--ease-out) 0.05s,
      padding 0.35s var(--ease-out) 0.05s,
      border-color 0.2s var(--ease),
      visibility 0s linear 0.4s;
  }
  .links .pill-logo:hover {
    background: none;
  }
  .pill-logo :global(img) {
    display: block;
    flex-shrink: 0;
    width: auto;
    height: 22px;
    opacity: 0;
    transform: scale(0.6);
    filter: blur(4px);
    transition:
      opacity 0.2s var(--ease-in),
      transform 0.25s var(--ease-in),
      filter 0.2s var(--ease-in);
  }

  /* Contacto: enlace normal arriba; en el notch se llena con el azul de la marca (la acción principal).
     Mismo número de sombras en ambos estados para que interpolen. */
  .links .nav-cta {
    position: relative;
    isolation: isolate;
    margin-left: 4px;
    background-color: rgb(1 68 160 / 0);
    box-shadow:
      inset 0 10px 12px -10px hsl(0 0% 100% / 0),
      inset 0 1px 1px hsl(0 0% 100% / 0),
      0 0 0 1px rgb(1 58 140 / 0),
      0 6px 14px -6px rgb(1 68 160 / 0);
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease),
      box-shadow 0.25s var(--ease),
      transform 0.25s var(--ease),
      filter 0.2s ease;
  }
  .cn[data-scrolled] .links .nav-cta,
  .cn[data-scrolled] .links .nav-cta:hover {
    color: hsl(0 0% 100%);
    background-color: var(--brand);
    box-shadow:
      inset 0 10px 12px -10px hsl(0 0% 100% / 0.45),
      inset 0 1px 1px hsl(0 0% 100% / 0.3),
      0 0 0 1px rgb(1 58 140 / 1),
      0 6px 14px -6px rgb(1 68 160 / 0.6);
  }
  .cn[data-scrolled] .links .nav-cta:hover {
    filter: brightness(1.12);
  }

  /* Destello que recorre el borde del botón: un arco de luz (::before) y su halo difuso (::after).
     Solo se ve en el notch; el ángulo se anima como propiedad registrada, sin repintar el resto de la barra. */
  .nav-cta::before,
  .nav-cta::after {
    content: '';
    position: absolute;
    border-radius: inherit;
    pointer-events: none;
    background: conic-gradient(
      from var(--nav-cta-angle),
      transparent 0deg,
      hsl(205 100% 80% / 0.15) 20deg,
      hsl(210 100% 82% / 0.55) 120deg,
      hsl(210 100% 88% / 0.85) 190deg,
      hsl(0 0% 100%) 225deg,
      transparent 240deg,
      transparent 360deg
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.15s var(--ease);
    animation: navCtaSpin 3s linear infinite;
  }
  .nav-cta::before {
    inset: -2.5px;
    padding: 2.5px;
  }
  .nav-cta::after {
    inset: -6px;
    padding: 6px;
    z-index: -1;
    filter: blur(5px);
  }
  @property --nav-cta-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  @keyframes navCtaSpin {
    to {
      --nav-cta-angle: 360deg;
    }
  }

  /* Vidrio líquido solo con CSS (sin filtros SVG de refracción, que son costosos): un único backdrop-filter,
     fondo translúcido en degradado, filo especular (borde con máscara) y un brillo suave arriba. */
  .links::before,
  .links::after {
    content: '';
    position: absolute;
    pointer-events: none;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.25s var(--ease);
    z-index: -1;
  }
  /* Filo de luz en los lados y abajo, más intenso en las esquinas, como el reflejo en un borde curvo. */
  .links::before {
    inset: 0;
    padding: 0 1px 1px;
    background: linear-gradient(
      135deg,
      hsl(0 0% 100% / 0.95) 0%,
      hsl(0 0% 100% / 0.25) 35%,
      hsl(215 70% 80% / 0.2) 65%,
      hsl(0 0% 100% / 0.8) 100%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }
  /* Brillo especular que baja desde el borde de la ventana. */
  .links::after {
    inset: 0 10% 50% 10%;
    background: radial-gradient(ellipse 60% 100% at 50% 0%, hsl(0 0% 100% / 0.7), transparent 75%);
  }

  /* ---------- Estado condensado (notch) ---------- */
  @media (min-width: 900px) {
    .cn[data-scrolled] {
      /* Sube hasta el borde de la ventana con transform (se compone en la GPU; top obligaría a recalcular el layout). */
      transform: translateY(calc(-1 * var(--top)));
      transition: transform 0.55s var(--ease-out);
    }
  }
  /* 1. El logo grande se encoge hacia la píldora y se desvanece. */
  .cn[data-scrolled] .brand {
    opacity: 0;
    transform: translateX(14px) scale(0.6);
    filter: blur(4px);
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.25s var(--ease-in),
      transform 0.35s var(--ease-in),
      filter 0.25s var(--ease-in),
      visibility 0s linear 0.35s;
  }
  .cn[data-scrolled] .links {
    align-self: start;
    padding: 9px 8px 7px;
    border-radius: 0 0 22px 22px;
    /* 75 % a 65 %: con el desenfoque, lo de atrás se ve difuminado y los enlaces se leen bien. */
    background: linear-gradient(180deg, hsl(0 0% 100% / 0.75) 0%, hsl(220 60% 98% / 0.65) 100%);
    -webkit-backdrop-filter: blur(18px) saturate(1.8) brightness(1.04);
    backdrop-filter: blur(18px) saturate(1.8) brightness(1.04);
    box-shadow:
      inset 0 -1px 1px hsl(0 0% 100% / 0.6),
      inset 0 -8px 16px -10px hsl(215 80% 60% / 0.18),
      0 1px 2px hsl(232 40% 20% / 0.06),
      0 14px 34px -14px hsl(232 50% 30% / 0.32);
    transition:
      background 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      border-radius 0.55s var(--ease-out),
      padding 0.55s var(--ease-out);
  }
  /* Sin soporte de backdrop-filter no hay difuminado: la barra va casi sólida para que el texto se lea. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .cn[data-scrolled] .links {
      background: hsl(0 0% 100% / 0.94);
    }
  }
  .cn[data-scrolled] .links::before,
  .cn[data-scrolled] .links::after {
    opacity: 1;
    transition: opacity 0.4s var(--ease) 0.15s;
  }
  /* 2. El logo pequeño abre su espacio y entra con un leve rebote. */
  .cn[data-scrolled] .pill-logo {
    max-width: 80px;
    /* Divisor centrado: 16 px antes (este padding) y ~15 px después (gap + padding del enlace). */
    margin: 0 0 0 8px;
    padding-right: 16px;
    border-right-width: 1px;
    border-right-color: hsl(232 20% 40% / 0.15);
    visibility: visible;
    transition:
      max-width 0.5s var(--ease-out) 0.1s,
      margin 0.5s var(--ease-out) 0.1s,
      padding 0.5s var(--ease-out) 0.1s,
      border-color 0.3s var(--ease) 0.35s,
      visibility 0s linear 0s;
  }
  .cn[data-scrolled] .pill-logo :global(img) {
    opacity: 1;
    /* Ajuste óptico: la estela debajo de las letras sube el peso visual del logo; 2 px abajo lo alinea con el texto. */
    transform: translateY(2px);
    filter: none;
    transition:
      opacity 0.35s var(--ease) 0.2s,
      transform 0.55s var(--spring) 0.2s,
      filter 0.35s var(--ease) 0.2s;
  }
  /* 3. Contacto se llena de azul con un pequeño pulso y después se enciende el destello. */
  .cn[data-scrolled] .links .nav-cta {
    animation: ctaPop 0.5s var(--spring) 0.3s backwards;
    transition:
      background-color 0.4s var(--ease) 0.3s,
      color 0.3s var(--ease) 0.3s,
      box-shadow 0.4s var(--ease) 0.3s,
      filter 0.2s ease;
  }
  .cn[data-scrolled] .nav-cta::before {
    opacity: 1;
    transition: opacity 0.5s var(--ease) 0.6s;
  }
  .cn[data-scrolled] .nav-cta::after {
    opacity: 0.85;
    transition: opacity 0.5s var(--ease) 0.6s;
  }

  @keyframes ctaPop {
    from {
      transform: scale(0.92);
    }
    to {
      transform: none;
    }
  }
  @keyframes cnIn {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Tablet y celular: solo el logo; al condensarse, la barra entera pasa a ser la píldora. */
  @media (max-width: 899px) {
    .cn {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      top: calc(var(--gap) + 8px);
      left: calc(var(--gap) + 10px);
      right: calc(var(--gap) + 10px);
      height: 44px;
      padding: 0 16px;
      border-radius: 9999px;
      border: 1px solid transparent;
      transition:
        background 0.35s var(--ease),
        border-color 0.35s var(--ease),
        box-shadow 0.35s var(--ease);
    }
    .links {
      display: none;
    }
    .cn[data-scrolled] {
      background: hsl(0 0% 100% / 0.78);
      -webkit-backdrop-filter: blur(16px) saturate(1.5);
      backdrop-filter: blur(16px) saturate(1.5);
      border-color: hsl(0 0% 100% / 0.9);
      box-shadow: 0 12px 32px -14px hsl(232 50% 30% / 0.3);
    }
    .cn[data-scrolled] .brand {
      opacity: 1;
      transform: none;
      filter: none;
      visibility: visible;
      pointer-events: auto;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-cn]');
  const sentinel = document.querySelector<HTMLElement>('[data-cn-sentinel]');
  if (nav && sentinel) {
    new IntersectionObserver(([entry]) => nav.toggleAttribute('data-scrolled', !entry.isIntersecting)).observe(sentinel);
  }
</script>
