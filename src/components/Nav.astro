---
import { Image } from 'astro:assets';
import logo from '../assets/4techlabs-logo-4tl.png';
import { COMPANY, PRODUCT } from '../data/site';
import LottieLogo from './LottieLogo.astro';

// Nav del sitio: logo a la izquierda y enlaces al centro.
// Al hacer scroll la barra se vuelve un notch de vidrio pegado arriba: el logo pasa a la píldora y Contacto se vuelve botón.
// En celular la píldora solo muestra Contacto y un botón de menú (hamburguesa) que despliega el resto de enlaces.
// La empresa y la landing de StudIApp comparten el diseño; cambian el logo y los enlaces (variant). La de StudIApp va
// siempre en notch, también arriba del todo: no tiene logo grande y el robot animado va en la píldora.
interface Props {
  /** 'company': sitio de 4Tech Labs. 'product': landing de StudIApp. */
  variant?: 'company' | 'product';
}

const { variant = 'company' } = Astro.props;
const isProduct = variant === 'product';
const home = isProduct ? { href: `${PRODUCT.path}#inicio`, label: `${PRODUCT.name}, inicio` } : { href: '/', label: `${COMPANY.name}, inicio` };
const links = isProduct
  ? [
      { href: `${PRODUCT.path}#caracteristicas`, label: 'Características' },
      { href: '/', label: COMPANY.name },
      { href: `${PRODUCT.path}#agenda`, label: 'Contacto', cta: true },
    ]
  : [
      { href: '/#productos', label: 'Productos' },
      { href: '/#quienes-somos', label: 'Nosotros' },
      { href: '/#equipo', label: 'Equipo' },
      { href: '/#respaldo', label: 'Respaldo' },
      { href: '/#contacto', label: 'Contacto', cta: true },
    ];
// Ancho del hueco del logo pequeño en la píldora (margen 8 + logo de 22 px de alto + padding 16 + gap 2). Arriba la
// píldora se corre la mitad de este ancho para que los enlaces queden centrados sin el logo (ver .links).
const slot = 8 + Math.round((logo.width / logo.height) * 22) + 16 + 2;
---

<!-- Centinela de 60 px en el tope del documento: cuando sale del viewport la nav se condensa (equivale a scrollY > 60). -->
<div class="cn-sentinel" aria-hidden="true" data-cn-sentinel></div>
<header class="cn" data-cn data-cn-notch={isProduct ? '' : undefined} style={isProduct ? undefined : `--slot: ${slot}px`}>
  {
    !isProduct && (
      <a href={home.href} aria-label={home.label} class="brand">
        <Image src={logo} alt="" height={34} densities={[1, 2]} loading="eager" />
      </a>
    )
  }
  <nav aria-label="Principal" class="links">
    <span aria-hidden="true" class="glass"></span>
    <a href={home.href} aria-label={home.label} class:list={['pill-logo', { 'has-name': isProduct }]}>
      {
        // Robot más alto que el logo de la empresa (22 px): el dibujo trae mucho margen transparente. Va con el nombre
        // porque en la landing de StudIApp es el único logo de la nav.
        isProduct ? (
          <>
            <LottieLogo width={21} height={30} />
            <span class="pill-name">{PRODUCT.name}</span>
          </>
        ) : (
          <Image src={logo} alt="" height={22} densities={[1, 2]} loading="eager" />
        )
      }
    </a>
    {
      links.map((l) =>
        l.cta ? (
          <a href={l.href} class="nav-cta">
            <span aria-hidden="true" class="cta-ring" />
            <span aria-hidden="true" class="cta-ring cta-halo" />
            {l.label}
          </a>
        ) : (
          <a href={l.href}>{l.label}</a>
        ),
      )
    }
    <button type="button" class="menu-btn" aria-label="Abrir menú" aria-expanded="false" aria-controls="cn-menu" data-cn-menu-btn>
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <path class="line line-top-bottom" d="M27 10 13 10C10.8 10 9 8.2 9 6 9 3.5 10.8 2 13 2 15.2 2 17 3.8 17 6L17 26C17 28.2 18.8 30 21 30 23.2 30 25 28.2 25 26 25 23.8 23.2 22 21 22L7 22"></path>
        <path class="line" d="M7 16 27 16"></path>
      </svg>
    </button>
  </nav>
  <div id="cn-menu" class="menu" data-cn-menu>
    {
      links
        .filter((l) => !l.cta)
        .map((l) => (
          <a href={l.href} data-cn-menu-link>
            {l.label}
          </a>
        ))
    }
  </div>
</header>
<script is:inline>
  // Celular y landing de StudIApp: la nav es siempre el notch. Se marca aquí, antes de pintar, para que no se vea
  // primero la versión desplegada.
  (function () {
    var cn = document.querySelector('[data-cn]');
    if (cn.hasAttribute('data-cn-notch') || matchMedia('(max-width: 899px)').matches) cn.setAttribute('data-scrolled', '');
  })();
</script>

<style>
  /* Coreografía al condensarse (al bajar), en tres tiempos:
     1. el logo grande se encoge y se desvanece hacia la píldora mientras la barra sube al borde (notch);
     2. el logo pequeño entra en la píldora con un leve rebote;
     3. Contacto se llena de azul y se enciende su destello.
     Al volver arriba ocurre lo inverso, más rápido y sin rebote.
     Rendimiento: todo lo que se mueve durante el cambio es transform, translate u opacidad, que la GPU compone sin
     recalcular el layout ni repintar. La píldora no cambia de tamaño (el hueco del logo pequeño está siempre
     reservado y arriba se corre con translate); el vidrio, sus sombras y el relleno de Contacto son capas que solo
     cambian de opacidad; y los logos no usan blur(), porque un filtro que mueve píxeles saca sus animaciones de la
     GPU. El cambio lo dispara un IntersectionObserver (sin escuchar el scroll). */
  .cn-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 60px;
    pointer-events: none;
    visibility: hidden;
  }
  .cn {
    --ease: cubic-bezier(0.4, 0, 0.2, 1);
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-in: cubic-bezier(0.4, 0, 1, 1);
    --spring: cubic-bezier(0.34, 1.45, 0.64, 1);
    --top: calc(var(--gap) + 10px);
    position: fixed;
    top: var(--top);
    left: calc(var(--gap) + clamp(14px, 2.4vw, 36px));
    right: calc(var(--gap) + clamp(14px, 2.4vw, 36px));
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 52px;
    /* backwards y no both: una animación de opacidad/translate retenida al terminar convierte la nav en
       "backdrop root" y Chrome deja de difuminar lo que hay detrás de la píldora. */
    animation: cnIn 0.7s 0.1s var(--ease) backwards;
    transition: transform 0.4s var(--ease-out);
  }

  /* Logo grande */
  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    transform-origin: right center;
    transition:
      opacity 0.35s var(--ease) 0.1s,
      transform 0.45s var(--ease-out) 0.1s,
      visibility 0s linear 0s;
  }
  .brand :global(img) {
    display: block;
    width: auto;
    height: 34px;
  }

  /* Píldora de enlaces: siempre en la columna del centro, aunque no haya logo grande (StudIApp). Mide lo mismo en
     los dos estados: el hueco del logo pequeño existe siempre y, arriba, la píldora se corre la mitad de ese hueco
     (--slot) a la izquierda para centrar los enlaces. Al condensarse vuelve a su sitio con translate. */
  .links {
    grid-column: 2;
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 9px 8px 7px;
    border: 1px solid transparent;
    translate: calc(var(--slot, 0px) / -2) 0;
    transition: translate 0.35s var(--ease-out);
  }
  .links a {
    padding: 8px 13px;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 500;
    color: hsl(232 18% 22%);
    white-space: nowrap;
    transition: background 0.2s ease;
  }
  .links a:hover {
    color: hsl(232 30% 10%);
    background: hsl(232 40% 50% / 0.07);
  }
  .cn[data-scrolled] .links a:not(.pill-logo, .nav-cta):hover {
    background: linear-gradient(180deg, hsl(0 0% 100% / 0.75), hsl(0 0% 100% / 0.35));
    box-shadow:
      inset 0 1px 0 hsl(0 0% 100% / 0.9),
      0 2px 8px -3px hsl(232 50% 30% / 0.18);
  }

  /* Logo pequeño dentro de la píldora: su hueco está siempre (ver .links), pero arriba va oculto y fuera del orden de
     tabulación. La imagen entra aparte con escala y opacidad; el divisor es un pseudo-elemento que solo cambia de
     opacidad, centrado: 16 px antes (este padding) y ~15 px después (gap + padding del enlace). */
  .links .pill-logo {
    position: relative;
    display: inline-flex;
    align-items: center;
    margin: 0 0 0 8px;
    padding: 0 16px 0 0;
    border-radius: 0;
    visibility: hidden;
    transition: visibility 0s linear 0.35s;
  }
  .links .pill-logo::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 1px;
    background: hsl(232 20% 40% / 0.15);
    opacity: 0;
    transition: opacity 0.2s var(--ease);
  }
  .links .pill-logo:hover {
    background: none;
  }
  /* Hijo directo: el logo de la empresa. El robot de StudIApp (LottieLogo) trae su propio tamaño y su imagen de
     respaldo va adentro, así que estas reglas no lo tocan. */
  .pill-logo > :global(img) {
    display: block;
    flex-shrink: 0;
    width: auto;
    height: 22px;
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.2s var(--ease-in),
      transform 0.25s var(--ease-in);
  }

  /* Contacto: enlace normal arriba; en el notch se llena con el azul de la marca (la acción principal). El relleno y
     sus sombras son un pseudo-elemento que solo cambia de opacidad: animar background-color y box-shadow repintaba
     el botón en cada cuadro. */
  .links .nav-cta {
    position: relative;
    isolation: isolate;
    margin-left: 4px;
    transition:
      color 0.25s var(--ease),
      transform 0.25s var(--ease),
      filter 0.2s ease;
  }
  .links .nav-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-color: var(--brand);
    box-shadow:
      inset 0 10px 12px -10px hsl(0 0% 100% / 0.45),
      inset 0 1px 1px hsl(0 0% 100% / 0.3),
      0 0 0 1px rgb(1 58 140 / 1),
      0 6px 14px -6px rgb(1 68 160 / 0.6);
    opacity: 0;
    transition: opacity 0.25s var(--ease);
  }
  .cn[data-scrolled] .links .nav-cta,
  .cn[data-scrolled] .links .nav-cta:hover {
    color: hsl(0 0% 100%);
  }
  .cn[data-scrolled] .links .nav-cta:hover {
    filter: brightness(1.12);
  }

  /* Botón de menú (solo celular), adaptado de un diseño de Uiverse: las líneas de arriba y abajo son un solo trazo
     que, al abrir, se recorre (stroke-dashoffset) mientras el ícono gira -45° y forma una X. */
  .menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 34px;
    margin-left: 2px;
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background: none;
    color: hsl(232 30% 12%);
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .menu-btn svg {
    height: 26px;
    transition: transform 0.6s var(--ease);
  }
  .menu-btn .line {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 3;
    transition:
      stroke-dasharray 0.6s var(--ease),
      stroke-dashoffset 0.6s var(--ease);
  }
  .menu-btn .line-top-bottom {
    stroke-dasharray: 12 63;
  }
  .cn[data-open] .menu-btn svg {
    transform: rotate(-45deg);
  }
  .cn[data-open] .menu-btn .line-top-bottom {
    stroke-dasharray: 20 300;
    stroke-dashoffset: -32.42;
  }
  .menu-btn:hover {
    background: hsl(232 40% 50% / 0.07);
  }

  /* Panel del menú: tarjeta de vidrio bajo la píldora; entra con opacidad y transform (sin layout). */
  .menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    width: min(320px, calc(100vw - 2 * var(--gap) - 20px));
    display: none;
    flex-direction: column;
    padding: 8px;
    border-radius: 20px;
    background: linear-gradient(180deg, hsl(0 0% 100% / 0.86) 0%, hsl(220 60% 98% / 0.8) 100%);
    -webkit-backdrop-filter: blur(18px) saturate(1.8);
    backdrop-filter: blur(18px) saturate(1.8);
    box-shadow:
      inset 0 1px 0 hsl(0 0% 100% / 0.95),
      0 0 0 1px hsl(232 30% 40% / 0.06),
      0 24px 48px -20px hsl(232 50% 30% / 0.35);
    opacity: 0;
    transform: translate(-50%, -8px) scale(0.97);
    transform-origin: top center;
    visibility: hidden;
    transition:
      opacity 0.2s var(--ease),
      transform 0.25s var(--ease),
      visibility 0s linear 0.25s;
  }
  .cn[data-open] .menu {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
    visibility: visible;
    transition:
      opacity 0.25s var(--ease),
      transform 0.4s var(--spring),
      visibility 0s linear 0s;
  }
  .menu a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 16px;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 500;
    color: hsl(232 24% 18%);
    transition: background 0.2s ease;
  }
  .menu a:hover,
  .menu a:focus-visible {
    color: hsl(232 30% 10%);
    background: hsl(232 40% 50% / 0.07);
  }

  /* Destello que recorre el borde del botón: un arco de luz (.cta-ring) y su halo difuso (.cta-halo). Cada capa
     es un anillo (la máscara deja solo el borde) con un degradado cónico adentro que gira con transform: corre en
     el hilo gráfico, sin repintar en cada cuadro (animar el ángulo del degradado repintaba las dos capas siempre,
     también arriba del todo, donde no se ven). Solo gira en el notch; fuera de él queda en pausa. */
  .cta-ring {
    position: absolute;
    inset: -2.5px;
    padding: 2.5px;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.15s var(--ease);
  }
  .cta-halo {
    inset: -6px;
    padding: 6px;
    z-index: -1;
    filter: blur(5px);
  }
  /* Cuadrado centrado en el botón que cubre todo el anillo mientras gira: 150 % del ancho alcanza la diagonal de
     cualquier píldora. Girarlo equivale a mover el ángulo inicial del degradado. */
  .cta-ring::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150%;
    aspect-ratio: 1;
    background: conic-gradient(
      transparent 0deg,
      hsl(205 100% 80% / 0.15) 20deg,
      hsl(210 100% 82% / 0.55) 120deg,
      hsl(210 100% 88% / 0.85) 190deg,
      hsl(0 0% 100%) 225deg,
      transparent 240deg,
      transparent 360deg
    );
    transform: translate(-50%, -50%);
    animation: navCtaSpin 3s linear infinite paused;
  }
  .cn[data-scrolled] .cta-ring::before {
    animation-play-state: running;
  }
  @keyframes navCtaSpin {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  /* Vidrio líquido solo con CSS (sin filtros SVG de refracción, que son costosos): un único backdrop-filter,
     fondo translúcido en degradado, filo especular (borde con máscara) y un brillo suave arriba. Es una capa propia
     con la forma final del notch que solo cambia de opacidad: no se repinta ni se rasteriza de nuevo al condensarse. */
  .glass {
    position: absolute;
    inset: -1px;
    z-index: -1;
    border-radius: 0 0 22px 22px;
    pointer-events: none;
    /* 75 % a 65 %: con el desenfoque, lo de atrás se ve difuminado y los enlaces se leen bien. */
    background: linear-gradient(180deg, hsl(0 0% 100% / 0.75) 0%, hsl(220 60% 98% / 0.65) 100%);
    -webkit-backdrop-filter: blur(18px) saturate(1.8) brightness(1.04);
    backdrop-filter: blur(18px) saturate(1.8) brightness(1.04);
    box-shadow:
      inset 0 -1px 1px hsl(0 0% 100% / 0.6),
      inset 0 -8px 16px -10px hsl(215 80% 60% / 0.18),
      0 1px 2px hsl(232 40% 20% / 0.06),
      0 14px 34px -14px hsl(232 50% 30% / 0.32);
    opacity: 0;
    transition: opacity 0.25s var(--ease);
  }
  /* Sin soporte de backdrop-filter no hay difuminado: la barra va casi sólida para que el texto se lea. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass {
      background: hsl(0 0% 100% / 0.94);
    }
  }
  .glass::before,
  .glass::after {
    content: '';
    position: absolute;
    pointer-events: none;
    border-radius: inherit;
  }
  /* Filo de luz en los lados y abajo, más intenso en las esquinas, como el reflejo en un borde curvo. */
  .glass::before {
    inset: 0;
    padding: 0 1px 1px;
    background: linear-gradient(
      135deg,
      hsl(0 0% 100% / 0.95) 0%,
      hsl(0 0% 100% / 0.25) 35%,
      hsl(215 70% 80% / 0.2) 65%,
      hsl(0 0% 100% / 0.8) 100%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }
  /* Brillo especular que baja desde el borde de la ventana. */
  .glass::after {
    inset: 0 10% 50% 10%;
    background: radial-gradient(ellipse 60% 100% at 50% 0%, hsl(0 0% 100% / 0.7), transparent 75%);
  }

  /* ---------- Estado condensado (notch) ---------- */
  .cn[data-scrolled] {
    /* Sube hasta el borde de la ventana con transform (se compone en la GPU; top obligaría a recalcular el layout). */
    transform: translateY(calc(-1 * var(--top)));
    transition: transform 0.55s var(--ease-out);
  }
  /* 1. El logo grande se encoge hacia la píldora y se desvanece. */
  .cn[data-scrolled] .brand {
    opacity: 0;
    transform: translateX(14px) scale(0.6);
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.25s var(--ease-in),
      transform 0.35s var(--ease-in),
      visibility 0s linear 0.35s;
  }
  /* La píldora vuelve al centro (los enlaces se corren a la derecha para dejar sitio al logo) y aparece el vidrio. */
  .cn[data-scrolled] .links {
    align-self: start;
    translate: none;
    transition: translate 0.55s var(--ease-out);
  }
  .cn[data-scrolled] .glass {
    opacity: 1;
    transition: opacity 0.4s var(--ease);
  }
  /* 2. El logo pequeño aparece en su hueco con un leve rebote, y después el divisor. */
  .cn[data-scrolled] .pill-logo {
    visibility: visible;
    transition: visibility 0s linear 0s;
  }
  .cn[data-scrolled] .pill-logo::after {
    opacity: 1;
    transition: opacity 0.3s var(--ease) 0.35s;
  }
  /* StudIApp: robot y nombre. El margen transparente del robot ya separa el dibujo del texto. */
  .pill-logo.has-name {
    gap: 3px;
  }
  .pill-name {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: hsl(232 30% 12%);
  }
  .cn[data-scrolled] .pill-logo > :global(img) {
    opacity: 1;
    /* Ajuste óptico: la estela debajo de las letras sube el peso visual del logo; 2 px abajo lo alinea con el texto. */
    transform: translateY(2px);
    transition:
      opacity 0.35s var(--ease) 0.2s,
      transform 0.55s var(--spring) 0.2s;
  }
  /* 3. Contacto se llena de azul con un pequeño pulso y después se enciende el destello. */
  .cn[data-scrolled] .links .nav-cta {
    animation: ctaPop 0.5s var(--spring) 0.3s backwards;
    transition:
      color 0.3s var(--ease) 0.3s,
      filter 0.2s ease;
  }
  .cn[data-scrolled] .links .nav-cta::before {
    opacity: 1;
    transition: opacity 0.4s var(--ease) 0.3s;
  }
  .cn[data-scrolled] .cta-ring {
    opacity: 1;
    transition: opacity 0.5s var(--ease) 0.6s;
  }
  .cn[data-scrolled] .cta-halo {
    opacity: 0.85;
  }

  @keyframes ctaPop {
    from {
      transform: scale(0.92);
    }
    to {
      transform: none;
    }
  }
  /* Con translate y no transform: el transform es el que sube la barra al notch, y una animación de transform lo
     pisaría mientras dura. La nav que arranca en notch (celular, StudIApp) bajaba hasta la posición de arriba del
     todo y al terminar la entrada saltaba al borde. Así la entrada se suma encima del notch y no lo reemplaza. */
  @keyframes cnIn {
    from {
      opacity: 0;
      translate: 0 -12px;
    }
    to {
      opacity: 1;
      translate: none;
    }
  }

  /* Tablet y celular: siempre en notch (lo fija el script), compacto, con el logo, Contacto y el botón de menú; el resto de enlaces va en el panel.
     Todo mide 30 px de alto y comparte el mismo eje vertical; el botón Contacto es más chico que en escritorio. */
  @media (max-width: 899px) {
    .cn {
      --top: calc(var(--gap) + 8px);
      left: calc(var(--gap) + 10px);
      right: calc(var(--gap) + 10px);
      height: 46px;
    }
    .brand :global(img) {
      height: 28px;
    }
    .links {
      gap: 4px;
      padding: 7px 6px 6px;
    }
    .links a:not(.pill-logo, .nav-cta) {
      display: none;
    }
    .links .nav-cta {
      display: inline-flex;
      align-items: center;
      height: 30px;
      /* 6 px + el gap de 4 px: deja el divisor a 10 px del botón, igual que del logo. */
      margin-left: 6px;
      padding: 0 12px;
      font-size: 13px;
    }
    /* Halo más ceñido: el de escritorio se ve grueso en un botón tan pequeño. */
    .cta-halo {
      inset: -4px;
      padding: 4px;
    }
    .menu-btn {
      display: inline-flex;
      width: 32px;
      height: 30px;
      margin-left: 0;
    }
    .menu-btn svg {
      height: 22px;
    }
    .menu {
      display: flex;
    }
    .pill-logo > :global(img) {
      height: 18px;
    }
    .pill-name {
      font-size: 14px;
    }
    .links .pill-logo {
      margin-left: 6px;
      padding-right: 10px;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-cn]');
  const sentinel = document.querySelector<HTMLElement>('[data-cn-sentinel]');
  // Escritorio: notch al bajar más de 60 px. Celular y landing de StudIApp (data-cn-notch): notch siempre.
  const mobile = matchMedia('(max-width: 899px)');
  if (nav && sentinel) {
    const alwaysNotch = nav.hasAttribute('data-cn-notch');
    let atTop = true;
    const update = () => nav.toggleAttribute('data-scrolled', alwaysNotch || !atTop || mobile.matches);
    new IntersectionObserver(([entry]) => {
      atTop = entry.isIntersecting;
      update();
    }).observe(sentinel);
    mobile.addEventListener('change', update);

    // La entrada (cnIn) se quita al terminar: mientras siga asignada, Chrome trata la transición de transform del
    // notch como incompatible con ella y la mueve en el hilo principal en vez de componerla en la GPU.
    const endIntro = (e: AnimationEvent) => {
      if (e.target !== nav) return;
      nav.style.animation = 'none';
      nav.removeEventListener('animationend', endIntro);
    };
    if (nav.getAnimations().every((a) => a.playState === 'finished')) nav.style.animation = 'none';
    else nav.addEventListener('animationend', endIntro);
  }

  // Menú de celular: abre y cierra con el botón; se cierra con Escape, al tocar fuera, al elegir un enlace o al pasar a escritorio.
  const btn = document.querySelector<HTMLButtonElement>('[data-cn-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-cn-menu]');
  if (nav && btn && menu) {
    const setOpen = (open: boolean) => {
      nav.toggleAttribute('data-open', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    };
    const isOpen = () => nav.hasAttribute('data-open');
    btn.addEventListener('click', () => setOpen(!isOpen()));
    menu.querySelectorAll('[data-cn-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        btn.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (isOpen() && !nav.contains(e.target as Node)) setOpen(false);
    });
    mobile.addEventListener('change', (e) => !e.matches && setOpen(false));
  }
</script>
