---
import { SITE } from '../data/site';
const mailto = `mailto:${SITE.email}?subject=${encodeURIComponent('Agenda una reunión con StudIApp')}`;
---

<section id="agenda" aria-labelledby="agenda-titulo" class="agenda" data-screen-label="Agenda una reunión">
  <div aria-hidden="true" class="glow"></div>
  <div class="inner">
    <p class="kicker">Agenda hoy · Reunión de 30 minutos</p>
    <h2 id="agenda-titulo">Optimiza tu tiempo y enfócate en lo más importante:<br /><span class="serif">tus estudiantes.</span></h2>
    <p class="lead">Menos horas en formatos y planeaciones, más horas en el aula. Te mostramos cómo funciona con las plantillas de tu colegio.</p>
    <div class="ctas">
      <a href={mailto} class="btn-light">
        Agenda una reunión
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
      <a href="#caracteristicas" class="btn-ghost">Ver características</a>
    </div>
  </div>
</section>

<style>
  .agenda {
    position: relative;
    margin-top: var(--gap);
    border-radius: var(--radius);
    overflow: hidden;
    background: hsl(222 30% 6%);
    color: hsl(0 0% 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(72px, 8vw, 112px) clamp(24px, 5vw, 64px);
  }
  .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 34% 55% at 6% 104%, hsl(222 95% 46% / 0.6) 0%, hsl(222 90% 40% / 0.18) 45%, transparent 75%),
      radial-gradient(ellipse 34% 55% at 94% -4%, hsl(222 95% 46% / 0.6) 0%, hsl(222 90% 40% / 0.18) 45%, transparent 75%);
  }
  .inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    max-width: 940px;
  }
  .kicker {
    margin: 0 0 24px;
    font-family: var(--font-outfit);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: hsl(222 24% 78%);
  }
  h2 {
    margin: 0;
    font-family: var(--font-inter-tight);
    font-weight: 500;
    font-size: clamp(2.125rem, 5.8vw, 4.6rem);
    line-height: 1.06;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .serif {
    font-family: var(--font-instrument-serif);
    font-style: italic;
    font-weight: 400;
    color: hsl(222 100% 88%);
    letter-spacing: 0;
  }
  .lead {
    margin: 24px 0 0;
    font-size: clamp(16px, 1.35vw, 18px);
    line-height: 1.6;
    color: hsl(222 12% 80%);
    max-width: 560px;
    text-wrap: pretty;
  }
  .ctas {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }
  .btn-light {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 54px;
    padding: 0 26px;
    border-radius: 9999px;
    background: hsl(222 100% 92%);
    color: hsl(222 30% 8%);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: background 0.2s ease;
  }
  .btn-light:hover {
    background: hsl(0 0% 100%);
    color: hsl(222 30% 8%);
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    height: 54px;
    padding: 0 26px;
    border-radius: 9999px;
    border: 1px solid hsl(0 0% 100% / 0.36);
    color: hsl(0 0% 100%);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }
  .btn-ghost:hover {
    border-color: hsl(0 0% 100% / 0.7);
    background: hsl(0 0% 100% / 0.06);
    color: hsl(0 0% 100%);
  }
</style>
