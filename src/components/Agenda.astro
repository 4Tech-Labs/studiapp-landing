---
import { SITE, PRODUCT } from '../data/site';
import EdgeSweep from './EdgeSweep.astro';
import MagicRings from './MagicRings.astro';
import WaveTitle from './WaveTitle.astro';
import { waveLabel } from '../lib/wave-title';

interface Props {
  /** 'product' en la landing de StudIApp; 'company' es el contacto del home de la empresa. */
  variant?: 'product' | 'company';
}

const { variant = 'product' } = Astro.props;
const isProduct = variant === 'product';
const subject = isProduct ? `Agenda una reunión con ${PRODUCT.name}` : 'Contacto desde 4techlabs.com';
const mailto = `mailto:${SITE.email}?subject=${encodeURIComponent(subject)}`;
// Con agendador, el botón lo abre en otra pestaña y el correo queda como alternativa en la nota.
const booking = SITE.bookingUrl ? { href: SITE.bookingUrl, target: '_blank', rel: 'noopener' } : { href: mailto };
// WhatsApp abre el chat con un primer mensaje según la página, para que sepamos de dónde llega.
const whatsappText = isProduct ? `Hola, quiero conocer ${PRODUCT.name}.` : 'Hola, quiero contarles sobre un proyecto.';
const whatsapp = SITE.whatsapp && `https://wa.me/${SITE.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(whatsappText)}`;
const id = isProduct ? 'agenda' : 'contacto';
// Las dos variantes tienen el mismo diseño; solo cambian los textos.
const copy = isProduct
  ? {
      title: [{ text: 'Optimiza tu tiempo y enfócate en lo más importante:' }, { text: 'tus estudiantes.', accent: true, break: true }],
      lead: 'Menos horas en formatos y planeaciones, más horas en el aula. Te mostramos cómo funciona con las plantillas de tu colegio.',
    }
  : {
      title: [{ text: 'Hablemos de' }, { text: 'tu próximo proyecto.', accent: true, break: true }],
      lead: 'Cuéntanos qué quieres construir y te proponemos cómo hacerlo: software a la medida, aplicaciones o soluciones con IA.',
    };
---

<section id={id} aria-labelledby={`${id}-titulo`} class="agenda" data-screen-label={isProduct ? 'Agenda una reunión' : 'Contacto'}>
  <div aria-hidden="true" class="glow"></div>
  {/* Anillos azules que van del 55 % al 95 % del medio ancho, para que enmarquen el texto por los lados en vez de
      pasar por detrás del titular. */}
  <div aria-hidden="true" class="rings">
    <MagicRings
      color="#8fb3ff"
      colorTwo="#2f5bd9"
      ringCount={6}
      span={[0.55, 0.95]}
      expansion={0.05}
      lineThickness={1.6}
      glow={0.9}
      hoverScale={1.04}
      parallax={0.03}
    />
  </div>
  <div class="inner">
    <p class="kicker">Reunión de 30 minutos</p>
    <h2 id={`${id}-titulo`} aria-label={waveLabel(copy.title)}>
      <WaveTitle parts={copy.title} theme="dark" />
    </h2>
    <p class="lead">{copy.lead}</p>
    {/* Agendar es la acción principal; WhatsApp, la vía rápida, va como botón secundario. El correo va en la nota. */}
    <div class="ctas">
      <a {...booking} class="btn-primary">
        <EdgeSweep fill="var(--brand-grad)" edge="hsl(210 100% 75% / 0.35)" />
        Agenda una reunión
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
      {
        whatsapp && (
          <a href={whatsapp} target="_blank" rel="noopener" class="btn-secondary">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            Escríbenos por WhatsApp
          </a>
        )
      }
    </div>
    {
      SITE.bookingUrl ? (
        <p class="note">
          ¿Prefieres escribirnos? <a href={mailto}>{SITE.email}</a>. Al agendar o escribirnos, tratamos tus datos según nuestra <a href="/tratamiento-de-datos">Política de tratamiento de datos</a>.
        </p>
      ) : (
        <p class="note">Al escribirnos, tratamos tus datos según nuestra <a href="/tratamiento-de-datos">Política de tratamiento de datos</a>.</p>
      )
    }
  </div>
</section>

<style>
  /* overflow: clip y no hidden: hidden vuelve la sección un contenedor de scroll y la ola del título (WaveTitle)
     seguiría el scroll de la sección, que nunca se mueve, en vez del de la página */
  .agenda {
    position: relative;
    margin-top: var(--gap);
    border-radius: var(--radius);
    overflow: clip;
    background: hsl(222 30% 6%);
    color: hsl(0 0% 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(72px, 8vw, 112px) clamp(24px, 5vw, 64px);
    scroll-margin-top: 14px;
  }
  /* Safari < 16 no conoce overflow: clip (tampoco las animaciones ligadas al scroll: ahí la ola va por JavaScript) */
  @supports not (overflow: clip) {
    .agenda {
      overflow: hidden;
    }
  }
  .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 34% 55% at 6% 104%, hsl(222 95% 46% / 0.6) 0%, hsl(222 90% 40% / 0.18) 45%, transparent 75%),
      radial-gradient(ellipse 34% 55% at 94% -4%, hsl(222 95% 46% / 0.6) 0%, hsl(222 90% 40% / 0.18) 45%, transparent 75%);
  }
  .rings {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* En celular la sección es angosta y los anillos quedan detrás del texto: no se muestran. Oculto, el observer
     nunca lo ve en pantalla y el WebGL ni siquiera se monta. */
  @media (max-width: 767px) {
    .rings {
      display: none;
    }
  }
  .inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    max-width: 940px;
  }
  .kicker {
    margin: 0 0 24px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(222 24% 78%);
  }
  /* La escala de los títulos de sección del home (32 a 54 px, 600, −0,025em), también en la landing de StudIApp */
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .lead {
    margin: 24px 0 0;
    font-size: clamp(16px, 1.2vw, 17px);
    line-height: 1.6;
    color: hsl(222 12% 80%);
    max-width: 560px;
    text-wrap: pretty;
  }
  .ctas {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }
  /* Botón principal en el azul de la marca; sobre el fondo oscuro lleva un filo claro para despegarse, y por ese filo
     corre una luz sin parar (EdgeSweep, que también pinta el relleno): es el cierre de la página y la acción principal
     de la sección. A la medida del de Productos (48 px de alto); en celular, 44 px, el mínimo cómodo para el dedo. */
  .btn-primary {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    padding: 0 22px;
    border-radius: 9999px;
    color: hsl(0 0% 100%);
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    box-shadow:
      var(--brand-shadow),
      0 0 32px -6px rgb(26 92 192 / 0.6);
  }
  .btn-primary:hover {
    color: hsl(0 0% 100%);
  }
  .btn-primary:active {
    translate: 0 1px;
  }
  /* Secundario: vidrio claro con filo, sin luz ni relleno, para que no compita con Agenda. Mismo alto. */
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    padding: 0 22px;
    border-radius: 9999px;
    background: hsl(0 0% 100% / 0.06);
    box-shadow: inset 0 0 0 1px hsl(222 60% 85% / 0.28);
    color: hsl(0 0% 100%);
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .btn-secondary:hover {
    color: hsl(0 0% 100%);
    background: hsl(0 0% 100% / 0.12);
    box-shadow: inset 0 0 0 1px hsl(222 60% 90% / 0.45);
  }
  .btn-secondary:active {
    translate: 0 1px;
  }
  @media (max-width: 479px) {
    .btn-primary,
    .btn-secondary {
      height: 44px;
    }
  }
  .note {
    margin: 24px 0 0;
    max-width: 440px;
    font-size: 13px;
    line-height: 1.55;
    color: hsl(222 24% 70%);
    text-wrap: balance;
  }
  .note a {
    color: hsl(222 100% 88%);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .note a:hover {
    color: hsl(0 0% 100%);
  }
</style>
