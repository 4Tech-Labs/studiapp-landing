---
/**
 * Logo animado (robot Lottie).
 * - Placeholder: imagen estática del primer frame (public/logo.webp), visible desde el primer pintado, sin CLS.
 * - El reproductor usa el build canvas (sin coste de layout/estilo por frame, a diferencia del SVG) y se carga
 *   tras la primera interacción del usuario o 4 s después de `load`; cada instancia solo anima mientras es visible.
 * - Con `prefers-reduced-motion` no se carga nada: queda la imagen.
 */
interface Props {
  width: number;
  height: number;
  class?: string;
}
const { width, height, class: className } = Astro.props;
---

<span class:list={['lottie-logo', className]} data-lottie="/lottie/robot.json" aria-hidden="true" style={`width:${width}px;height:${height}px`}>
  <img src="/logo.webp" width={width} height={height} alt="" decoding="async" />
</span>

<style>
  .lottie-logo {
    position: relative;
    display: block;
    flex-shrink: 0;
  }
  .lottie-logo img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .lottie-logo[data-live] img {
    display: none;
  }
  .lottie-logo :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }
</style>

<script>
  import type { AnimationItem, LottiePlayer } from 'lottie-web';

  const nodes = Array.from(document.querySelectorAll<HTMLElement>('[data-lottie]'));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (nodes.length && !reduce) {
    let loading: Promise<{ lottie: LottiePlayer; data: unknown }> | null = null;
    const load = () =>
      (loading ??= Promise.all([
        import('lottie-web/build/player/lottie_light_canvas'),
        fetch(nodes[0]!.dataset.lottie!).then((r) => r.json()),
      ]).then(([m, data]) => ({ lottie: m.default, data })));

    const anims = new Map<HTMLElement, AnimationItem>();
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const el = entry.target as HTMLElement;
        const anim = anims.get(el);
        if (!entry.isIntersecting) {
          anim?.pause();
          continue;
        }
        if (anim) {
          anim.play();
          continue;
        }
        load()
          .then(({ lottie, data }) => {
            if (anims.has(el)) return;
            const a = lottie.loadAnimation({
              container: el,
              renderer: 'canvas',
              loop: true,
              autoplay: true,
              animationData: data,
              rendererSettings: { clearCanvas: true, dpr: Math.min(window.devicePixelRatio || 1, 3) },
            });
            a.setSubframe(false); // dibuja a los 30 fps nativos del archivo, no a 60
            anims.set(el, a);
            el.setAttribute('data-live', '');
          })
          .catch((err) => console.warn('[lottie]', err));
      }
    });

    let armed = false;
    const go = () => {
      if (armed) return;
      armed = true;
      nodes.forEach((n) => io.observe(n));
    };
    for (const ev of ['pointerdown', 'keydown', 'touchstart', 'wheel', 'scroll']) {
      window.addEventListener(ev, go, { once: true, passive: true });
    }
    const later = () =>
      setTimeout(() => ('requestIdleCallback' in window ? window.requestIdleCallback(go, { timeout: 2000 }) : go()), 4000);
    if (document.readyState === 'complete') later();
    else window.addEventListener('load', later, { once: true });
  }
</script>
