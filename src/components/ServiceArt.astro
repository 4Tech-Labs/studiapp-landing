---
// Ilustración de cada servicio (sección Servicios), dibujada en SVG para que escale con la tarjeta. Sin texto: son
// formas, así que no aportan palabras al contenido de la página. Decorativa: quien la usa la envuelve en aria-hidden.
// Las animaciones corren solo mientras la tarjeta está en pantalla: leen --play, que la tarjeta pone en `running`
// (Services.astro). En pausa (o sin JavaScript) cada dibujo queda en su primer cuadro, que ya se ve completo.
interface Props {
  /** id del servicio en SERVICES. Uno sin dibujo propio usa el de software a la medida. */
  id: string;
}

const { id } = Astro.props;
const kind = ['aplicaciones-web', 'aplicaciones-moviles', 'inteligencia-artificial'].includes(id) ? id : 'software-a-la-medida';
// Los degradados se referencian por id, que debe ser único en el documento.
const grad = `art-grad-${id}`;
---

<svg class="art" viewBox="0 0 240 170" fill="none" role="presentation" focusable="false">
  <defs>
    <linearGradient id={grad} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2f6fd6"></stop>
      <stop offset="1" stop-color="#0144a0"></stop>
    </linearGradient>
  </defs>

  {
    kind === 'software-a-la-medida' && (
      // Dos sistemas que entran a una pieza hecha a la medida y salen resueltos
      <>
        <g class="wires">
          <path class="wire" d="M66 50C92 50 88 85 108 85" />
          <path class="wire" d="M66 120C92 120 88 85 108 85" />
          <path class="wire" d="M160 85H180" />
        </g>
        <g class="node">
          <rect class="paper" x="18" y="30" width="48" height="40" rx="11" />
          <rect class="sk" x="28" y="42" width="20" height="5" rx="2.5" />
          <rect class="sk" x="28" y="52" width="28" height="5" rx="2.5" />
        </g>
        <g class="node">
          <rect class="paper" x="18" y="100" width="48" height="40" rx="11" />
          <circle class="sk" cx="34" cy="120" r="6" />
          <rect class="sk" x="44" y="117.5" width="14" height="5" rx="2.5" />
        </g>
        <rect class="ring" x="108" y="59" width="52" height="52" rx="15" />
        <g class="core">
          <rect x="108" y="59" width="52" height="52" rx="15" fill={`url(#${grad})`} />
          <polyline class="glyph" points="128 77 121 85 128 93" />
          <polyline class="glyph" points="140 77 147 85 140 93" />
        </g>
        <g class="node">
          <rect class="paper" x="180" y="63" width="44" height="44" rx="12" />
          <polyline class="check" points="193 85 199.5 91.5 211 79" pathLength="1" />
        </g>
      </>
    )
  }

  {
    kind === 'aplicaciones-web' && (
      // Ventana de navegador con un panel: menú, dos indicadores y una gráfica de barras
      <>
        <g class="window">
          <rect class="paper" x="20" y="16" width="200" height="138" rx="13" />
          <path class="chrome" d="M20.5 40V29A12.5 12.5 0 0 1 33 16.5H207A12.5 12.5 0 0 1 219.500 29V40Z" />
          <circle class="light" cx="35" cy="28" r="3" />
          <circle class="light" cx="45" cy="28" r="3" />
          <circle class="light" cx="55" cy="28" r="3" />
          <rect class="url" x="72" y="23" width="96" height="10" rx="5" />
          <line class="rule" x1="76" y1="40" x2="76" y2="154" />
          <rect class="tint-strong" x="30" y="52" width="36" height="9" rx="4.500" />
          <rect class="sk" x="30" y="68" width="28" height="6" rx="3" />
          <rect class="sk" x="30" y="81" width="32" height="6" rx="3" />
          <rect class="sk" x="30" y="94" width="24" height="6" rx="3" />
          <rect class="tile" x="86" y="50" width="58" height="30" rx="8" />
          <rect class="sk" x="94" y="58" width="22" height="4" rx="2" />
          <rect class="ink" x="94" y="66" width="34" height="7" rx="3.500" />
          <rect class="tile" x="152" y="50" width="58" height="30" rx="8" />
          <rect class="sk" x="160" y="58" width="18" height="4" rx="2" />
          <rect class="ink" x="160" y="66" width="28" height="7" rx="3.500" />
        </g>
        <g class="bars">
          {[22, 34, 27, 44, 36, 54].map((h, i) => (
            <rect class="bar" x={88 + i * 21} y={144 - h} width="12" height={h} rx="4" fill={i === 5 ? `url(#${grad})` : undefined} style={`--d:${i}`} />
          ))}
        </g>
      </>
    )
  }

  {
    kind === 'aplicaciones-moviles' && (
      // Dos teléfonos: el de atrás inclinado, el de adelante con una pantalla y una notificación que llega
      <>
        <g transform="rotate(-9 96 88)">
          <rect class="tile" x="64" y="26" width="62" height="124" rx="14" />
          <rect class="sk" x="74" y="42" width="30" height="6" rx="3" />
          <rect class="sk" x="74" y="56" width="42" height="22" rx="6" />
          <rect class="sk" x="74" y="84" width="42" height="10" rx="5" />
          <rect class="sk" x="74" y="100" width="28" height="10" rx="5" />
        </g>
        <g class="float">
          <rect class="paper phone" x="112" y="12" width="72" height="146" rx="16" />
          <rect class="ink" x="138" y="19" width="20" height="5" rx="2.500" />
          <circle class="tint-strong" cx="127" cy="40" r="6.500" />
          <rect class="sk" x="138" y="37" width="30" height="6" rx="3" />
          <rect x="121" y="54" width="54" height="34" rx="9" fill={`url(#${grad})`} />
          <rect class="on-brand" x="129" y="63" width="24" height="5" rx="2.500" />
          <rect class="on-brand soft" x="129" y="73" width="34" height="5" rx="2.500" />
          <rect class="tile" x="121" y="94" width="54" height="15" rx="6" />
          <rect class="tile" x="121" y="114" width="54" height="15" rx="6" />
          <circle class="sk" cx="133" cy="143" r="3" />
          <circle class="dot-on" cx="148" cy="143" r="3" />
          <circle class="sk" cx="163" cy="143" r="3" />
        </g>
        <g class="toast">
          <rect class="paper" x="156" y="30" width="62" height="24" rx="12" />
          <circle cx="168" cy="42" r="5" fill={`url(#${grad})`} />
          <rect class="sk" x="178" y="39.500" width="30" height="5" rx="2.500" />
        </g>
      </>
    )
  }

  {
    kind === 'inteligencia-artificial' && (
      // Una conversación: la pregunta y la respuesta del asistente, que se escribe línea por línea
      <>
        <rect x="100" y="18" width="122" height="36" rx="15" fill={`url(#${grad})`} />
        <rect class="on-brand" x="114" y="29" width="72" height="5" rx="2.500" />
        <rect class="on-brand soft" x="114" y="39" width="46" height="5" rx="2.500" />
        <rect class="tint-strong" x="18" y="70" width="32" height="32" rx="11" />
        <path class="spark-main" d="M34 76Q34 86 44 86Q34 86 34 96Q34 86 24 86Q34 86 34 76Z" />
        <rect class="paper" x="58" y="66" width="158" height="82" rx="17" />
        <rect class="sk typed" x="72" y="82" width="112" height="6" rx="3" style="--d:0" />
        <rect class="sk typed" x="72" y="96" width="128" height="6" rx="3" style="--d:1" />
        <rect class="sk typed" x="72" y="110" width="88" height="6" rx="3" style="--d:2" />
        <rect class="tint-strong typed" x="72" y="126" width="40" height="11" rx="5.500" style="--d:3" />
        <path class="twinkle" d="M222 62Q222 68 228 68Q222 68 222 74Q222 68 216 68Q222 68 222 62Z" style="--d:0" />
        <path class="twinkle" d="M82 28Q82 33 87 33Q82 33 82 38Q82 33 77 33Q82 33 82 28Z" style="--d:2" />
      </>
    )
  }
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    --brand-1: #0144a0;
    --line: hsl(222 55% 86%);
    --skeleton: hsl(222 60% 90%);
    --tint: hsl(216 100% 96%);
  }
  /* Piezas comunes */
  .paper {
    fill: hsl(0 0% 100%);
    stroke: var(--line);
    filter: drop-shadow(0 8px 10px hsl(222 70% 40% / 0.12));
  }
  .tile {
    fill: var(--tint);
    stroke: var(--line);
  }
  .sk {
    fill: var(--skeleton);
  }
  .ink {
    fill: hsl(226 50% 22%);
  }
  .tint-strong {
    fill: hsl(216 100% 90%);
  }
  .on-brand {
    fill: hsl(0 0% 100%);
  }
  .on-brand.soft {
    opacity: 0.6;
  }
  .dot-on {
    fill: var(--brand-1);
  }
  :is(.ring, .bar, .float, .toast, .typed, .twinkle, .core, .spark-main) {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Software a la medida: los datos corren por los cables hacia la pieza central, que late */
  .wire {
    stroke: hsl(222 75% 74%);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 3 7;
    animation: art-flow 0.9s linear infinite;
  }
  .glyph {
    stroke: hsl(0 0% 100%);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .core {
    filter: drop-shadow(0 10px 12px hsl(216 98% 32% / 0.35));
  }
  .ring {
    stroke: hsl(216 90% 55%);
    stroke-width: 1.5;
    opacity: 0;
    animation: art-ring 2.4s ease-out infinite;
  }
  .check {
    stroke: var(--brand-1);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    animation: art-check 3.6s ease-in-out infinite;
  }
  @keyframes art-flow {
    to {
      stroke-dashoffset: -10;
    }
  }
  @keyframes art-ring {
    0% {
      opacity: 0.7;
      scale: 1;
    }
    70%,
    100% {
      opacity: 0;
      scale: 1.42;
    }
  }
  @keyframes art-check {
    0%,
    55%,
    100% {
      stroke-dashoffset: 0;
    }
    68% {
      stroke-dashoffset: 1;
    }
    82% {
      stroke-dashoffset: 0;
    }
  }

  /* Aplicaciones web: las barras de la gráfica suben y bajan a destiempo */
  .chrome {
    fill: var(--tint);
    stroke: var(--line);
  }
  .light {
    fill: hsl(222 60% 82%);
  }
  .url {
    fill: hsl(0 0% 100%);
    stroke: var(--line);
  }
  .rule {
    stroke: var(--line);
  }
  .bar {
    fill: hsl(216 95% 82%);
    transform-origin: 50% 100%;
    animation: art-bar 2.8s ease-in-out calc(var(--d) * -0.37s) infinite alternate;
  }
  @keyframes art-bar {
    from {
      scale: 1 1;
    }
    to {
      scale: 1 0.62;
    }
  }

  /* Aplicaciones móviles: el teléfono flota y una notificación entra y sale */
  .float {
    animation: art-float 3.4s ease-in-out infinite alternate;
  }
  .toast {
    animation: art-toast 5s cubic-bezier(0.34, 1.4, 0.64, 1) infinite;
  }
  @keyframes art-float {
    to {
      translate: 0 -5px;
    }
  }
  @keyframes art-toast {
    0%,
    62%,
    100% {
      opacity: 1;
      scale: 1;
      translate: 0 0;
    }
    74%,
    84% {
      opacity: 0;
      scale: 0.7;
      translate: 10px -4px;
    }
  }

  /* Inteligencia artificial: la respuesta se escribe línea por línea y las chispas titilan */
  .spark-main {
    fill: var(--brand-1);
    animation: art-spark 3s ease-in-out infinite alternate;
  }
  .typed {
    transform-origin: 0 50%;
    animation: art-type 5.2s ease-out calc(var(--d) * 0.38s) infinite;
  }
  .twinkle {
    fill: hsl(216 95% 62%);
    animation: art-twinkle 2.6s ease-in-out calc(var(--d) * -0.6s) infinite alternate;
  }
  @keyframes art-spark {
    to {
      rotate: 90deg;
      scale: 0.82;
    }
  }
  @keyframes art-type {
    0%,
    66%,
    100% {
      scale: 1 1;
      opacity: 1;
    }
    72% {
      scale: 0 1;
      opacity: 0;
    }
    73% {
      scale: 0 1;
      opacity: 1;
    }
    86% {
      scale: 1 1;
    }
  }
  @keyframes art-twinkle {
    from {
      opacity: 1;
      scale: 1;
    }
    to {
      opacity: 0.25;
      scale: 0.6;
    }
  }

  /* Al final a propósito: el shorthand `animation` de cada pieza devuelve animation-play-state a running, y esta
     regla (misma especificidad, más abajo) lo deja en pausa hasta que la tarjeta entra en pantalla. */
  :is(.wire, .check, .ring, .bar, .float, .toast, .typed, .twinkle, .spark-main) {
    animation-play-state: var(--play, paused);
  }

  @media (prefers-reduced-motion: reduce) {
    .art * {
      animation: none !important;
    }
  }
</style>
