---
// Mar de olas en degradado en WebGL2 (port sin React de <GradientWaves /> de React Bits, ver src/lib/gradient-waves.js).
// Las props son las mismas del componente original; se pasan al script como JSON en data-options.
// Llena su contenedor: el padre necesita position relative y un alto.
interface Props {
  horizonColor?: string;
  waveColor?: string;
  crestColor?: string;
  backgroundColor?: string;
  lightMode?: boolean;
  speed?: number;
  amplitude?: number;
  waveScale?: number;
  waveRatio?: number;
  swell?: number;
  turbulence?: number;
  tilt?: number;
  zoom?: number;
  height?: number;
  fogDepth?: number;
  relief?: number;
  lightAngle?: number;
  sheen?: number;
  brightness?: number;
  opacity?: number;
  grain?: number;
  quality?: 'low' | 'medium' | 'high';
  intro?: boolean;
  mouseInteraction?: boolean;
  parallaxStrength?: number;
  mouseStrength?: number;
  swellOnClick?: boolean;
  paused?: boolean;
  dpr?: number;
  class?: string;
}

// Astro agrega atributos data-astro-cid-* de quien usa el componente: no son opciones de las olas.
const { class: className, ...props } = Astro.props;
const options = Object.fromEntries(Object.entries(props).filter(([key]) => !key.startsWith('data-')));
---

<div class:list={['gradient-waves', className]} data-gradient-waves data-options={JSON.stringify(options)}>
  <canvas class="gradient-waves-canvas" aria-hidden="true"></canvas>
</div>

<style>
  .gradient-waves {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .gradient-waves-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { lazyMount } from '../lib/lazy-mount';

  // Se monta (contexto WebGL + shaders) solo cuando el contenedor se acerca a la pantalla, no al cargar la página.
  lazyMount('[data-gradient-waves]', () => import('../lib/gradient-waves.js').then((m) => m.mountGradientWaves));
</script>
