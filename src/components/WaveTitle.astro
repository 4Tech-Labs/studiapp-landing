---
// Titular con "color wave": al hacer scroll, una ola de color recorre el texto letra por letra (tenue → color de la
// ola → color final). Va DENTRO del h2 de cada sección, que conserva sus estilos (fuente, tamaño, color).
// Las partes con accent llevan el color de acento del tema; el resto termina en el color del h2 (currentColor).
// break: true empieza esa parte en una línea nueva.
// El texto va una sola vez en el HTML, letra por letra y oculto a los lectores de pantalla: el h2 que lo contiene
// lleva el texto completo en aria-label (waveLabel, en src/lib/wave-title.ts). Así los buscadores leen el titular
// una vez y los lectores de pantalla lo anuncian entero, no letra por letra.
// La sección que lo contiene no puede llevar overflow: hidden (usar clip): view() seguiría el scroll de la sección.
// El respaldo en JavaScript para navegadores sin animation-timeline está en src/scripts/wave-title.ts (lo carga
// Base.astro): un <script> aquí quedaría dentro del h2.
import type { WavePart } from '../lib/wave-title';

interface Props {
  parts: WavePart[];
  /** light: sobre fondo claro (acento en el degradado azul de marca). dark: sobre fondo oscuro (acento azul claro). */
  theme?: 'light' | 'dark';
  /** Sin la ola: el titular queda quieto en sus colores finales, igual que los demás al terminar. */
  still?: boolean;
}

const { parts, theme = 'light', still = false } = Astro.props;

let index = 0;
const words = parts.flatMap((part, pi) =>
  part.text
    .split(' ')
    .filter(Boolean)
    .map((word, wi) => ({
      lineBreak: Boolean(part.break) && pi > 0 && wi === 0,
      chars: [...word].map((ch, k, all) => {
        const step = Math.round((k / Math.max(all.length - 1, 1)) * 100);
        const accent = theme === 'dark' ? 'var(--wt-accent)' : `color-mix(in oklab, #1a5cc0, #0144a0 ${step}%)`;
        return { ch, style: `--i:${index++};--final:${part.accent ? accent : 'currentColor'}` };
      }),
    })),
);
const total = index;
---

{/* Sin data-wave-title, ni la animación de CSS ni el respaldo de JavaScript lo toman */}
<span class:list={['wave-title', `wt-${theme}`, { 'wt-still': still }]} style={`--n:${total}`} data-wave-title={still ? undefined : ''} aria-hidden="true">
  {
    words.map((word, wi) => (
      <>
        {/* El espacio va también antes del salto de línea: sin él, un lector del HTML pegaría las dos palabras */}
        {wi > 0 && ' '}
        {word.lineBreak && <br />}
        {/* Letras pegadas (sin saltos de línea entre ellas) para no meter espacios dentro de la palabra */}
        <span class="w">{word.chars.map((c) => <span class="c" style={c.style}>{c.ch}</span>)}</span>
      </>
    ))
  }
</span>

<style>
  /* Todo depende de un solo número, --wave-p (0 → 1). Cada letra calcula su propio tramo de la ola, así se anima
     una sola variable por cuadro y no una animación por letra. */
  @property --wave-p {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }
  .wave-title {
    display: block;
    /* Ancho de la ola en letras: más ancha, cada letra se queda más tiempo en el color de la ola */
    --wave-w: 9;
    --wave-p: 1;
    --wave: #4f8ff7;
  }
  .wt-light {
    --dim: hsl(232 18% 85%);
  }
  .wt-dark {
    --dim: hsl(226 22% 26%);
    --wt-accent: hsl(222 100% 88%);
  }
  .w {
    white-space: nowrap;
  }
  .c {
    --t: clamp(0, (var(--wave-p) * (var(--n) + var(--wave-w)) - var(--i)) / var(--wave-w), 1);
    color: color-mix(
      in oklab,
      color-mix(in oklab, var(--dim), var(--wave) calc(min(var(--t) * 2, 1) * 100%)),
      var(--final) calc(max(var(--t) * 2 - 1, 0) * 100%)
    );
  }
  /* Navegadores con animaciones ligadas al scroll: corre en CSS, sin JavaScript */
  @supports (animation-timeline: view()) {
    .wave-title {
      animation: wave-progress linear both;
    }
    /* En otra regla a propósito: el minificador juntaría animation-timeline dentro del shorthand `animation`,
       y Chrome descarta ese shorthand completo (el timeline no es válido ahí) */
    /* Empieza apenas el título asoma abajo y termina cuando llega a ~38 % del borde de arriba: con un tramo más
       corto la ola terminaba en la mitad de abajo de la pantalla y casi no se alcanzaba a ver */
    [data-wave-title] {
      animation-timeline: view();
      animation-range: cover 8% cover 62%;
    }
  }
  @keyframes wave-progress {
    from {
      --wave-p: 0;
    }
    to {
      --wave-p: 1;
    }
  }
  .wave-title.wt-still {
    animation: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .wave-title {
      animation: none;
      --wave-p: 1;
    }
  }
</style>
