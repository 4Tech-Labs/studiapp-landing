---
// Titular con "color wave": al hacer scroll, una ola de color recorre el texto letra por letra (tenue → color de la
// ola → color final). Va DENTRO del h2 de cada sección, que conserva sus estilos (fuente, tamaño, color).
// Las partes con accent llevan el color de acento del tema; el resto termina en el color del h2 (currentColor).
// break: true empieza esa parte en una línea nueva. El texto completo queda para lectores de pantalla en un sr-only.
interface Part {
  text: string;
  accent?: boolean;
  break?: boolean;
}
interface Props {
  parts: Part[];
  /** light: sobre fondo claro (acento en el degradado azul de marca). dark: sobre fondo oscuro (acento azul claro). */
  theme?: 'light' | 'dark';
}

const { parts, theme = 'light' } = Astro.props;

let index = 0;
const words = parts.flatMap((part, pi) =>
  part.text
    .split(' ')
    .filter(Boolean)
    .map((word, wi) => ({
      lineBreak: Boolean(part.break) && pi > 0 && wi === 0,
      chars: [...word].map((ch, k, all) => {
        const step = Math.round((k / Math.max(all.length - 1, 1)) * 100);
        const accent = theme === 'dark' ? 'var(--wt-accent)' : `color-mix(in oklab, #1a5cc0, #0144a0 ${step}%)`;
        return { ch, style: `--i:${index++};--final:${part.accent ? accent : 'currentColor'}` };
      }),
    })),
);
const total = index;
const label = parts.map((part) => part.text).join(' ');
---

<span class:list={['wave-title', `wt-${theme}`]} style={`--n:${total}`} data-wave-title>
  <span class="sr-only">{label}</span>
  <span aria-hidden="true">
    {
      words.map((word, wi) => (
        <>
          {word.lineBreak ? <br /> : wi > 0 && ' '}
          {/* Letras pegadas (sin saltos de línea entre ellas) para no meter espacios dentro de la palabra */}
          <span class="w">{word.chars.map((c) => <span class="c" style={c.style}>{c.ch}</span>)}</span>
        </>
      ))
    }
  </span>
</span>

<style>
  /* Todo depende de un solo número, --wave-p (0 → 1). Cada letra calcula su propio tramo de la ola, así se anima
     una sola variable por cuadro y no una animación por letra. */
  @property --wave-p {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }
  .wave-title {
    display: block;
    /* Ancho de la ola en letras */
    --wave-w: 6;
    --wave-p: 1;
    --wave: #4f8ff7;
  }
  .wt-light {
    --dim: hsl(232 18% 85%);
  }
  .wt-dark {
    --dim: hsl(226 22% 26%);
    --wt-accent: hsl(222 100% 88%);
  }
  .w {
    white-space: nowrap;
  }
  .c {
    --t: clamp(0, (var(--wave-p) * (var(--n) + var(--wave-w)) - var(--i)) / var(--wave-w), 1);
    color: color-mix(
      in oklab,
      color-mix(in oklab, var(--dim), var(--wave) calc(min(var(--t) * 2, 1) * 100%)),
      var(--final) calc(max(var(--t) * 2 - 1, 0) * 100%)
    );
  }
  /* Navegadores con animaciones ligadas al scroll: corre en CSS, sin JavaScript */
  @supports (animation-timeline: view()) {
    .wave-title {
      animation: wave-progress linear both;
    }
    /* En otra regla a propósito: el minificador juntaría animation-timeline dentro del shorthand `animation`,
       y Chrome descarta ese shorthand completo (el timeline no es válido ahí) */
    [data-wave-title] {
      animation-timeline: view();
      animation-range: cover 12% cover 48%;
    }
  }
  @keyframes wave-progress {
    from {
      --wave-p: 0;
    }
    to {
      --wave-p: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wave-title {
      animation: none;
      --wave-p: 1;
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  // Respaldo para navegadores sin animation-timeline: mismo rango que en CSS, calculado con un listener de scroll que
  // solo existe mientras el titular está en pantalla y escribe una variable por cuadro.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion && !CSS.supports('animation-timeline: view()')) {
    for (const title of document.querySelectorAll<HTMLElement>('[data-wave-title]')) {
      let frame = 0;
      const update = () => {
        frame = 0;
        const { top } = title.getBoundingClientRect();
        const vh = window.innerHeight;
        const start = vh * 0.92;
        const end = vh * 0.52;
        const p = Math.min(1, Math.max(0, (start - top) / (start - end)));
        title.style.setProperty('--wave-p', p.toFixed(3));
      };
      const onScroll = () => {
        if (!frame) frame = requestAnimationFrame(update);
      };
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) window.addEventListener('scroll', onScroll, { passive: true });
        else window.removeEventListener('scroll', onScroll);
        update();
      }).observe(title);
    }
  }
</script>
