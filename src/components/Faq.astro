---
import { FAQ } from '../data/site';

// Acordeón con <details> nativo: abre y cierra sin JavaScript, y la búsqueda del navegador (Ctrl+F) encuentra y abre las respuestas cerradas.

// Mismo contenido que se ve en la página, para que los buscadores lo lean como FAQPage.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<section id="preguntas-frecuentes" aria-labelledby="faq-titulo" class="faq" data-screen-label="Preguntas frecuentes">
  <div class="head">
    <p class="badge">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
      Preguntas frecuentes
    </p>
    <h2 id="faq-titulo">¿Tienes dudas?</h2>
    <p class="lead">Encuentra respuestas a las preguntas más comunes.</p>
  </div>

  <div class="list">
    {
      FAQ.map((f) => (
        <details class="item">
          <summary class="q">
            <span class="q-text">{f.question}</span>
            <span aria-hidden="true" class="icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <line x1="12" y1="5" x2="12" y2="19" class="v" />
              </svg>
            </span>
          </summary>
          <div class="a">
            <p>{f.answer}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

<style>
  .faq {
    margin-top: var(--gap);
    border-radius: var(--radius);
    background: linear-gradient(180deg, hsl(220 44% 96.5%) 0%, hsl(220 40% 98%) 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(32px, 4vw, 48px);
    padding: clamp(56px, 7vw, 96px) clamp(14px, 4vw, 48px);
    scroll-margin-top: 14px;
    /* Permite animar la altura de 0 a auto (Chrome y Edge); en el resto la respuesta aparece sin transición. */
    interpolate-size: allow-keywords;
  }
  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .badge {
    margin: 0 0 20px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 9999px;
    background: hsl(222 100% 96.5%);
    box-shadow: inset 0 0 0 1px hsl(222 80% 89%);
    color: var(--accent);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    white-space: nowrap;
  }
  h2 {
    margin: 0;
    font-family: var(--font-inter-tight);
    font-weight: 500;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .lead {
    margin: 14px 0 0;
    font-size: clamp(16px, 1.35vw, 18px);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 560px;
    text-wrap: pretty;
  }
  .list {
    width: 100%;
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .item {
    background: hsl(0 0% 100%);
    border-radius: 20px;
    box-shadow: inset 0 0 0 1px hsl(220 28% 91%);
    transition: box-shadow 0.25s ease;
  }
  .item[open] {
    box-shadow:
      inset 0 0 0 1px hsl(222 60% 85%),
      0 14px 30px -22px rgba(0, 64, 163, 0.45);
  }
  .q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 24px 22px 28px;
    border-radius: 20px;
    list-style: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: padding-bottom 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* Abierta, la respuesta queda más cerca de su pregunta que del borde de la tarjeta. */
  .item[open] .q {
    padding-bottom: 10px;
  }
  .q::-webkit-details-marker {
    display: none;
  }
  /* El anillo de foco rodea la tarjeta completa y no solo la pregunta (se nota con la respuesta abierta). */
  @supports selector(:has(a)) {
    .q:focus-visible {
      outline: none;
    }
    .item:has(> .q:focus-visible) {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }
  }
  .q-text {
    min-width: 0;
    font-size: clamp(16px, 1.45vw, 18px);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .icon {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: hsl(222 100% 96%);
    color: var(--accent);
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }
  /* Relleno con el degradado de los botones: los degradados no se animan, así que se funde con opacidad. */
  .icon::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--accent-grad);
    box-shadow: var(--accent-shadow);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .icon svg {
    position: relative;
  }
  .item[open] .icon {
    color: hsl(0 0% 100%);
  }
  .item[open] .icon::before {
    opacity: 1;
  }
  /* La línea vertical gira 90° y se superpone a la horizontal: el + pasa a −. */
  .v {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .item[open] .v {
    transform: rotate(90deg);
  }
  @media (hover: hover) {
    .item:not([open]):hover {
      box-shadow: inset 0 0 0 1px hsl(222 60% 85%);
    }
    .q:hover .icon {
      background: hsl(222 100% 93%);
    }
  }
  .item::details-content {
    block-size: 0;
    overflow-y: clip;
    transition:
      block-size 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      content-visibility 0.35s allow-discrete;
  }
  .item[open]::details-content {
    block-size: auto;
  }
  /* Derecha: ancho del icono + separación, para que la respuesta quede alineada con la pregunta. */
  .a {
    padding: 0 76px 24px 28px;
  }
  .item[open] .a {
    animation: faqAnswerIn 0.35s ease-out both;
  }
  .a p {
    margin: 0;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.65;
    color: hsl(210 10% 38%);
    text-wrap: pretty;
  }
  @keyframes faqAnswerIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 639px) {
    .q {
      gap: 14px;
      padding: 18px 16px 18px 20px;
    }
    .a {
      padding: 0 20px 20px;
    }
  }
</style>
