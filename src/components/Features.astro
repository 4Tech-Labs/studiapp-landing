---
import VideoPlayer from './VideoPlayer.astro';
import { FEATURES, FEATURES_DEFAULT_TAB } from '../data/site';

const active = Math.min(Math.max(FEATURES_DEFAULT_TAB, 0), FEATURES.length - 1);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="caracteristicas" aria-labelledby="caracteristicas-titulo" class="features" data-screen-label="Características">
  <div class="head">
    <p class="kicker">Características</p>
    <h2 id="caracteristicas-titulo">Todo lo que necesitas</h2>
  </div>

  <div class="rail" data-rail>
    <div role="tablist" aria-label="Características" class="tabs" data-tabs>
      <span aria-hidden="true" class="pill" data-pill></span>
      {
        FEATURES.map((f, i) => (
          <button
            type="button"
            role="tab"
            id={`feat-tab-${i}`}
            aria-controls={`feat-panel-${i}`}
            aria-selected={i === active ? 'true' : 'false'}
            tabindex={i === active ? 0 : -1}
            data-tab={i}
            class="tab"
          >
            {f.tab}
          </button>
        ))
      }
    </div>
  </div>

  <div class="panels" data-panels>
    {
      FEATURES.map((f, i) => (
        <div role="tabpanel" id={`feat-panel-${i}`} aria-labelledby={`feat-tab-${i}`} hidden={i !== active} class="panel">
          <div class="grid">
            <div class="media">
              <div class="media-box">
                <VideoPlayer label={f.label} webm={f.video.webm} mp4={f.video.mp4} poster={f.video.poster} />
              </div>
            </div>
            <div class="text">
              <div class="step">
                <span class="count">
                  <span aria-hidden="true">
                    <b>{pad(i + 1)}</b> / {pad(FEATURES.length)}
                  </span>
                  <span class="sr">
                    Característica {i + 1} de {FEATURES.length}
                  </span>
                </span>
                <div class="arrows">
                  <button type="button" class="arrow" data-step="-1" aria-label="Característica anterior" disabled={i === 0}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
                  </button>
                  <button type="button" class="arrow" data-step="1" aria-label="Característica siguiente" disabled={i === FEATURES.length - 1}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
                  </button>
                </div>
              </div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          </div>
          <div class="pager">
            <div class="dots" aria-hidden="true">
              {FEATURES.map((_, k) => <span class="dot" data-go={k} data-active={k === i ? '' : undefined} />)}
            </div>
            <button type="button" class="next" data-go={(i + 1) % FEATURES.length}>
              {i < FEATURES.length - 1 ? `Siguiente: ${FEATURES[i + 1].tab}` : `Volver a: ${FEATURES[0].tab}`}
              <span aria-hidden="true">{i < FEATURES.length - 1 ? '→' : '↺'}</span>
            </button>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .features {
    margin-top: var(--gap);
    border-radius: var(--radius);
    background: linear-gradient(180deg, hsl(220 44% 96.5%) 0%, hsl(220 40% 98%) 60%, hsl(0 0% 100%) 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(24px, 3vw, 36px);
    padding: clamp(56px, 7vw, 96px) clamp(20px, 4vw, 48px);
    scroll-margin-top: 14px;
  }
  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }
  .kicker {
    margin: 0 0 4px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(222 30% 48%);
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    max-width: 820px;
    text-wrap: balance;
  }
  .rail {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    background: rgba(255, 255, 255, 0.5);
    -webkit-backdrop-filter: blur(14px) saturate(1.6);
    backdrop-filter: blur(14px) saturate(1.6);
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 100px;
    padding: 4px;
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.9),
      0 8px 18px -12px rgba(0, 64, 163, 0.35);
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  .rail[data-fade-start],
  .rail[data-fade-end] {
    --fade-start: 0px;
    --fade-end: 0px;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 var(--fade-start), #000 calc(100% - var(--fade-end)), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 var(--fade-start), #000 calc(100% - var(--fade-end)), transparent 100%);
  }
  .rail[data-fade-start] {
    --fade-start: 36px;
  }
  .rail[data-fade-end] {
    --fade-end: 36px;
  }
  .tabs {
    position: relative;
    display: flex;
    width: max-content;
    align-items: center;
    gap: 4px;
  }
  .pill {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    border-radius: 100px;
    background: var(--accent-grad);
    box-shadow: var(--accent-shadow);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease; /* primera colocación: solo aparece */
  }
  .pill[data-ready] {
    opacity: 1;
  }
  .pill[data-anim] {
    transition:
      transform 0.5s cubic-bezier(0.3, 1.35, 0.35, 1),
      width 0.35s ease,
      height 0.35s ease;
  }
  .tab {
    position: relative;
    z-index: 1;
    border: none;
    border-radius: 100px;
    padding: 12px clamp(16px, 2.4vw, 24px);
    min-height: 44px;
    background: transparent;
    color: #4a5563;
    font-family: var(--font-sans);
    font-size: 14.5px;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.3s ease;
  }
  .tab[aria-selected='true'] {
    color: #fff;
  }
  .panels {
    width: 100%;
    max-width: 1200px;
    overflow: clip; /* el panel entra deslizándose: sin esto la página se ensancha un instante en celular */
    background: rgba(255, 255, 255, 0.5);
    -webkit-backdrop-filter: blur(14px) saturate(1.6);
    backdrop-filter: blur(14px) saturate(1.6);
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 32px;
    padding: 10px;
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.9),
      0 26px 54px -30px rgba(0, 64, 163, 0.35);
  }
  .grid {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 10px;
  }
  /* Al cambiar de característica el panel nuevo entra desde el lado hacia el que se avanza (data-enter lo pone el
     script) y el texto llega un instante después. Mostrar un panel oculto reinicia la animación por sí solo; el panel
     inicial no lleva data-enter y aparece quieto. */
  .panel[data-enter] .grid {
    --from: 28px;
    animation: panel-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .panel[data-enter='prev'] .grid {
    --from: -28px;
  }
  .panel[data-enter] .text > :not(.step) {
    animation: text-in 0.5s 0.06s ease both;
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateX(var(--from));
    }
  }
  @keyframes text-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel[data-enter] .grid,
    .panel[data-enter] .text > :not(.step) {
      animation: none;
    }
  }
  .media {
    flex: 1 1 52%;
    min-width: min(280px, 100%);
    order: 2; /* media a la derecha */
  }
  .media-box {
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 100%;
    border-radius: 24px;
    overflow: hidden;
    box-shadow:
      inset 0 0 0 1px rgba(0, 64, 163, 0.07),
      0 10px 26px -18px rgba(0, 64, 163, 0.28);
    display: flex;
    align-items: stretch;
    justify-content: stretch;
    background: hsl(220 24% 96%);
  }
  .text {
    flex: 1 1 300px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center; /* la tarjeta se estira a la altura del video; centrado evita el hueco inferior */
    gap: 14px;
    background: hsl(0 0% 100%);
    border-radius: 24px;
    padding: clamp(26px, 2.6vw, 38px);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.9),
      0 10px 26px -18px rgba(0, 64, 163, 0.28);
  }
  h3 {
    margin: 0;
    font-size: clamp(1.375rem, 2.1vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .text p {
    margin: 0;
    font-size: clamp(16px, 1.2vw, 17px);
    line-height: 1.6;
    color: hsl(210 10% 38%);
    text-wrap: pretty;
  }

  /* Cuando el riel no cabe (celular) casi todo queda escondido: el contador dice cuántas hay, las flechas y los puntos
     llevan a las demás y "Siguiente" nombra la que sigue. En escritorio las pestañas se ven todas y esto sobra. */
  .features:not([data-overflow]) .step,
  .features:not([data-overflow]) .pager {
    display: none;
  }
  .step {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  /* Contador de progreso: el número actual manda (azul, grande) y el total queda de referencia, en gris. */
  .count {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: hsl(220 14% 62%);
  }
  .count b {
    font-size: 20px;
    font-weight: 600;
    color: var(--accent);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .arrows {
    display: flex;
    gap: 8px;
  }
  /* Fondo azul claro y sin borde: con borde fino sobre blanco parecían apagadas. En los extremos (primera ‹, última ›)
     se atenúan de verdad; volver al inicio lo ofrece "Volver a" bajo el video. */
  .arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: hsl(218 80% 95%);
    color: var(--accent);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.15s ease;
  }
  .arrow:not(:disabled):active {
    background: hsl(218 75% 89%);
    transform: scale(0.94);
  }
  .arrow:disabled {
    background: hsl(220 20% 96%);
    color: hsl(220 14% 76%);
    cursor: default;
  }
  .pager {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 12px 0 4px;
  }
  .dots {
    display: flex;
    justify-content: center;
  }
  .dot {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 24px;
    padding: 0 4px;
    cursor: pointer;
  }
  .dot::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: hsl(220 40% 82%);
    transition:
      width 0.3s ease,
      background-color 0.3s ease;
  }
  .dot[data-active]::before {
    width: 18px;
    background: var(--accent);
  }
  .next {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 12px;
    border: none;
    background: transparent;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>('[data-tabs]');
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const pill = list?.querySelector<HTMLElement>('[data-pill]');
  const box = document.querySelector<HTMLElement>('[data-panels]');
  const section = list?.closest<HTMLElement>('section');
  if (list && rail && pill && box && section) {
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active = Math.max(0, tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true'));
    let last: { x: number; y: number; w: number; h: number } | null = null;

    // Riel con scroll horizontal (móvil): deja visible la pestaña activa.
    const reveal = (p: { x: number; w: number }, animate: boolean) => {
      if (rail.scrollWidth <= rail.clientWidth + 1) return;
      const pad = parseFloat(getComputedStyle(rail).paddingLeft) || 0;
      const cw = rail.clientWidth;
      const centered = p.x - (cw - p.w) / 2;
      const left = Math.min(Math.max(centered, p.x + p.w + pad * 2 - cw), p.x);
      rail.scrollTo({ left: Math.max(0, Math.min(left, rail.scrollWidth - cw)), behavior: animate && !reduce ? 'smooth' : 'auto' });
    };

    // Mide el botón activo y coloca la píldora. animate=true solo al cambiar de pestaña.
    const measure = (animate: boolean) => {
      const el = tabs[active];
      if (!el) return;
      const p = { x: el.offsetLeft, y: el.offsetTop, w: el.offsetWidth, h: el.offsetHeight };
      if (last && last.x === p.x && last.y === p.y && last.w === p.w && last.h === p.h) return;
      last = p;
      pill.toggleAttribute('data-anim', animate && !reduce);
      pill.style.width = `${p.w}px`;
      pill.style.height = `${p.h}px`;
      pill.style.transform = `translate(${p.x}px,${p.y}px)`;
      pill.setAttribute('data-ready', '');
      reveal(p, animate);
    };

    // dir: hacia dónde se avanza (1 adelante, -1 atrás). Sin él se deduce del orden; las flechas, "Siguiente" y el
    // deslizar lo pasan porque al dar la vuelta (de la última a la primera) el orden diría lo contrario.
    const select = (i: number, focus = false, dir = Math.sign(i - active)) => {
      if (i === active) return;
      panels[active]?.querySelector('[data-video-player]')?.dispatchEvent(new CustomEvent('player:pause'));
      panels[i]?.setAttribute('data-enter', dir < 0 ? 'prev' : 'next');
      tabs.forEach((t, k) => {
        const on = k === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = panels[k];
        if (panel) panel.hidden = !on;
      });
      active = i;
      measure(true);
      if (focus) tabs[i]?.focus();
    };

    tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));
    list.addEventListener('keydown', (e) => {
      const map: Record<string, number | 'home' | 'end'> = { ArrowRight: 1, ArrowLeft: -1, Home: 'home', End: 'end' };
      const d = map[e.key];
      if (d === undefined) return;
      e.preventDefault();
      const n = tabs.length;
      if (d === 'home' || d === 'end') select(d === 'home' ? 0 : n - 1, true);
      else select((active + d + n) % n, true, d);
    });

    // Controles del panel (contador, flechas, puntos, "Siguiente"). Si el cambio llega con el panel metido bajo el
    // menú fijo, sube hasta el riel para que la nueva característica se lea desde su título.
    const NAV_SPACE = 110;
    const go = (i: number, dir?: number) => {
      const n = tabs.length;
      select((i + n) % n, false, dir);
      if (box.getBoundingClientRect().top < NAV_SPACE) {
        window.scrollBy({ top: rail.getBoundingClientRect().top - NAV_SPACE, behavior: reduce ? 'auto' : 'smooth' });
      }
    };
    box.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-step],[data-go]');
      if (!t) return;
      const step = t.dataset.step;
      if (step) go(active + Number(step), Number(step));
      else go(Number(t.dataset.go), t.matches('.next') ? 1 : undefined);
      // La flecha tocada quedó en el panel oculto: el foco pasa a la misma flecha del nuevo, para seguir con el teclado;
      // si en el nuevo está atenuada (se llegó a un extremo), a la otra.
      if (step) {
        const same = panels[active]?.querySelector<HTMLButtonElement>(`[data-step="${step}"]`);
        const other = panels[active]?.querySelector<HTMLButtonElement>(`[data-step="${-Number(step)}"]`);
        (same && !same.disabled ? same : other)?.focus({ preventScroll: true });
      }
    });

    // Deslizar el panel con el dedo cambia de característica; no cuenta si empieza en la barra del video (adelantar) ni
    // en pantalla completa.
    let start: { x: number; y: number } | null = null;
    box.addEventListener(
      'touchstart',
      (e) => {
        const ok = e.touches.length === 1 && section.hasAttribute('data-overflow') && !document.fullscreenElement;
        start = ok && !(e.target as HTMLElement).closest('.vp-bar') ? { x: e.touches[0].clientX, y: e.touches[0].clientY } : null;
      },
      { passive: true },
    );
    box.addEventListener(
      'touchend',
      (e) => {
        if (!start) return;
        const dx = e.changedTouches[0].clientX - start.x;
        const dy = e.changedTouches[0].clientY - start.y;
        start = null;
        const next = active + (dx < 0 ? 1 : -1);
        // Igual que las flechas, no da la vuelta: en los extremos el gesto no hace nada.
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5 && next >= 0 && next < tabs.length) go(next, dx < 0 ? 1 : -1);
      },
      { passive: true },
    );

    // Desvanecido en el borde por el que quedan pestañas ocultas: indica que el riel se desliza. Si el riel no cabe,
    // la sección muestra además los controles del panel.
    const fades = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      section.toggleAttribute('data-overflow', max > 1);
      rail.toggleAttribute('data-fade-start', max > 1 && rail.scrollLeft > 1);
      rail.toggleAttribute('data-fade-end', max > 1 && rail.scrollLeft < max - 1);
    };
    rail.addEventListener('scroll', fades, { passive: true });

    new ResizeObserver(() => {
      measure(false);
      fades();
    }).observe(list);
    new ResizeObserver(fades).observe(rail);
    document.fonts?.ready.then(() => {
      measure(false);
      fades();
    });
    measure(false);
    fades();
  }
</script>
