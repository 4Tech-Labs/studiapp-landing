---
import { Image } from 'astro:assets';
import { SITE, TEAM } from '../data/site';

// Tarjetas de retrato: foto, nombre y cargo; al pasar el mouse, enfocar o tocar la tarjeta aparece la biografía sobre una cuadrícula azul.
// Con más tarjetas de las que caben, el riel hace scroll con flechas; con pocas, se centran sin controles.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/team/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const photoOf = (file?: string) => (file ? photos[`../assets/team/${file}`]?.default : undefined);

// Nombre y primer apellido: con dos apellidos (3 o más palabras) el primero es la penúltima palabra.
const initials = (name: string) => {
  const w = name.split(' ');
  return w[0][0] + (w.length >= 3 ? w[w.length - 2][0] : w.length === 2 ? w[1][0] : '');
};
---

{
  TEAM.length > 0 && (
    <section id="equipo" aria-labelledby="equipo-titulo" class="team" data-screen-label="Equipo" data-team>
      <div aria-hidden="true" class="glow" />
      <div aria-hidden="true" class="ring" />

      <div class="head">
        <p class="kicker">Equipo</p>
        <h2 id="equipo-titulo">
          Las personas <span class="serif">que construyen {SITE.name}</span>
        </h2>
      </div>

      <div class="viewport">
        <button type="button" class="arrow prev" aria-label="Anterior" data-team-prev>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
        </button>

        <ul class="rail" data-team-rail>
          {TEAM.map((m) => {
            const photo = photoOf(m.photo);
            const hasBack = Boolean(m.bio || m.linkedin);
            return (
              <li class="card" tabindex={hasBack ? 0 : undefined} data-team-card={hasBack ? '' : undefined}>
                <div class="front">
                  {photo ? (
                    <Image src={photo} alt={m.name} width={Math.min(photo.width, 640)} class="photo" />
                  ) : (
                    <span class="monogram" aria-hidden="true">{initials(m.name)}</span>
                  )}
                  <div class="caption">
                    <h3 class="name">{m.name}</h3>
                    <p class="role">{m.role}</p>
                  </div>
                </div>
                {hasBack && (
                  <div class="back">
                    <div>
                      <p class="name" aria-hidden="true">{m.name}</p>
                      <p class="role" aria-hidden="true">{m.role}</p>
                    </div>
                    <div class="back-foot">
                      {m.bio && <p class="bio">{m.bio}</p>}
                      {m.linkedin && (
                        <a href={m.linkedin} target="_blank" rel="noopener" class="in">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
                            <rect x="2" y="9" width="4" height="12" />
                            <circle cx="4" cy="4" r="2" />
                          </svg>
                          Ver perfil en LinkedIn<span class="sr-only"> de {m.name}</span>
                        </a>
                      )}
                    </div>
                  </div>
                )}
              </li>
            );
          })}
        </ul>

        <button type="button" class="arrow next" aria-label="Siguiente" data-team-next>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
        </button>
      </div>
    </section>
  )
}

<style>
  .team {
    position: relative;
    overflow: hidden;
    margin-top: var(--gap);
    border-radius: var(--radius);
    background: hsl(234 48% 6%);
    color: hsl(0 0% 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(36px, 4.5vw, 56px);
    padding: clamp(64px, 7vw, 104px) 0 clamp(48px, 5vw, 72px);
    scroll-margin-top: 14px;
  }
  .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 45% 55% at 50% 62%, hsl(232 80% 45% / 0.38) 0%, transparent 70%),
      radial-gradient(ellipse 60% 40% at 50% 0%, hsl(240 70% 30% / 0.35) 0%, transparent 75%);
  }
  /* Círculo decorativo de la referencia: abraza el título y se pierde detrás de las tarjetas. */
  .ring {
    position: absolute;
    top: clamp(24px, 3vw, 40px);
    left: 50%;
    width: clamp(340px, 36vw, 480px);
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 9999px;
    border: 1px solid hsl(230 70% 75% / 0.16);
    pointer-events: none;
    /* Se desvanece antes de llegar a las tarjetas: entre ellas solo asomaría un trazo suelto. */
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 45%, transparent 62%);
    mask-image: linear-gradient(180deg, #000 0%, #000 45%, transparent 62%);
  }
  .head {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 clamp(20px, 4vw, 48px);
  }
  .kicker {
    margin: 0 0 16px;
    font-family: var(--font-inter);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: hsl(230 30% 75%);
  }
  h2 {
    margin: 0;
    font-family: var(--font-inter-tight);
    font-weight: 500;
    font-size: clamp(2.125rem, 4.6vw, 3.75rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .serif {
    display: block;
    font-family: var(--font-instrument-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    color: hsl(235 90% 78%);
  }

  .viewport {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }
  .rail {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 4px clamp(20px, 6vw, 96px);
    list-style: none;
    display: flex;
    gap: clamp(14px, 1.6vw, 20px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 clamp(20px, 6vw, 96px);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  /* Centradas cuando caben; si no caben, los márgenes automáticos se anulan y el riel arranca desde el borde. */
  .card:first-child {
    margin-left: auto;
  }
  .card:last-child {
    margin-right: auto;
  }

  .card {
    position: relative;
    flex: none;
    width: clamp(232px, 21vw, 290px);
    aspect-ratio: 290 / 400;
    border-radius: 22px;
    overflow: hidden;
    scroll-snap-align: start;
    background:
      radial-gradient(ellipse 80% 55% at 50% 42%, hsl(232 85% 52% / 0.55) 0%, transparent 72%),
      linear-gradient(180deg, hsl(236 50% 14%) 0%, hsl(234 55% 9%) 100%);
    box-shadow:
      inset 0 0 0 1px hsl(230 60% 70% / 0.12),
      0 24px 50px -30px hsl(232 90% 40% / 0.7);
    outline-offset: 4px;
  }
  .front,
  .back {
    position: absolute;
    inset: 0;
  }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }
  .monogram {
    position: absolute;
    inset: 0 0 22%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-instrument-serif);
    font-style: italic;
    font-size: clamp(88px, 9vw, 120px);
    line-height: 1;
    color: hsl(235 90% 86% / 0.9);
  }
  .caption {
    position: absolute;
    inset: auto 0 0;
    padding: 64px 20px 20px;
    background: linear-gradient(180deg, transparent 0%, hsl(234 55% 8% / 0.75) 45%, hsl(234 55% 8% / 0.95) 100%);
  }
  .name {
    margin: 0;
    font-family: var(--font-inter-tight);
    font-size: clamp(18px, 1.6vw, 21px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: hsl(0 0% 100%);
  }
  .role {
    margin: 4px 0 0;
    font-size: 12px;
    line-height: 1.4;
    color: hsl(235 90% 78%);
  }

  /* Reverso: cuadrícula azul de la referencia, con nombre arriba y biografía abajo. */
  .back {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px 20px 20px;
    background-color: hsl(236 70% 32%);
    background-image:
      linear-gradient(hsl(0 0% 100% / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, hsl(0 0% 100% / 0.07) 1px, transparent 1px),
      radial-gradient(ellipse 90% 60% at 50% 0%, hsl(232 90% 55% / 0.6) 0%, transparent 70%);
    background-size:
      28px 28px,
      28px 28px,
      100% 100%;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s;
  }
  .back-foot {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .bio {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: hsl(230 60% 92%);
    text-wrap: pretty;
  }
  .in {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 9999px;
    background: hsl(0 0% 100% / 0.12);
    box-shadow: inset 0 0 0 1px hsl(0 0% 100% / 0.22);
    color: hsl(0 0% 100%);
    font-size: 13px;
    font-weight: 500;
    transition: background-color 0.2s ease;
  }
  .in:hover {
    color: hsl(0 0% 100%);
    background: hsl(0 0% 100% / 0.2);
  }
  @media (hover: hover) {
    .card:hover .back {
      opacity: 1;
      visibility: visible;
    }
  }
  .card:focus-within .back,
  .card[data-open] .back {
    opacity: 1;
    visibility: visible;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Flechas: solo cuando hay más tarjetas de las que caben (data-overflow lo pone el script). */
  .arrow {
    position: absolute;
    top: 50%;
    z-index: 1;
    width: 40px;
    height: 40px;
    margin-top: -20px;
    border: 0;
    border-radius: 9999px;
    display: none;
    align-items: center;
    justify-content: center;
    background: hsl(234 40% 14% / 0.85);
    box-shadow: inset 0 0 0 1px hsl(230 60% 80% / 0.22);
    color: hsl(0 0% 100%);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      opacity 0.2s ease;
  }
  .arrow:hover {
    background: hsl(234 40% 22%);
  }
  .arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .prev {
    left: clamp(8px, 2vw, 32px);
  }
  .next {
    right: clamp(8px, 2vw, 32px);
  }
  @media (hover: hover) and (pointer: fine) {
    .team[data-overflow] .arrow {
      display: inline-flex;
    }
  }
</style>

<script>
  for (const section of document.querySelectorAll<HTMLElement>('[data-team]')) {
    const rail = section.querySelector<HTMLElement>('[data-team-rail]')!;
    const prev = section.querySelector<HTMLButtonElement>('[data-team-prev]')!;
    const next = section.querySelector<HTMLButtonElement>('[data-team-next]')!;

    const update = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      section.toggleAttribute('data-overflow', max > 1);
      if (max <= 1) return;
      prev.disabled = rail.scrollLeft <= 1;
      next.disabled = rail.scrollLeft >= max - 1;
    };
    const step = () => {
      const card = rail.querySelector<HTMLElement>('.card');
      return card ? card.offsetWidth + parseFloat(getComputedStyle(rail).columnGap || '0') : rail.clientWidth;
    };
    prev.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));
    rail.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(rail);

    // En pantallas táctiles no hay hover: un toque muestra la biografía y otro la oculta (los enlaces del reverso siguen funcionando).
    for (const card of rail.querySelectorAll<HTMLElement>('[data-team-card]')) {
      card.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) return;
        if (matchMedia('(hover: hover)').matches) return;
        const open = !card.hasAttribute('data-open');
        rail.querySelectorAll('[data-open]').forEach((c) => c.removeAttribute('data-open'));
        card.toggleAttribute('data-open', open);
      });
    }
  }
</script>
