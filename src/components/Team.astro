---
import { Image } from 'astro:assets';
import { SITE, TEAM } from '../data/site';
import LightRays from './LightRays.astro';
import WaveTitle from './WaveTitle.astro';

// Tarjetas de retrato: foto, nombre y cargo. Al pasar el mouse, enfocar con teclado o tocar la tarjeta, el reverso
// (cuadrícula azul con el enlace a LinkedIn) sube desde abajo. Las tarjetas entran escalonadas al llegar a la sección.
// Con más tarjetas de las que caben, el riel hace scroll con flechas; con pocas, se centran sin controles.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/team/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const photoOf = (file?: string) => (file ? photos[`../assets/team/${file}`]?.default : undefined);

// Nombre y primer apellido: con 4 o más palabras (dos nombres y dos apellidos) el primer apellido es la penúltima;
// con menos, la última ("Juan Camilo Dorado" → JD, "Josue Ruano" → JR).
const initials = (name: string) => {
  const w = name.split(' ');
  if (w.length < 2) return w[0][0];
  return w[0][0] + w[w.length >= 4 ? w.length - 2 : w.length - 1][0];
};
// Ancho máximo de la tarjeta en CSS px: las fotos se generan a 1× y 2× de ese ancho (sin pasar del original).
const CARD_W = 236;
// Giro inicial del arco 3D por posición en la lista (-0.7 a 0.7); el script lo recalcula con la posición real en el riel.
const tiltOf = (i: number) => (TEAM.length > 1 ? ((i - (TEAM.length - 1) / 2) / ((TEAM.length - 1) / 2)) * 0.7 : 0);
---

{
  TEAM.length > 0 && (
    <section id="equipo" aria-labelledby="equipo-titulo" class="team" data-screen-label="Equipo" data-team>
      <div aria-hidden="true" class="glow" />
      <div aria-hidden="true" class="rays">
        <LightRays raysColor="#0144a0" lightSpread={0.5} rayLength={3} glow={0.6} haze={0.25} mouseInfluence={0.1} />
      </div>

      {/* Sin título grande: el arco de tarjetas es el protagonista; el kicker es el encabezado de la sección. */}
      <div class="head" data-reveal style="--i:0">
        <h2 id="equipo-titulo" class="kicker">
          <WaveTitle parts={[{ text: 'Equipo' }]} theme="dark" /><span class="sr-only"> de {SITE.name}</span>
        </h2>
      </div>

      <div class="viewport">
        <button type="button" class="arrow prev" aria-label="Anterior" data-team-prev>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
        </button>

        <ul class="rail" data-team-rail>
          {TEAM.map((m, i) => {
            const photo = photoOf(m.photo);
            const hasBack = Boolean(m.bio || m.linkedin);
            return (
              <li class="card" style={`--i:${i + 1};--t:${tiltOf(i).toFixed(3)}`} data-reveal tabindex={hasBack ? 0 : undefined} data-team-card={hasBack ? '' : undefined}>
                <div class="front">
                  {photo ? (
                    <Image
                      src={photo}
                      alt={m.name}
                      widths={[...new Set([Math.min(CARD_W, photo.width), Math.min(CARD_W * 2, photo.width)])]}
                      sizes={`${CARD_W}px`}
                      class="photo"
                    />
                  ) : (
                    <span class="monogram" aria-hidden="true">
                      <span>{initials(m.name)}</span>
                    </span>
                  )}
                  <div class="caption">
                    <h3 class="name">{m.name}</h3>
                    <p class="role">{m.role}</p>
                  </div>
                </div>
                {hasBack && (
                  <div class="back">
                    <div class="back-top">
                      <p class="name" aria-hidden="true">{m.name}</p>
                      <p class="role" aria-hidden="true">{m.role}</p>
                    </div>
                    <div class="back-foot">
                      {m.bio && <p class="bio">{m.bio}</p>}
                      {m.linkedin && (
                        <a href={m.linkedin} target="_blank" rel="noopener" class="in" data-team-link>
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
                            <rect x="2" y="9" width="4" height="12" />
                            <circle cx="4" cy="4" r="2" />
                          </svg>
                          LinkedIn<span class="sr-only"> de {m.name}</span>
                        </a>
                      )}
                    </div>
                  </div>
                )}
                <span aria-hidden="true" class="glare" />
              </li>
            );
          })}
        </ul>

        <button type="button" class="arrow next" aria-label="Siguiente" data-team-next>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
        </button>
      </div>
    </section>
  )
}

<style>
  /* overflow: clip y no hidden: hidden vuelve la sección un contenedor de scroll y la ola del título (WaveTitle)
     seguiría el scroll de la sección, que nunca se mueve, en vez del de la página */
  .team {
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --arc: 50deg; /* giro máximo de las tarjetas en los bordes del riel */
    position: relative;
    overflow: clip;
    margin-top: var(--gap);
    border-radius: var(--radius);
    background: hsl(234 48% 6%);
    color: hsl(0 0% 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(40px, 5vw, 64px);
    padding: clamp(64px, 7vw, 104px) 0 clamp(56px, 6vw, 88px);
    scroll-margin-top: 14px;
  }
  /* Safari < 16 no conoce overflow: clip (tampoco las animaciones ligadas al scroll: ahí la ola va por JavaScript) */
  @supports not (overflow: clip) {
    .team {
      overflow: hidden;
    }
  }
  .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 45% 55% at 50% 62%, hsl(232 80% 45% / 0.38) 0%, transparent 70%),
      radial-gradient(ellipse 60% 40% at 50% 0%, hsl(240 70% 30% / 0.35) 0%, transparent 75%);
  }
  /* Haces de luz desde arriba (WebGL2); sin WebGL2 queda solo el brillo de .glow. */
  .rays {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .head {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 clamp(20px, 4vw, 48px);
  }
  /* Único texto sobre las tarjetas: tamaño medio para que el haz de luz ilumine algo con peso. Va en la tipografía
     de titulares (no la de los rótulos pequeños) porque hace de título de la sección. */
  .kicker {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(15px, 1.4vw, 20px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(230 60% 90%);
  }

  /* Entrada escalonada (solo con JS; sin JS o con movimiento reducido se ve todo de inmediato).
     Usa translate y scale sueltos para no pisar el transform del arco 3D; el giro de las tarjetas no lleva retraso. */
  .team[data-reveal-state='pending'] [data-reveal] {
    opacity: 0;
    translate: 0 28px;
    scale: 0.97;
  }
  .team[data-reveal-state='in'] [data-reveal] {
    opacity: 1;
    translate: none;
    scale: none;
    transition:
      opacity 0.7s var(--ease-out),
      translate 0.9s var(--ease-out),
      scale 0.9s var(--ease-out),
      transform 0.6s var(--ease-out);
    transition-delay: calc(var(--i, 0) * 90ms), calc(var(--i, 0) * 90ms), calc(var(--i, 0) * 90ms), 0s;
  }

  .viewport {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }
  .rail {
    position: relative;
    flex: 1;
    min-width: 0;
    margin: 0;
    /* Arriba y abajo hay aire para el borde cercano de las tarjetas giradas, que la perspectiva hace más alto. */
    padding: 24px clamp(20px, 6vw, 96px) 36px;
    list-style: none;
    display: flex;
    gap: clamp(14px, 1.6vw, 22px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 clamp(20px, 6vw, 96px);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  /* Centradas cuando caben; si no caben, los márgenes automáticos se anulan y el riel arranca desde el borde. */
  .card:first-child {
    margin-left: auto;
  }
  .card:last-child {
    margin-right: auto;
  }

  .card {
    position: relative;
    flex: none;
    width: clamp(200px, 17vw, 236px);
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
    scroll-snap-align: start;
    isolation: isolate;
    background:
      radial-gradient(ellipse 80% 60% at 50% 38%, hsl(232 85% 52% / 0.5) 0%, transparent 72%),
      linear-gradient(180deg, hsl(236 50% 14%) 0%, hsl(234 55% 9%) 100%);
    box-shadow:
      inset 0 0 0 1px hsl(230 60% 70% / 0.12),
      0 24px 50px -30px hsl(232 90% 40% / 0.7);
    outline-offset: 4px;
    cursor: default;
    /* Arco cóncavo: --t va de -1 (borde izquierdo del riel) a 1 (derecho); el borde exterior de cada tarjeta gira
       hacia el frente. Las tarjetas van sobre un cilindro de radio --r (lo calcula el script): cuanto más giran, más
       se adelantan, y así el borde de cada una queda a la misma altura que el de su vecina. Abierta, la tarjeta se
       endereza y vuelve casi al plano del riel (con la profundidad del cilindro, las de los extremos crecían hasta
       tocar a su vecina) y, con mouse, se inclina hacia el cursor (--rx, --ry; los pone el script). */
    --z: calc(var(--r, 600px) * (1 - cos(var(--t, 0) * var(--arc))));
    transform: perspective(900px) translateZ(var(--z)) rotateX(0deg) rotateY(calc(var(--t, 0) * var(--arc) * -1));
    transition: transform 0.6s var(--ease-out);
  }
  /* Ya enderezada, la inclinación sigue al cursor con una transición corta (la larga iría detrás del mouse). */
  .team .rail .card[data-tracking] {
    transition: transform 0.18s ease-out;
  }
  /* Mientras el riel se desliza, el giro sigue la posición sin transición (si no, va detrás del dedo). */
  .team[data-scrolling] .rail .card {
    transition: none;
  }
  /* Borde luminoso que aparece con el reverso. */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px hsl(230 90% 80% / 0.45);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .front,
  .back {
    position: absolute;
    inset: 0;
  }
  /* La foto escala al pasar el mouse y pasa a su propia capa: el overflow redondeado de la tarjeta deja de recortarla
     y asoman sus esquinas cuadradas. Un clip-path redondeado en el frente la recorta siempre. */
  .front {
    border-radius: inherit;
    overflow: hidden;
    clip-path: inset(0 round 20px);
  }
  /* Sombra de profundidad: oscurece el borde lejano (el interior del arco) según cuánto gira la tarjeta. */
  .front::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent 30%, hsl(234 60% 4% / calc(max(0, var(--t, 0) * -1) * 0.7))),
      linear-gradient(270deg, transparent 30%, hsl(234 60% 4% / calc(max(0, var(--t, 0)) * 0.7)));
    transition: opacity 0.5s ease;
  }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    transition:
      transform 0.8s var(--ease-out),
      filter 0.5s ease;
  }
  /* Sin foto: iniciales en un círculo con anillo, sobre el brillo de la tarjeta. */
  .monogram {
    position: absolute;
    inset: 0 0 26%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .monogram span {
    width: 52%;
    aspect-ratio: 1;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: clamp(44px, 4.2vw, 58px);
    line-height: 1;
    color: hsl(235 90% 88%);
    background: radial-gradient(circle at 30% 25%, hsl(232 80% 40% / 0.9) 0%, hsl(236 60% 18%) 75%);
    box-shadow:
      inset 0 0 0 1px hsl(230 80% 80% / 0.25),
      0 0 0 8px hsl(232 80% 60% / 0.08);
  }
  .caption {
    position: absolute;
    inset: auto 0 0;
    padding: 56px 16px 16px;
    background: linear-gradient(180deg, transparent 0%, hsl(234 55% 8% / 0.78) 48%, hsl(234 55% 8% / 0.96) 100%);
    transition:
      opacity 0.35s ease,
      transform 0.5s var(--ease-out);
  }
  .name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(16px, 1.35vw, 18px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: hsl(0 0% 100%);
  }
  .role {
    margin: 4px 0 0;
    font-size: 12px;
    line-height: 1.4;
    color: hsl(235 90% 80%);
  }

  /* Reverso: cuadrícula azul que sube desde abajo; su contenido entra escalonado. */
  .back {
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 18px 16px 16px;
    border-radius: inherit;
    background-color: hsl(236 70% 30% / 0.94);
    background-image:
      linear-gradient(hsl(0 0% 100% / 0.08) 1px, transparent 1px),
      linear-gradient(90deg, hsl(0 0% 100% / 0.08) 1px, transparent 1px),
      radial-gradient(ellipse 90% 60% at 50% 0%, hsl(232 90% 58% / 0.65) 0%, transparent 70%);
    background-size:
      24px 24px,
      24px 24px,
      100% 100%;
    /* Paralaje: la cuadrícula se corre al revés que el contenido cuando la tarjeta se inclina (--sx, --sy). */
    background-position:
      calc(var(--sx, 0px) * -1) calc(var(--sy, 0px) * -1),
      calc(var(--sx, 0px) * -1) calc(var(--sy, 0px) * -1),
      center;
    /* Sin backdrop-filter: Chrome lo pinta en el rectángulo completo e ignora el redondeado del clip-path (esquinas cuadradas). */
    clip-path: inset(100% 0 0 0 round 20px);
    visibility: hidden;
    transition:
      clip-path 0.55s var(--ease-out),
      visibility 0s linear 0.55s;
  }
  .back-top,
  .back-foot {
    opacity: 0;
    transform: translateY(12px);
    translate: var(--sx, 0px) var(--sy, 0px);
    transition:
      opacity 0.3s ease,
      transform 0.45s var(--ease-out),
      translate 0.25s ease-out;
  }
  .back-foot {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .bio {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: hsl(230 60% 92%);
    text-wrap: pretty;
  }
  .in {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 18px;
    border-radius: 9999px;
    background: hsl(0 0% 100% / 0.14);
    box-shadow: inset 0 0 0 1px hsl(0 0% 100% / 0.25);
    color: hsl(0 0% 100%);
    font-size: 13px;
    font-weight: 500;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }
  .in:hover {
    color: hsl(0 0% 100%);
    background: hsl(0 0% 100% / 0.24);
    transform: translateY(-1px);
  }

  /* Estado abierto: hover (con mouse), foco de teclado visible dentro de la tarjeta, o toque (data-open).
     Solo :focus-visible, no :focus-within: tras hacer clic en LinkedIn y volver, el enlace sigue enfocado y la tarjeta quedaba abierta. */
  /* Brillo que sigue al cursor (--gx, --gy), por encima del frente y del reverso. */
  .glare {
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(
      farthest-corner circle at var(--gx, 50%) var(--gy, 50%),
      hsl(0 0% 100% / 0.55) 0%,
      hsl(0 0% 100% / 0.18) 22%,
      transparent 60%
    );
    mix-blend-mode: overlay;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  @media (hover: hover) {
    .card:hover {
      transform: perspective(900px) translateZ(16px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    }
    .card[data-tracking] .glare {
      opacity: 1;
    }
    .card:hover .front::after {
      opacity: 0;
    }
    .card:hover .back {
      clip-path: inset(0 0 0 0 round 20px);
      visibility: visible;
      transition: clip-path 0.55s var(--ease-out);
    }
    .card:hover .back-top,
    .card:hover .back-foot {
      opacity: 1;
      transform: none;
    }
    .card:hover .back-top {
      transition-delay: 0.12s;
    }
    .card:hover .back-foot {
      transition-delay: 0.2s;
    }
    .card:hover .photo {
      transform: scale(1.06);
      filter: saturate(0.85) brightness(0.8);
    }
    .card:hover .caption {
      opacity: 0;
      transform: translateY(8px);
    }
    .card:hover::after {
      opacity: 1;
    }
  }
  /* :has() va dentro de :is(), que perdona selectores desconocidos: en un navegador sin :has() una lista normal
     descartaría la regla completa y la tarjeta tampoco se abriría con el foco ni con el toque (data-open). */
  .card:is(:focus-visible, :has(:focus-visible), [data-open]) {
    transform: perspective(900px) translateZ(16px) rotateX(0deg) rotateY(0deg);
  }
  .card:is(:focus-visible, :has(:focus-visible), [data-open]) .front::after {
    opacity: 0;
  }
  .card:is(:focus-visible, :has(:focus-visible), [data-open]) .back {
    clip-path: inset(0 0 0 0 round 20px);
    visibility: visible;
    transition: clip-path 0.55s var(--ease-out);
  }
  .card:is(:focus-visible, :has(:focus-visible), [data-open]) :is(.back-top, .back-foot) {
    opacity: 1;
    transform: none;
  }
  .card:is(:focus-visible, :has(:focus-visible), [data-open]) .caption {
    opacity: 0;
  }
  .card:is(:focus-visible, :has(:focus-visible), [data-open])::after {
    opacity: 1;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Flechas: solo cuando hay más tarjetas de las que caben (data-overflow lo pone el script). */
  .arrow {
    position: absolute;
    top: 50%;
    z-index: 4;
    width: 40px;
    height: 40px;
    margin-top: -20px;
    border: 0;
    border-radius: 9999px;
    display: none;
    align-items: center;
    justify-content: center;
    background: hsl(234 40% 14% / 0.85);
    box-shadow: inset 0 0 0 1px hsl(230 60% 80% / 0.22);
    color: hsl(0 0% 100%);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      opacity 0.2s ease;
  }
  .arrow:hover {
    background: hsl(234 40% 22%);
  }
  .arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .prev {
    left: clamp(8px, 2vw, 32px);
  }
  .next {
    right: clamp(8px, 2vw, 32px);
  }
  @media (hover: hover) and (pointer: fine) {
    .team[data-overflow] .arrow {
      display: inline-flex;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
    .card:hover .photo {
      transform: none;
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const section of document.querySelectorAll<HTMLElement>('[data-team]')) {
    const rail = section.querySelector<HTMLElement>('[data-team-rail]')!;
    const prev = section.querySelector<HTMLButtonElement>('[data-team-prev]')!;
    const next = section.querySelector<HTMLButtonElement>('[data-team-next]')!;

    // Entrada escalonada al llegar a la sección (una sola vez).
    if (!reduce && 'IntersectionObserver' in window) {
      const r = section.getBoundingClientRect();
      if (r.top > innerHeight * 0.85) {
        section.dataset.revealState = 'pending';
        const io = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return;
            section.dataset.revealState = 'in';
            io.disconnect();
          },
          { threshold: 0.2 },
        );
        io.observe(section);
      }
    }

    const update = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      section.toggleAttribute('data-overflow', max > 1);
      if (max <= 1) return;
      prev.disabled = rail.scrollLeft <= 1;
      next.disabled = rail.scrollLeft >= max - 1;
    };
    const step = () => {
      const card = rail.querySelector<HTMLElement>('.card');
      return card ? card.offsetWidth + parseFloat(getComputedStyle(rail).columnGap || '0') : rail.clientWidth;
    };
    // Arco 3D: --t de cada tarjeta según dónde queda su centro respecto al centro visible del riel (-1 a 1).
    const cards = [...rail.querySelectorAll<HTMLElement>('.card')];
    // Radio del cilindro: la cuerda entre centros vecinos (ancho + gap) abarca el ángulo que cambia el giro entre ellos.
    // Primero se leen todas las medidas y después se escriben las variables: intercalar lecturas y escrituras
    // obligaría al navegador a recalcular estilos una vez por tarjeta en cada cuadro del scroll.
    const tilt = () => {
      const half = rail.clientWidth / 2;
      const arc = (parseFloat(getComputedStyle(section).getPropertyValue('--arc')) * Math.PI) / 180;
      const pitch = step();
      const angle = (arc * pitch) / half;
      const scroll = rail.scrollLeft;
      const tilts = cards.map((card) => {
        const center = card.offsetLeft + card.offsetWidth / 2 - scroll;
        return [card, Math.max(-1, Math.min(1, (center - half) / half))] as const;
      });
      rail.style.setProperty('--r', `${(pitch / (2 * Math.sin(angle / 2))).toFixed(0)}px`);
      for (const [card, t] of tilts) card.style.setProperty('--t', t.toFixed(3));
    };
    let frame = 0;
    const schedule = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        update();
        tilt();
      });
    };
    let idle = 0;
    prev.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));
    rail.addEventListener(
      'scroll',
      () => {
        section.toggleAttribute('data-scrolling', true);
        clearTimeout(idle);
        idle = window.setTimeout(() => section.removeAttribute('data-scrolling'), 120);
        schedule();
      },
      { passive: true },
    );
    tilt();
    new ResizeObserver(schedule).observe(rail);

    // Con mouse, la tarjeta abierta se inclina hacia el cursor (hasta TILT grados), el brillo lo sigue y el reverso
    // hace paralaje. El seguimiento empieza cuando termina de enderezarse (data-tracking), para no cortar esa transición.
    const TILT = 8;
    const PARALLAX = 5;
    if (!reduce) {
      for (const card of cards) {
        let settle = 0;
        const aim = (e: PointerEvent) => {
          const r = card.getBoundingClientRect();
          if (!r.width || !r.height) return;
          const nx = Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width) * 2 - 1));
          const ny = Math.max(-1, Math.min(1, ((e.clientY - r.top) / r.height) * 2 - 1));
          card.style.setProperty('--rx', `${(ny * TILT).toFixed(2)}deg`);
          card.style.setProperty('--ry', `${(-nx * TILT).toFixed(2)}deg`);
          card.style.setProperty('--gx', `${((nx + 1) * 50).toFixed(1)}%`);
          card.style.setProperty('--gy', `${((ny + 1) * 50).toFixed(1)}%`);
          card.style.setProperty('--sx', `${(nx * PARALLAX).toFixed(1)}px`);
          card.style.setProperty('--sy', `${(ny * PARALLAX).toFixed(1)}px`);
        };
        card.addEventListener('pointerenter', (e) => {
          if (e.pointerType !== 'mouse') return;
          aim(e);
          settle = window.setTimeout(() => card.toggleAttribute('data-tracking', true), 600);
        });
        card.addEventListener('pointermove', (e) => {
          if (e.pointerType === 'mouse') aim(e);
        });
        card.addEventListener('pointerleave', (e) => {
          if (e.pointerType !== 'mouse') return;
          clearTimeout(settle);
          card.removeAttribute('data-tracking');
          for (const p of ['--rx', '--ry', '--sx', '--sy']) card.style.removeProperty(p);
        });
      }
    }

    const closeAll = () => rail.querySelectorAll('[data-open]').forEach((c) => c.removeAttribute('data-open'));

    // En pantallas táctiles no hay hover: un toque muestra el reverso y otro lo oculta.
    for (const card of rail.querySelectorAll<HTMLElement>('[data-team-card]')) {
      card.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) return;
        if (matchMedia('(hover: hover)').matches) return;
        const open = !card.hasAttribute('data-open');
        closeAll();
        card.toggleAttribute('data-open', open);
      });
    }

    // Al abrir LinkedIn (pestaña nueva) la tarjeta se cierra y el enlace pierde el foco si se usó el mouse o el dedo,
    // para que al volver no quede el reverso trabado.
    for (const link of rail.querySelectorAll<HTMLAnchorElement>('[data-team-link]')) {
      link.addEventListener('click', (e) => {
        closeAll();
        if (e.detail > 0) requestAnimationFrame(() => link.blur());
      });
    }
    // Un toque fuera de las tarjetas cierra la que esté abierta.
    document.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('[data-team-card]')) closeAll();
    });
  }
</script>
