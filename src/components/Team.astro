---
import { Image } from 'astro:assets';
import { SITE, TEAM } from '../data/site';

// Tarjetas de retrato: foto, nombre y cargo. Al pasar el mouse, enfocar con teclado o tocar la tarjeta, el reverso
// (cuadrícula azul con el enlace a LinkedIn) sube desde abajo. Las tarjetas entran escalonadas al llegar a la sección.
// Con más tarjetas de las que caben, el riel hace scroll con flechas; con pocas, se centran sin controles.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/team/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const photoOf = (file?: string) => (file ? photos[`../assets/team/${file}`]?.default : undefined);

// Nombre y primer apellido: con 4 o más palabras (dos nombres y dos apellidos) el primer apellido es la penúltima;
// con menos, la última ("Juan Camilo Dorado" → JD, "Josue Ruano" → JR).
const initials = (name: string) => {
  const w = name.split(' ');
  if (w.length < 2) return w[0][0];
  return w[0][0] + w[w.length >= 4 ? w.length - 2 : w.length - 1][0];
};
// Ancho máximo de la tarjeta en CSS px: las fotos se generan a 1× y 2× de ese ancho (sin pasar del original).
const CARD_W = 236;
---

{
  TEAM.length > 0 && (
    <section id="equipo" aria-labelledby="equipo-titulo" class="team" data-screen-label="Equipo" data-team>
      <div aria-hidden="true" class="glow" />
      <div aria-hidden="true" class="ring" />

      <div class="head" data-reveal style="--i:0">
        <p class="kicker">Equipo</p>
        <h2 id="equipo-titulo">
          Las personas <span class="serif">que construyen {SITE.name}</span>
        </h2>
      </div>

      <div class="viewport">
        <button type="button" class="arrow prev" aria-label="Anterior" data-team-prev>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
        </button>

        <ul class="rail" data-team-rail>
          {TEAM.map((m, i) => {
            const photo = photoOf(m.photo);
            const hasBack = Boolean(m.bio || m.linkedin);
            return (
              <li class="card" style={`--i:${i + 1}`} data-reveal tabindex={hasBack ? 0 : undefined} data-team-card={hasBack ? '' : undefined}>
                <div class="front">
                  {photo ? (
                    <Image
                      src={photo}
                      alt={m.name}
                      widths={[...new Set([Math.min(CARD_W, photo.width), Math.min(CARD_W * 2, photo.width)])]}
                      sizes={`${CARD_W}px`}
                      class="photo"
                    />
                  ) : (
                    <span class="monogram" aria-hidden="true">
                      <span>{initials(m.name)}</span>
                    </span>
                  )}
                  <div class="caption">
                    <h3 class="name">{m.name}</h3>
                    <p class="role">{m.role}</p>
                  </div>
                </div>
                {hasBack && (
                  <div class="back">
                    <div class="back-top">
                      <p class="name" aria-hidden="true">{m.name}</p>
                      <p class="role" aria-hidden="true">{m.role}</p>
                    </div>
                    <div class="back-foot">
                      {m.bio && <p class="bio">{m.bio}</p>}
                      {m.linkedin && (
                        <a href={m.linkedin} target="_blank" rel="noopener" class="in" data-team-link>
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
                            <rect x="2" y="9" width="4" height="12" />
                            <circle cx="4" cy="4" r="2" />
                          </svg>
                          LinkedIn<span class="sr-only"> de {m.name}</span>
                        </a>
                      )}
                    </div>
                  </div>
                )}
              </li>
            );
          })}
        </ul>

        <button type="button" class="arrow next" aria-label="Siguiente" data-team-next>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
        </button>
      </div>
    </section>
  )
}

<style>
  .team {
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    overflow: hidden;
    margin-top: var(--gap);
    border-radius: var(--radius);
    background: hsl(234 48% 6%);
    color: hsl(0 0% 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(40px, 5vw, 64px);
    padding: clamp(64px, 7vw, 104px) 0 clamp(56px, 6vw, 88px);
    scroll-margin-top: 14px;
  }
  .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 45% 55% at 50% 62%, hsl(232 80% 45% / 0.38) 0%, transparent 70%),
      radial-gradient(ellipse 60% 40% at 50% 0%, hsl(240 70% 30% / 0.35) 0%, transparent 75%);
  }
  /* Círculo decorativo: abraza el título y se desvanece antes de las tarjetas. */
  .ring {
    position: absolute;
    top: clamp(24px, 3vw, 40px);
    left: 50%;
    width: clamp(340px, 36vw, 480px);
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 9999px;
    border: 1px solid hsl(230 70% 75% / 0.16);
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 45%, transparent 62%);
    mask-image: linear-gradient(180deg, #000 0%, #000 45%, transparent 62%);
  }
  .head {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 clamp(20px, 4vw, 48px);
  }
  .kicker {
    margin: 0 0 16px;
    font-family: var(--font-inter);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: hsl(230 30% 75%);
  }
  h2 {
    margin: 0;
    font-family: var(--font-inter-tight);
    font-weight: 500;
    font-size: clamp(2.125rem, 4.6vw, 3.75rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .serif {
    display: block;
    font-family: var(--font-instrument-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    color: hsl(235 90% 78%);
  }

  /* Entrada escalonada (solo con JS; sin JS o con movimiento reducido se ve todo de inmediato). */
  .team[data-reveal-state='pending'] [data-reveal] {
    opacity: 0;
    transform: translateY(28px) scale(0.97);
  }
  .team[data-reveal-state='in'] [data-reveal] {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.7s var(--ease-out),
      transform 0.9s var(--ease-out);
    transition-delay: calc(var(--i, 0) * 90ms);
  }

  .viewport {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }
  .rail {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 12px clamp(20px, 6vw, 96px) 24px;
    list-style: none;
    display: flex;
    gap: clamp(14px, 1.6vw, 22px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 clamp(20px, 6vw, 96px);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  /* Centradas cuando caben; si no caben, los márgenes automáticos se anulan y el riel arranca desde el borde. */
  .card:first-child {
    margin-left: auto;
  }
  .card:last-child {
    margin-right: auto;
  }

  .card {
    position: relative;
    flex: none;
    width: clamp(200px, 17vw, 236px);
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
    scroll-snap-align: start;
    isolation: isolate;
    background:
      radial-gradient(ellipse 80% 60% at 50% 38%, hsl(232 85% 52% / 0.5) 0%, transparent 72%),
      linear-gradient(180deg, hsl(236 50% 14%) 0%, hsl(234 55% 9%) 100%);
    box-shadow:
      inset 0 0 0 1px hsl(230 60% 70% / 0.12),
      0 24px 50px -30px hsl(232 90% 40% / 0.7);
    outline-offset: 4px;
    cursor: default;
  }
  /* Borde luminoso que aparece con el reverso. */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px hsl(230 90% 80% / 0.45);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .front,
  .back {
    position: absolute;
    inset: 0;
  }
  /* La foto escala al pasar el mouse y pasa a su propia capa: el overflow redondeado de la tarjeta deja de recortarla
     y asoman sus esquinas cuadradas. Un clip-path redondeado en el frente la recorta siempre. */
  .front {
    border-radius: inherit;
    overflow: hidden;
    clip-path: inset(0 round 20px);
  }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    transition:
      transform 0.8s var(--ease-out),
      filter 0.5s ease;
  }
  /* Sin foto: iniciales en un círculo con anillo, sobre el brillo de la tarjeta. */
  .monogram {
    position: absolute;
    inset: 0 0 26%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .monogram span {
    width: 52%;
    aspect-ratio: 1;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-instrument-serif);
    font-style: italic;
    font-size: clamp(44px, 4.2vw, 58px);
    line-height: 1;
    color: hsl(235 90% 88%);
    background: radial-gradient(circle at 30% 25%, hsl(232 80% 40% / 0.9) 0%, hsl(236 60% 18%) 75%);
    box-shadow:
      inset 0 0 0 1px hsl(230 80% 80% / 0.25),
      0 0 0 8px hsl(232 80% 60% / 0.08);
  }
  .caption {
    position: absolute;
    inset: auto 0 0;
    padding: 56px 16px 16px;
    background: linear-gradient(180deg, transparent 0%, hsl(234 55% 8% / 0.78) 48%, hsl(234 55% 8% / 0.96) 100%);
    transition:
      opacity 0.35s ease,
      transform 0.5s var(--ease-out);
  }
  .name {
    margin: 0;
    font-family: var(--font-inter-tight);
    font-size: clamp(16px, 1.35vw, 18px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: hsl(0 0% 100%);
  }
  .role {
    margin: 4px 0 0;
    font-size: 12px;
    line-height: 1.4;
    color: hsl(235 90% 80%);
  }

  /* Reverso: cuadrícula azul que sube desde abajo; su contenido entra escalonado. */
  .back {
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 18px 16px 16px;
    border-radius: inherit;
    background-color: hsl(236 70% 30% / 0.94);
    background-image:
      linear-gradient(hsl(0 0% 100% / 0.08) 1px, transparent 1px),
      linear-gradient(90deg, hsl(0 0% 100% / 0.08) 1px, transparent 1px),
      radial-gradient(ellipse 90% 60% at 50% 0%, hsl(232 90% 58% / 0.65) 0%, transparent 70%);
    background-size:
      24px 24px,
      24px 24px,
      100% 100%;
    /* Sin backdrop-filter: Chrome lo pinta en el rectángulo completo e ignora el redondeado del clip-path (esquinas cuadradas). */
    clip-path: inset(100% 0 0 0 round 20px);
    visibility: hidden;
    transition:
      clip-path 0.55s var(--ease-out),
      visibility 0s linear 0.55s;
  }
  .back-top,
  .back-foot {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.3s ease,
      transform 0.45s var(--ease-out);
  }
  .back-foot {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .bio {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: hsl(230 60% 92%);
    text-wrap: pretty;
  }
  .in {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 18px;
    border-radius: 9999px;
    background: hsl(0 0% 100% / 0.14);
    box-shadow: inset 0 0 0 1px hsl(0 0% 100% / 0.25);
    color: hsl(0 0% 100%);
    font-size: 13px;
    font-weight: 500;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }
  .in:hover {
    color: hsl(0 0% 100%);
    background: hsl(0 0% 100% / 0.24);
    transform: translateY(-1px);
  }

  /* Estado abierto: hover (con mouse), foco de teclado visible dentro de la tarjeta, o toque (data-open).
     Solo :focus-visible, no :focus-within: tras hacer clic en LinkedIn y volver, el enlace sigue enfocado y la tarjeta quedaba abierta. */
  @media (hover: hover) {
    .card:hover .back {
      clip-path: inset(0 0 0 0 round 20px);
      visibility: visible;
      transition: clip-path 0.55s var(--ease-out);
    }
    .card:hover .back-top,
    .card:hover .back-foot {
      opacity: 1;
      transform: none;
    }
    .card:hover .back-top {
      transition-delay: 0.12s;
    }
    .card:hover .back-foot {
      transition-delay: 0.2s;
    }
    .card:hover .photo {
      transform: scale(1.06);
      filter: saturate(0.85) brightness(0.8);
    }
    .card:hover .caption {
      opacity: 0;
      transform: translateY(8px);
    }
    .card:hover::after {
      opacity: 1;
    }
  }
  .card:focus-visible .back,
  .card:has(:focus-visible) .back,
  .card[data-open] .back {
    clip-path: inset(0 0 0 0 round 20px);
    visibility: visible;
    transition: clip-path 0.55s var(--ease-out);
  }
  .card:focus-visible :is(.back-top, .back-foot),
  .card:has(:focus-visible) :is(.back-top, .back-foot),
  .card[data-open] :is(.back-top, .back-foot) {
    opacity: 1;
    transform: none;
  }
  .card:focus-visible .caption,
  .card:has(:focus-visible) .caption,
  .card[data-open] .caption {
    opacity: 0;
  }
  .card:focus-visible::after,
  .card:has(:focus-visible)::after,
  .card[data-open]::after {
    opacity: 1;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Flechas: solo cuando hay más tarjetas de las que caben (data-overflow lo pone el script). */
  .arrow {
    position: absolute;
    top: 50%;
    z-index: 4;
    width: 40px;
    height: 40px;
    margin-top: -20px;
    border: 0;
    border-radius: 9999px;
    display: none;
    align-items: center;
    justify-content: center;
    background: hsl(234 40% 14% / 0.85);
    box-shadow: inset 0 0 0 1px hsl(230 60% 80% / 0.22);
    color: hsl(0 0% 100%);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      opacity 0.2s ease;
  }
  .arrow:hover {
    background: hsl(234 40% 22%);
  }
  .arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .prev {
    left: clamp(8px, 2vw, 32px);
  }
  .next {
    right: clamp(8px, 2vw, 32px);
  }
  @media (hover: hover) and (pointer: fine) {
    .team[data-overflow] .arrow {
      display: inline-flex;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover .photo {
      transform: none;
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const section of document.querySelectorAll<HTMLElement>('[data-team]')) {
    const rail = section.querySelector<HTMLElement>('[data-team-rail]')!;
    const prev = section.querySelector<HTMLButtonElement>('[data-team-prev]')!;
    const next = section.querySelector<HTMLButtonElement>('[data-team-next]')!;

    // Entrada escalonada al llegar a la sección (una sola vez).
    if (!reduce && 'IntersectionObserver' in window) {
      const r = section.getBoundingClientRect();
      if (r.top > innerHeight * 0.85) {
        section.dataset.revealState = 'pending';
        const io = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return;
            section.dataset.revealState = 'in';
            io.disconnect();
          },
          { threshold: 0.2 },
        );
        io.observe(section);
      }
    }

    const update = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      section.toggleAttribute('data-overflow', max > 1);
      if (max <= 1) return;
      prev.disabled = rail.scrollLeft <= 1;
      next.disabled = rail.scrollLeft >= max - 1;
    };
    const step = () => {
      const card = rail.querySelector<HTMLElement>('.card');
      return card ? card.offsetWidth + parseFloat(getComputedStyle(rail).columnGap || '0') : rail.clientWidth;
    };
    prev.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));
    rail.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(rail);

    const closeAll = () => rail.querySelectorAll('[data-open]').forEach((c) => c.removeAttribute('data-open'));

    // En pantallas táctiles no hay hover: un toque muestra el reverso y otro lo oculta.
    for (const card of rail.querySelectorAll<HTMLElement>('[data-team-card]')) {
      card.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) return;
        if (matchMedia('(hover: hover)').matches) return;
        const open = !card.hasAttribute('data-open');
        closeAll();
        card.toggleAttribute('data-open', open);
      });
    }

    // Al abrir LinkedIn (pestaña nueva) la tarjeta se cierra y el enlace pierde el foco si se usó el mouse o el dedo,
    // para que al volver no quede el reverso trabado.
    for (const link of rail.querySelectorAll<HTMLAnchorElement>('[data-team-link]')) {
      link.addEventListener('click', (e) => {
        closeAll();
        if (e.detail > 0) requestAnimationFrame(() => link.blur());
      });
    }
    // Un toque fuera de las tarjetas cierra la que esté abierta.
    document.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('[data-team-card]')) closeAll();
    });
  }
</script>
