---
import { CATALOG } from '../data/site';
import Grainient from './Grainient.astro';
import GradientASCII from './GradientASCII.astro';
import WaveTitle from './WaveTitle.astro';
import ComplexipyPreview from './ComplexipyPreview.astro';

// Catálogo de productos de la empresa (datos en CATALOG). Cada producto es una tarjeta a color que, en escritorio,
// se queda fija arriba mientras la siguiente se apila encima. Los publicados enlazan a su landing; los que están
// por lanzar muestran un formulario de lista de espera y una maqueta de la interfaz.

// Fondo animado del panel visual (Grainient), del tono base al más intenso de cada paleta.
const GRAINIENT_COLORS = {
  blue: ['#eef5ff', '#cfe0ff', '#9ec0ff', '#7b93f5', '#5b6ee8'],
  purple: ['#f5f1ff', '#e2d8ff', '#c5b2fd', '#a184f7', '#7c4fe8'],
};

// Fondo ASCII de los productos por lanzar (GradientASCII en lightMode): del borde de la sombra al punto más lejano.
// El segundo color es el del halo de arriba: va en un tono medio, no casi blanco, para que no se vea un destello.
const ASCII_COLORS = {
  blue: ['#4f6ef7', '#d3ddff', '#bccbff', '#8ea6fb'],
  purple: ['#6d28d9', '#d6c8fd', '#c4b0fc', '#a78bfa'],
};
const ASCII_CHARACTERS = ' .:=+x{}#@';

// Ecos detrás de la etiqueta, como una pila de cartas en la que la tarjeta es la carta número i + 1: dos ecos a la
// derecha y, desde la segunda, uno a la izquierda por cada tarjeta anterior (hasta dos). El signo es el lado.
const echoesOf = (i: number) => [...Array.from({ length: Math.min(i, 2) }, (_, k) => -(k + 1)), 1, 2];

---

<section id="productos" aria-labelledby="productos-titulo" class="catalog" data-screen-label="Productos">
  <div class="head">
    <p class="kicker">Productos</p>
    <h2 id="productos-titulo">
      <WaveTitle parts={[{ text: 'Productos que' }, { text: 'construimos', accent: true }]} />
    </h2>
    <p class="lead">Además del software a la medida, creamos productos propios que resuelven problemáticas reales de la educación y del desarrollo de software.</p>
  </div>

  {/* Cada card publica su línea de tiempo de scroll (--card-N); la card anterior la usa para irse hacia atrás
      mientras la siguiente sube. timeline-scope en la lista permite que una card lea la línea de la otra. */}
  <ul class="list" style={`timeline-scope:${CATALOG.map((_, i) => `--card-${i}`).join(',')}`}>
    {
      CATALOG.map((p, i) => (
        <li
          class={`product theme-${p.theme}`}
          id={p.id}
          style={`--i:${i};view-timeline-name:--card-${i}${i < CATALOG.length - 1 ? `;animation-timeline:--card-${i + 1}` : ''}`}
        >
          <div class="info">
            <div class="main">
              <div class="tagrow">
                <span class="tag">
                  {p.name}
                  {echoesOf(i).map((o) => (
                    <i class:list={['echo', o < 0 ? 'is-prev' : `d-${o}`]} style={`--o:${o};--d:${Math.abs(o)}`} aria-hidden="true" />
                  ))}
                </span>
              </div>
              <h3>
                <span class="l1">{p.title[0]}</span> <span class="l2">{p.title[1]}</span>
              </h3>
              <p class="desc">
                {p.descriptionLink && p.description.includes(p.descriptionLink.text) ? (
                  // En una sola línea: los saltos de línea entre las piezas agregarían espacios antes de la coma
                  <>{p.description.slice(0, p.description.indexOf(p.descriptionLink.text))}<a href={p.descriptionLink.href} class="desc-link" target="_blank" rel="noopener">{p.descriptionLink.text}</a>{p.description.slice(p.description.indexOf(p.descriptionLink.text) + p.descriptionLink.text.length)}</>
                ) : (
                  p.description
                )}
              </p>
              {p.status === 'available' ? (
                <a href={p.href} class="go">
                  <span aria-hidden="true" class="go-sheen" />
                  Conocer {p.name}
                  <svg class="chevrons" width="17" height="11" viewBox="0 0 66 43" aria-hidden="true">
                    <polygon points="39.58,4.46 44.11,0 66,21.5 44.11,43 39.58,38.54 56.94,21.5" />
                    <polygon points="19.79,4.46 24.32,0 46.21,21.5 24.32,43 19.79,38.54 37.15,21.5" />
                    <polygon points="0,4.46 4.53,0 26.42,21.5 4.53,43 0,38.54 17.36,21.5" />
                  </svg>
                </a>
              ) : (
                <form class="waitlist" action={p.waitlistUrl} method="post" data-waitlist data-state="idle" novalidate>
                  {/* Etiqueta solo para lectores de pantalla: el placeholder no reemplaza una etiqueta */}
                  <label for={`${p.id}-email`} class="sr-only">Tu correo para la lista de espera</label>
                  <div class="wl-field">
                    <svg class="wl-mail" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="5" width="18" height="14" rx="3" />
                      <path d="m4 7 8 6 8-6" />
                    </svg>
                    <input
                      id={`${p.id}-email`}
                      name="email"
                      type="email"
                      required
                      autocomplete="email"
                      inputmode="email"
                      enterkeyhint="send"
                      spellcheck="false"
                      placeholder="tu@correo.com"
                      aria-describedby={`${p.id}-wl-msg ${p.id}-wl-legal`}
                    />
                    <button type="submit" class="wl-btn">
                      <span class="wl-btn-text">
                        Unirme<span class="sr-only"> a la lista de espera</span>
                      </span>
                      <svg class="chevrons wl-btn-arrow" width="17" height="11" viewBox="0 0 66 43" aria-hidden="true">
                        <polygon points="39.58,4.46 44.11,0 66,21.5 44.11,43 39.58,38.54 56.94,21.5" />
                        <polygon points="19.79,4.46 24.32,0 46.21,21.5 24.32,43 19.79,38.54 37.15,21.5" />
                        <polygon points="0,4.46 4.53,0 26.42,21.5 4.53,43 0,38.54 17.36,21.5" />
                      </svg>
                      <span class="wl-spinner" aria-hidden="true" />
                    </button>
                  </div>
                  <div class="wl-done" aria-hidden="true">
                    <span class="wl-done-ico">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                    </span>
                    <span>
                      <strong class="wl-done-title">¡Estás en la lista!</strong>
                      <span class="wl-done-text">Te avisaremos el día del lanzamiento.</span>
                    </span>
                  </div>
                  <p class="wl-msg" id={`${p.id}-wl-msg`} role="status" aria-live="polite" />
                  <p class="wl-legal" id={`${p.id}-wl-legal`}>
                    Recibe acceso anticipado antes del lanzamiento. <a href="/tratamiento-de-datos">Tratamiento de datos</a>
                  </p>
                </form>
              )}
            </div>
          </div>

          {p.status === 'available' ? (
            <a href={p.href} class="visual" tabindex="-1" aria-hidden="true">
              <span class="visual-bg">
                {/* dpr 1: un degradado suave se ve igual a resolución normal y en pantallas retina dibuja 4 veces menos píxeles */}
                <Grainient colors={GRAINIENT_COLORS[p.theme]} angle={55} flow={0.8} silk={0.35} grainAmount={0} dpr={1} />
              </span>
              <span class="window">
                <span class="bar">
                  <span class="lights">
                    <i />
                    <i />
                    <i />
                  </span>
                  <span class="bar-title">{p.name}</span>
                </span>
                <video class="preview-video" poster={p.preview.poster} width="1280" height="720" muted loop playsinline preload="none" data-catalog-video>
                  {p.preview.webm && <source src={p.preview.webm} type="video/webm" />}
                  {p.preview.mp4 && <source src={p.preview.mp4} type="video/mp4" />}
                </video>
              </span>
            </a>
          ) : (
            // Vista previa animada del check de complejidad en un pull request (ilustrativa, no son datos reales),
            // sobre un degradado de caracteres ASCII que remite al código
            <div class="visual is-ascii" aria-hidden="true">
              <span class="visual-bg">
                <GradientASCII colors={ASCII_COLORS[p.theme]} shape="horizon" characters={ASCII_CHARACTERS} cellSize={16} density={0.8} grain={0} lightMode />
              </span>
              <div class="window">
                <span class="bar">
                  <span class="lights">
                    <i />
                    <i />
                    <i />
                  </span>
                  <span class="bar-title">{p.name}</span>
                </span>
                <ComplexipyPreview />
              </div>
            </div>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .catalog {
    margin-top: var(--gap);
    border-radius: var(--radius);
    background: hsl(0 0% 100%);
    box-shadow: inset 0 0 0 1px hsl(228 30% 93%);
    padding: clamp(64px, 8vw, 112px) clamp(16px, 4vw, 48px);
    scroll-margin-top: 14px;
  }
  .head {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .kicker {
    margin: 0 0 16px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(232 14% 48%);
  }
  /* Título de sección: la misma escala en todo el home (32 a 54 px, 600, −0,025em) */
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: hsl(232 30% 12%);
    text-wrap: balance;
  }
  .lead {
    margin: 18px auto 0;
    max-width: 56ch;
    font-size: clamp(16px, 1.2vw, 17px);
    line-height: 1.6;
    color: hsl(232 12% 40%);
    text-wrap: pretty;
  }
  .list {
    list-style: none;
    margin: clamp(40px, 5vw, 64px) auto 0;
    padding: 0;
    max-width: 1240px;
    display: grid;
    gap: var(--gap);
  }

  /* Paletas: cada tarjeta define sus colores y el resto de estilos los usa */
  .theme-blue {
    --bg: hsl(210 100% 97.5%);
    --ink: hsl(226 64% 13%);
    --ink-soft: hsl(226 30% 30%);
    --accent: hsl(230 80% 56%);
    --tag: hsl(230 80% 56%);
    --echo-1: hsl(222 95% 84%);
    --echo-2: hsl(216 95% 91%);
    --glow: hsl(212 95% 80% / 0.55);
    --btn: var(--brand-grad);
    --btn-shadow: var(--brand-shadow);
  }
  .theme-purple {
    --bg: hsl(258 90% 97.5%);
    --ink: hsl(260 60% 13%);
    --ink-soft: hsl(258 22% 32%);
    --accent: hsl(258 70% 52%);
    --tag: hsl(260 62% 42%);
    --echo-1: hsl(258 85% 84%);
    --echo-2: hsl(256 85% 91%);
    --glow: hsl(258 90% 80% / 0.5);
    --btn: linear-gradient(180deg, hsl(258 66% 54%) 0%, hsl(262 64% 40%) 100%);
    --btn-shadow: 0 10px 24px -12px hsl(260 64% 34% / 0.7);
  }

  /* Tarjeta de producto */
  .product {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    gap: clamp(24px, 3vw, 40px);
    min-height: min(640px, calc(100vh - 120px));
    padding: clamp(16px, 1.8vw, 28px);
    border-radius: 32px;
    background: var(--bg);
    box-shadow:
      inset 0 0 0 1px hsl(228 30% 40% / 0.06),
      0 -18px 40px -28px hsl(232 40% 30% / 0.35);
    scroll-margin-top: 14px;
  }
  .info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: clamp(12px, 2.4vw, 36px) clamp(8px, 1.6vw, 24px);
  }

  /* Etiqueta con "ecos" detrás (ver echoesOf): al llegar a la tarjeta salen deslizándose desde detrás de la
     etiqueta y después se mecen despacio. Las dos animaciones van en propiedades distintas (transform y translate)
     para sumarse, y las dos corren en el hilo gráfico. */
  .tagrow {
    display: flex;
    /* Contexto de apilado propio: los ecos (z-index negativo) quedan detrás de la etiqueta y delante de la tarjeta */
    isolation: isolate;
  }
  .tag {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 18px;
    border-radius: 9999px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: hsl(0 0% 100%);
    background: var(--tag);
    /* Filo del color de la tarjeta: separa cada capa de la que asoma detrás */
    box-shadow: 0 0 0 2px var(--bg);
  }
  .echo {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--echo-1);
    box-shadow: 0 0 0 2px var(--bg);
    transform: translateX(calc(var(--o) * 14px));
    transition: transform 0.75s cubic-bezier(0.34, 1.4, 0.64, 1) calc(0.1s + var(--d) * 110ms);
    animation: echo-sway 2.8s ease-in-out calc(var(--d) * -0.7s) infinite alternate;
  }
  /* El de más lejos va más atrás y más claro; los de la izquierda (tarjetas anteriores), claros como ese */
  .echo.d-2 {
    z-index: -2;
  }
  .echo:is(.d-2, .is-prev) {
    background: var(--echo-2);
  }
  @keyframes echo-sway {
    to {
      translate: calc(var(--o) * -3px) 0;
    }
  }
  /* Antes de llegar a la tarjeta, escondidos detrás de la etiqueta y quietos (los pone el script) */
  .tagrow[data-echo='pending'] .echo {
    transform: none;
    animation-play-state: paused;
  }

  /* Un escalón por debajo del título de la sección (54 px) y con el peso del titular del hero (500): hero 74 →
     sección 54 → tarjeta 40. Inter Tight ya es comprimida: con más de −0,02em las letras se juntan. */
  h3 {
    margin: 28px 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.8vw, 2.5rem);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .l1,
  .l2 {
    display: block;
  }
  .l1 {
    color: var(--ink);
  }
  .l2 {
    color: var(--accent);
  }
  .desc {
    margin: 22px 0 0;
    max-width: 46ch;
    font-size: clamp(16px, 1.2vw, 17px);
    line-height: 1.6;
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .desc-link {
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }
  .desc-link:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    margin-top: 28px;
    /* A la derecha queda menos padding: el espacio lo ocupan las flechas que se despliegan al pasar el mouse */
    padding: 0 13px 0 22px;
    border-radius: 9999px;
    font-size: 15px;
    font-weight: 600;
    color: hsl(0 0% 100%);
    background: var(--btn);
    box-shadow: var(--btn-shadow);
    transition: filter 0.2s ease;
  }
  .go:hover {
    color: hsl(0 0% 100%);
    filter: brightness(1.15);
  }
  /* Resplandor que respira detrás del botón principal. Es un pseudo-elemento que solo anima su opacidad,
     así el navegador no repinta la sombra en cada cuadro. */
  a.go {
    position: relative;
    isolation: isolate;
  }
  a.go::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    box-shadow: 0 0 28px 4px color-mix(in srgb, var(--accent) 55%, transparent);
    opacity: 0.35;
    animation: go-glow 2.8s ease-in-out infinite;
    pointer-events: none;
  }
  a.go:hover::before {
    opacity: 1;
    animation-play-state: paused;
  }
  @keyframes go-glow {
    50% {
      opacity: 0.9;
    }
  }
  /* Destello que cruza el botón por dentro cada pocos segundos. Va en su propio span recortado a la forma del botón
     (sin overflow: hidden en el botón, que recortaría el resplandor de afuera). La franja mide 2,5 veces el botón y
     se desplaza con transform, que corre en el hilo gráfico: animar background-position repintaría cada cuadro. */
  .go-sheen {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
  }
  .go-sheen::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 250%;
    height: 100%;
    background: linear-gradient(110deg, transparent 38%, hsl(0 0% 100% / 0.2) 50%, transparent 62%);
    transform: translateX(-90%);
    animation: go-sheen 2.6s ease-in-out infinite;
  }
  /* En celular la pantalla es chica y el halo se derrama sobre el recuadro de abajo: más corto, más tenue */
  @media (max-width: 899px) {
    a.go {
      height: 46px;
      box-shadow: 0 6px 16px -10px hsl(216 90% 30% / 0.5);
    }
    a.go::before {
      box-shadow: 0 0 14px 0 color-mix(in srgb, var(--accent) 40%, transparent);
      opacity: 0.2;
      animation-name: go-glow-soft;
    }
  }
  @keyframes go-glow-soft {
    50% {
      opacity: 0.55;
    }
  }
  /* La franja va de fuera del borde izquierdo a fuera del derecho: los mismos puntos que el background-position
     de 150 % a -50 % con background-size de 250 % que tenía antes. */
  @keyframes go-sheen {
    0% {
      transform: translateX(-90%);
    }
    45%,
    100% {
      transform: translateX(30%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    a.go::before,
    .go-sheen::before {
      animation: none;
    }
  }

  /* Flechas »»» de los botones: en reposo se ve una sola; al pasar el mouse las otras dos se despliegan escalonadas.
     Las traslaciones van en unidades del viewBox (66×43): llevan cada flecha encima de la primera. */
  .chevrons {
    flex-shrink: 0;
    overflow: visible;
  }
  .chevrons polygon {
    fill: currentColor;
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.25s ease;
  }
  .chevrons polygon:nth-child(1) {
    opacity: 0;
    transform: translateX(-39.58px);
  }
  .chevrons polygon:nth-child(2) {
    opacity: 0;
    transform: translateX(-19.79px);
  }
  :is(.go, .wl-btn):is(:hover, :focus-visible) .chevrons polygon {
    opacity: 1;
    transform: none;
  }
  :is(.go, .wl-btn):is(:hover, :focus-visible) .chevrons polygon:nth-child(1) {
    transition-delay: 0.06s;
  }
  @media (prefers-reduced-motion: reduce) {
    .chevrons polygon {
      transition: none;
    }
  }

  /* Dato de respaldo al pie */

  /* Panel visual: el fondo es un Grainient animado (sin grano); este degradado queda de respaldo sin WebGL2 */
  .visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: clamp(20px, 4vw, 56px);
    border-radius: 24px;
    background:
      radial-gradient(ellipse 70% 60% at 70% 75%, var(--glow), transparent 70%),
      linear-gradient(180deg, hsl(38 36% 93%) 0%, hsl(34 28% 87%) 100%);
  }
  .visual > .visual-bg {
    position: absolute;
    inset: 0;
  }
  /* El ASCII deja transparentes las zonas sin luz: debajo va un fondo claro del tono de la tarjeta.
     Menos margen que el video: la vista previa de Complexipy necesita el ancho para sus barras y su código. */
  .visual.is-ascii {
    padding: clamp(16px, 3vw, 40px);
    background: color-mix(in srgb, var(--bg) 60%, hsl(0 0% 100%));
  }
  .visual.is-ascii .window {
    max-width: 560px;
  }
  .window {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 16px;
    background: hsl(0 0% 100%);
    box-shadow:
      0 0 0 1px hsl(232 30% 40% / 0.08),
      0 30px 60px -30px hsl(232 50% 30% / 0.45);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .visual:hover .window {
    transform: translateY(-4px);
  }
  /* Barra de título estilo macOS: semáforos con borde sutil y el nombre centrado */
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    background: linear-gradient(180deg, hsl(0 0% 98%) 0%, hsl(0 0% 94.5%) 100%);
    border-bottom: 1px solid hsl(0 0% 86%);
  }
  .lights {
    display: flex;
    gap: 8px;
  }
  .lights i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 0.5px hsl(0 0% 0% / 0.18);
  }
  .lights i:nth-child(1) {
    background: #ff5f57;
  }
  .lights i:nth-child(2) {
    background: #febc2e;
  }
  .lights i:nth-child(3) {
    background: #28c840;
  }
  /* Bloque centrado y no grid: en un grid el texto no recibe los puntos suspensivos y en una ventana angosta se
     cortaba a la mitad de una letra */
  .bar-title {
    position: absolute;
    inset: 0 76px;
    overflow: hidden;
    font-size: 12px;
    font-weight: 600;
    line-height: 30px;
    text-align: center;
    color: hsl(0 0% 38%);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .window img,
  .window video {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Lista de espera: campo tipo píldora con el botón adentro, y estados de carga, error y éxito (data-state) */
  .waitlist {
    /* Sangría compartida: la etiqueta y los textos de abajo arrancan donde empieza el contenido del campo
       (alineación óptica con la píldora, en vez de con su borde curvo) */
    --wl-inset: 18px;
    max-width: 460px;
    margin-top: 30px;
  }
  .wl-field {
    display: flex;
    align-items: center;
    height: 54px;
    padding: 5px 5px 5px var(--wl-inset);
    border-radius: 9999px;
    background: hsl(0 0% 100%);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--ink) 13%, transparent),
      0 1px 2px hsl(232 30% 20% / 0.05);
    transition: box-shadow 0.2s ease;
  }
  .wl-field:focus-within {
    box-shadow:
      inset 0 0 0 1px var(--accent),
      0 0 0 4px color-mix(in srgb, var(--accent) 12%, transparent);
  }
  /* Sin color-mix() (Safari < 16.2, Chrome < 111) las dos sombras de arriba se descartan y el campo quedaría sin
     borde ni anillo de foco: van en colores fijos. */
  @supports not (color: color-mix(in srgb, red, red)) {
    .wl-field {
      box-shadow:
        inset 0 0 0 1px hsl(228 30% 80%),
        0 1px 2px hsl(232 30% 20% / 0.05);
    }
    .wl-field:focus-within {
      box-shadow:
        inset 0 0 0 1px var(--accent),
        0 0 0 4px hsl(230 80% 56% / 0.15);
    }
  }
  .wl-field[data-invalid] {
    box-shadow:
      inset 0 0 0 1px hsl(0 70% 52%),
      0 0 0 4px hsl(0 80% 52% / 0.1);
  }
  .wl-mail {
    flex-shrink: 0;
    margin-right: 10px;
    color: color-mix(in srgb, var(--ink-soft) 70%, transparent);
    transition: color 0.2s ease;
  }
  .wl-field:focus-within .wl-mail {
    color: var(--accent);
  }
  .wl-field input {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 0;
    outline: none;
    background: transparent;
    font: inherit;
    /* 16px evita que iOS haga zoom al enfocar el campo */
    font-size: 16px;
    color: var(--ink);
  }
  .wl-field input::placeholder {
    color: color-mix(in srgb, var(--ink-soft) 55%, transparent);
  }
  .wl-btn {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 7px;
    height: 44px;
    margin-left: 8px;
    padding: 0 9px 0 20px;
    border: 0;
    border-radius: 9999px;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    color: hsl(0 0% 100%);
    /* Botón sólido en el tono más oscuro de la tarjeta: sobrio frente al degradado del titular */
    background: var(--ink);
    box-shadow:
      inset 0 1px 0 hsl(0 0% 100% / 0.14),
      0 6px 14px -8px color-mix(in srgb, var(--ink) 70%, transparent);
    cursor: pointer;
    transition:
      background 0.2s ease,
      transform 0.15s ease;
  }
  .wl-btn:hover {
    background: color-mix(in srgb, var(--ink) 82%, var(--accent));
  }
  .wl-btn:active {
    transform: scale(0.97);
  }
  .wl-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .wl-spinner {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 18px;
    height: 18px;
    border: 2px solid hsl(0 0% 100% / 0.35);
    border-top-color: hsl(0 0% 100%);
    border-radius: 50%;
    opacity: 0;
  }
  .waitlist[data-state='loading'] .wl-btn {
    cursor: progress;
  }
  .waitlist[data-state='loading'] .wl-btn-text,
  .waitlist[data-state='loading'] .wl-btn-arrow {
    opacity: 0;
  }
  .waitlist[data-state='loading'] .wl-spinner {
    opacity: 1;
    animation: wl-spin 0.7s linear infinite;
  }
  @keyframes wl-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Éxito: el campo se reemplaza por una confirmación */
  .wl-done {
    display: none;
    align-items: center;
    gap: 12px;
    min-height: 54px;
    padding: 8px 20px 8px 8px;
    border-radius: 9999px;
    background: hsl(0 0% 100%);
    box-shadow: inset 0 0 0 1px hsl(152 40% 78%);
  }
  .waitlist[data-state='done'] .wl-field {
    display: none;
  }
  .waitlist[data-state='done'] .wl-done {
    display: flex;
    animation: wl-in 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes wl-in {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
  }
  .wl-done-ico {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: hsl(0 0% 100%);
    background: linear-gradient(180deg, hsl(152 60% 44%), hsl(152 64% 34%));
  }
  .wl-done-title {
    display: block;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
  }
  .wl-done-text {
    display: block;
    font-size: 13px;
    color: var(--ink-soft);
  }

  .wl-msg {
    margin: 10px 0 0;
    padding-left: var(--wl-inset);
    font-size: 13px;
    font-weight: 500;
    color: hsl(0 65% 45%);
  }
  .wl-msg:empty {
    display: none;
  }
  /* En éxito el mensaje solo se anuncia al lector de pantalla: la confirmación ya se ve arriba */
  .waitlist[data-state='done'] .wl-msg,
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .wl-legal {
    margin: 10px 0 0;
    padding-left: var(--wl-inset);
    font-size: 13px;
    line-height: 1.5;
    color: color-mix(in srgb, var(--ink-soft) 85%, transparent);
  }
  .wl-legal a {
    color: inherit;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 2px;
  }
  .wl-legal a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  @media (max-width: 420px) {
    .wl-mail {
      display: none;
    }
    .waitlist {
      --wl-inset: 20px;
    }
    .wl-btn {
      padding: 0 8px 0 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .waitlist[data-state='done'] .wl-done {
      animation: none;
    }
  }

  /* Apilado: solo con espacio para que cada tarjeta quepa entera bajo el nav */
  @media (min-width: 900px) and (min-height: 720px) {
    .product {
      position: sticky;
      top: calc(84px + var(--i) * 18px);
    }
  }
  /* La card que queda debajo se inclina hacia atrás, se encoge y sube mientras la siguiente entra a la pantalla.
     Solo anima transform: corre en el hilo gráfico del navegador, sin JavaScript ni repintado.
     Con movimiento reducido las cards solo se apilan. Va como condición de la media query y no como un
     `animation: none` aparte: esa regla pierde por especificidad contra :not(:last-child), y la regla global de
     movimiento reducido (duración de 0.01ms) no frena una animación ligada al scroll. */
  @media (min-width: 900px) and (min-height: 720px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .product:not(:last-child) {
        /* Gira sobre su borde de arriba: el de abajo sube y se acuesta hacia atrás, y queda visible sobre la que llega */
        transform-origin: 50% 0%;
        animation: card-recede linear both;
        animation-range: entry 0% entry 100%;
      }
    }
  }
  /* Se acuesta hacia atrás y se atenúa, sin desaparecer: queda visible detrás de la siguiente, como una card
     apoyada sobre otra. Opacidad y transform no repintan. */
  @keyframes card-recede {
    30% {
      opacity: 1;
    }
    to {
      transform: perspective(1400px) translate3d(0, -4%, -380px) rotateX(32deg);
      opacity: 0.4;
    }
  }

  @media (max-width: 899px) {
    .product {
      grid-template-columns: 1fr;
      min-height: 0;
      border-radius: 28px;
    }
    .info {
      padding: 12px 8px 0;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Ecos de las etiquetas: las tarjetas que todavía no se ven los esconden detrás de la etiqueta y, cuando la
  // etiqueta entra entera en pantalla, salen deslizándose (una sola vez). Sin JS o con movimiento reducido quedan fijos.
  if (!reduceMotion) {
    const echoes = new IntersectionObserver(
      (entries) => {
        for (const { target, isIntersecting } of entries) {
          if (!isIntersecting) continue;
          target.removeAttribute('data-echo');
          echoes.unobserve(target);
        }
      },
      { threshold: 1 },
    );
    for (const row of document.querySelectorAll<HTMLElement>('.catalog .tagrow')) {
      if (row.getBoundingClientRect().top < innerHeight * 0.9) continue;
      row.dataset.echo = 'pending';
      echoes.observe(row);
    }
  }

  // Videos de vista previa: no se descargan hasta que la tarjeta entra en pantalla, y se pausan al salir.
  // Con movimiento reducido o ahorro de datos se queda el póster.
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  const previews = document.querySelectorAll<HTMLVideoElement>('video[data-catalog-video]');
  if (!reduceMotion && !saveData && previews.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(({ target, isIntersecting }) => {
          const video = target as HTMLVideoElement;
          if (isIntersecting) {
            video.muted = true; // el atributo no siempre se refleja en la propiedad; fijarlo garantiza el autoplay.
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      { threshold: 0.25 },
    );
    previews.forEach((video) => observer.observe(video));
  }

  // Envía el correo a la lista de espera como JSON y muestra el resultado sin recargar la página.
  // data-state en el form: idle → loading → done (o de vuelta a idle si hay un error).
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  document.querySelectorAll<HTMLFormElement>('form[data-waitlist]').forEach((form) => {
    const field = form.querySelector<HTMLElement>('.wl-field')!;
    const input = form.querySelector('input')!;
    const button = form.querySelector('button')!;
    const msg = form.querySelector<HTMLElement>('.wl-msg')!;
    const doneTitle = form.querySelector<HTMLElement>('.wl-done-title')!;
    const doneText = form.querySelector<HTMLElement>('.wl-done-text')!;

    const fail = (text: string) => {
      form.dataset.state = 'idle';
      field.dataset.invalid = '';
      input.setAttribute('aria-invalid', 'true');
      msg.textContent = text;
      input.focus();
    };

    input.addEventListener('input', () => {
      delete field.dataset.invalid;
      input.removeAttribute('aria-invalid');
      msg.textContent = '';
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (form.dataset.state === 'loading') return;
      const email = input.value.trim().toLowerCase();
      if (!EMAIL_RE.test(email)) {
        fail('Revisa el correo: debe verse como tu@correo.com.');
        return;
      }

      form.dataset.state = 'loading';
      button.disabled = true;
      msg.textContent = '';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
          // Si la API no responde, se corta a los 10 s y se muestra el error en vez de dejar el spinner girando
          signal: AbortSignal.timeout?.(10000),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || String(res.status));
        doneTitle.textContent = data.alreadyRegistered ? 'Ya estabas en la lista' : '¡Estás en la lista!';
        doneText.textContent = data.alreadyRegistered ? 'Te avisaremos a ese correo el día del lanzamiento.' : 'Te avisaremos el día del lanzamiento.';
        const title = doneTitle.textContent ?? '';
        msg.textContent = `${title}${/[.!?]$/.test(title) ? '' : '.'} ${doneText.textContent}`;
        form.dataset.state = 'done';
        form.reset();
      } catch {
        fail('No pudimos registrarte. Inténtalo de nuevo en un momento.');
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
