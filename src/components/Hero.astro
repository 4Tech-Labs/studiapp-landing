---
import { Picture } from 'astro:assets';
import heroSrc from '../assets/hero-2560.webp';
import VideoPlayer from './VideoPlayer.astro';
import HeroMock from './HeroMock.astro';
import { HERO } from '../data/site';

const isVideo = HERO.media === 'video';
---

<div id="inicio" class="hero" data-screen-label="Hero">
  <div aria-hidden="true" class="hero-bg">
    <Picture
      src={heroSrc}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="veil"></div>
  </div>

  <section aria-labelledby="hero-titulo" class="body">
    <div class="inner">
      <h1 id="hero-titulo">
        Planea un año escolar en <span class="accent">minutos<svg aria-hidden="true" viewBox="0 0 200 20" preserveAspectRatio="none" class="underline"><path d="M4 12 C 60 5, 140 5, 196 12" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" opacity="0.85"></path></svg></span>
      </h1>

      <p class="lead">Genera planeaciones anuales, periódicas y semanales con IA, en las plantillas que ya usa tu colegio y con el contexto de tu institución.</p>

      <div class="ctas">
        <a href="#agenda" class="btn-pop"><span class="pop-label">Agenda una reunión</span></a>
        {
          isVideo && (
            <button type="button" aria-label="Reproducir video" class="btn-play" data-hero-play>
              <span aria-hidden="true" class="play-dome">
                <svg width="18" height="18" viewBox="0 0 24 24" focusable="false">
                  <path d="M20.492,7.969,10.954.975A5,5,0,0,0,3,5.005V19a4.994,4.994,0,0,0,7.954,4.03l9.538-6.994a5,5,0,0,0,0-8.062Z" />
                </svg>
              </span>
            </button>
          )
        }
      </div>

      <div class="media" data-hero-media>
        <div class="glass">
          {
            isVideo ? (
              <div class="frame">
                <VideoPlayer label="demo" webm={HERO.video.webm} mp4={HERO.video.mp4} poster={HERO.video.poster} autoplay={HERO.autoplay} loop />
              </div>
            ) : (
              <HeroMock />
            )
          }
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - clamp(20px, 3vw, 32px));
    display: flex;
    flex-direction: column;
    background: hsl(0 0% 100%);
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.04);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: inherit;
    background: var(--sky);
    pointer-events: none;
  }
  .hero-bg :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    opacity: 0.55;
  }
  .veil {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 55% 50% at 50% 38%, hsl(0 0% 100% / 0.6) 0%, hsl(0 0% 100% / 0.25) 55%, transparent 100%);
  }
  .body {
    position: relative;
    z-index: 10;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(86px, 10vh, 116px) clamp(16px, 3vw, 24px) clamp(40px, 6vw, 80px);
    min-height: 0;
  }
  .inner {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
  /* Titular y bajada con la escala del hero de 4Tech (CompanyHero): peso 500, de 37 a 74 px, y bajada de 17 a 20 px */
  h1 {
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.3rem, 5.2vw, 4.6rem);
    line-height: 1.06;
    letter-spacing: -0.022em;
    color: var(--ink);
    max-width: 640px;
    text-wrap: balance;
    animation: fadeUp16 0.6s ease-out 0.1s both;
  }
  .accent {
    position: relative;
    display: inline-block;
    color: var(--accent);
  }
  .underline {
    position: absolute;
    left: -2%;
    width: 104%;
    bottom: -0.14em;
    height: 0.2em;
    overflow: visible;
    display: block;
  }
  /* 26 px de aire: con menos, el subrayado de "minutos" casi tocaba la bajada */
  .lead {
    margin: 26px 0 0;
    text-align: center;
    font-size: clamp(17px, 1.4vw, 20px);
    color: var(--ink-2);
    max-width: 650px;
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-wrap: balance;
    animation: fadeUp16 0.6s ease-out 0.2s both;
  }
  .ctas {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
    animation: fadeUp16 0.6s ease-out 0.3s both;
  }
  /* Botón principal en 3D: cara en la tinta del sitio levantada 4 px hacia arriba a la izquierda sobre un canto gris
     en diagonal, el mismo gris del filo del botón de reproducir. Blanco no: sobre el fondo claro del hero el canto
     desaparecería. El canto son copias de la sombra desplazadas en diagonal; con dos basta (entre ellas la muesca
     mide menos de un cuarto de píxel). Al pasar el mouse, o al tocarla en celular, se asienta en su lugar. 44 px de
     alto, como antes. */
  .btn-pop {
    --pop-raised:
      2px 2px 0 0 hsl(220 14% 72%),
      4px 4px 0 0 hsl(220 14% 72%),
      6px 8px 18px -6px rgb(1 40 100 / 0.35);
    --pop-pressed: 0 2px 8px -4px rgb(1 40 100 / 0.35);
    display: inline-block;
    border-radius: 9999px;
    background: var(--ink);
    color: hsl(0 0% 100%);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    translate: -4px -4px;
    box-shadow: var(--pop-raised);
    transition:
      translate 0.15s ease,
      box-shadow 0.15s ease;
    touch-action: manipulation;
  }
  /* Solo con mouse: en pantallas táctiles el :hover se queda pegado después del toque */
  @media (hover: hover) {
    .btn-pop:hover {
      color: hsl(0 0% 100%);
      translate: none;
      box-shadow: var(--pop-pressed);
    }
  }
  .btn-pop:active {
    translate: none;
    box-shadow: var(--pop-pressed);
  }
  .pop-label {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 24px;
  }
  .btn-pop:active .pop-label {
    translate: 0 1px;
  }
  /* Botón de reproducir en 3D: un bisel claro (el botón), un pozo oscuro desenfocado que hace de sombra de contacto
     (::before) y encima la cúpula azul de la marca con un brillo arriba y un labio oscuro abajo. Al presionar, el
     labio se aclara y el ícono se encoge un poco: la cúpula parece hundirse. 48 px, apenas más alto que el botón de
     al lado, para no quitarle protagonismo. */
  .btn-play {
    position: relative;
    flex: none;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background: hsl(214 100% 97%);
    box-shadow:
      inset 0 0 1px 1px rgb(0 0 0 / 0.3),
      1px 2px 4px rgb(0 0 0 / 0.1);
    cursor: pointer;
  }
  .btn-play::before,
  .play-dome {
    position: absolute;
    top: 3px;
    left: 50%;
    width: 42px;
    height: 42px;
    border-radius: inherit;
    translate: -50% 0;
  }
  .btn-play::before {
    content: '';
    background: hsl(0 0% 0%);
    filter: blur(1px);
  }
  .play-dome {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, #1a5cc0 0%, #4d8ce0 100%);
    box-shadow:
      inset 0 3px 2px #6fa3ec,
      inset 0 -3px 0 #013a8c,
      0 0 2px hsl(0 0% 0%);
    transition:
      box-shadow 0.12s ease,
      filter 0.2s ease;
  }
  .play-dome svg {
    fill: hsl(214 95% 93%);
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.5));
    transition: scale 0.12s ease;
  }
  .btn-play:hover .play-dome {
    filter: brightness(1.08);
  }
  .btn-play:active .play-dome {
    box-shadow:
      inset 0 3px 2px rgb(111 163 236 / 0.5),
      inset 0 -3px 2px rgb(26 92 192 / 0.5),
      0 0 2px hsl(0 0% 0%);
  }
  .btn-play:active .play-dome svg {
    scale: 0.95;
  }
  .media {
    margin-top: 32px;
    width: 100%;
    max-width: 1024px;
    animation: fadeUp30 0.8s ease-out 0.5s both;
  }
  .glass {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    padding: clamp(12px, 1.2vw, 16px);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0.1) 45%, rgba(255, 255, 255, 0.2) 100%);
    border: 1px solid rgba(255, 255, 255, 0.7);
    -webkit-backdrop-filter: blur(14px) saturate(1.5);
    backdrop-filter: blur(14px) saturate(1.5);
    box-shadow:
      0 25px 80px -12px rgba(0, 0, 0, 0.08),
      0 0 0 1px rgba(255, 255, 255, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 -1px 0 rgba(255, 255, 255, 0.3),
      inset 0 0 24px rgba(255, 255, 255, 0.18);
  }
  .glass::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0) 40%);
    -webkit-mask:
      linear-gradient(#000, #000) content-box,
      linear-gradient(#000, #000);
    mask:
      linear-gradient(#000, #000) content-box,
      linear-gradient(#000, #000);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    padding: 1px;
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: hsl(220 24% 96%);
    border-radius: 10px;
    border: 1px solid var(--line);
    overflow: hidden;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
  }
</style>

<script>
  // Botón «Reproducir video»: reinicia el demo con sonido y lo centra en pantalla si no está completo en el viewport.
  const btn = document.querySelector<HTMLButtonElement>('[data-hero-play]');
  const media = document.querySelector<HTMLElement>('[data-hero-media]');
  btn?.addEventListener('click', () => {
    if (!media) return;
    media.querySelector('[data-video-player]')?.dispatchEvent(new CustomEvent('player:play-from-start'));
    const r = media.getBoundingClientRect();
    const vh = window.innerHeight;
    if (r.top >= 0 && r.bottom <= vh) return;
    window.scrollTo({ top: r.top + window.scrollY - Math.max(16, (vh - r.height) / 2), behavior: 'smooth' });
  });
</script>
