---
import GradientWaves from './GradientWaves.astro';
import VideoPlayer from './VideoPlayer.astro';
import HeroMock from './HeroMock.astro';
import { HERO } from '../data/site';

const isVideo = HERO.media === 'video';
---

<div id="inicio" class="hero" data-screen-label="Hero">
  {/* Las mismas olas azules de Quiénes somos (Nosotros), con la cámara más inclinada hacia el mar (tilt 42 y no 64):
      el hero es mucho más alto y con el horizonte por defecto las olas quedaban abajo, detrás del video; así empiezan
      a la altura de la bajada. Sin WebGL2
      queda el degradado de .hero-bg. */}
  <div aria-hidden="true" class="hero-bg">
    <GradientWaves
      lightMode
      horizonColor="#cfe0ff"
      waveColor="#3d7fd9"
      crestColor="#ffffff"
      speed={0.4}
      amplitude={2.5}
      relief={1}
      lightAngle={120}
      tilt={42}
      grain={0}
      brightness={1.3}
      dpr={1}
    />
    <div class="veil"></div>
  </div>

  <section aria-labelledby="hero-titulo" class="body">
    <div class="inner">
      <h1 id="hero-titulo">
        Planea un año escolar en <span class="accent">minutos<svg aria-hidden="true" viewBox="0 0 200 20" preserveAspectRatio="none" class="underline"><path d="M4 12 C 60 5, 140 5, 196 12" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" opacity="0.85"></path></svg></span>
      </h1>

      <p class="lead">Genera planeaciones anuales, periódicas y semanales con IA, en las plantillas que ya usa tu colegio y con el contexto de tu institución.</p>

      <div class="ctas">
        <a href="#agenda" class="btn-pop"><span class="pop-label">Agenda una reunión</span></a>
      </div>

      <div class="media">
        <div class="glass">
          {
            isVideo ? (
              <div class="frame">
                <VideoPlayer label="demo" webm={HERO.video.webm} mp4={HERO.video.mp4} poster={HERO.video.poster} autoplay={HERO.autoplay} loop />
              </div>
            ) : (
              <HeroMock />
            )
          }
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - clamp(20px, 3vw, 32px));
    display: flex;
    flex-direction: column;
    background: hsl(0 0% 100%);
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.04);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: inherit;
    background: linear-gradient(180deg, hsl(220 44% 96.5%) 0%, hsl(220 40% 98%) 100%);
    pointer-events: none;
  }
  .veil {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 55% 50% at 50% 38%, hsl(0 0% 100% / 0.6) 0%, hsl(0 0% 100% / 0.25) 55%, transparent 100%);
  }
  .body {
    position: relative;
    z-index: 10;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(86px, 10vh, 116px) clamp(16px, 3vw, 24px) clamp(40px, 6vw, 80px);
    min-height: 0;
  }
  .inner {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
  /* Titular y bajada con la escala del hero de 4Tech (CompanyHero): peso 500, de 37 a 74 px, y bajada de 17 a 20 px */
  h1 {
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.3rem, 5.2vw, 4.6rem);
    line-height: 1.06;
    letter-spacing: -0.022em;
    color: var(--ink);
    max-width: 640px;
    text-wrap: balance;
    animation: fadeUp16 0.6s ease-out 0.1s both;
  }
  .accent {
    position: relative;
    display: inline-block;
    color: var(--accent);
  }
  .underline {
    position: absolute;
    left: -2%;
    width: 104%;
    bottom: -0.14em;
    height: 0.2em;
    overflow: visible;
    display: block;
  }
  /* 26 px de aire: con menos, el subrayado de "minutos" casi tocaba la bajada */
  .lead {
    margin: 26px 0 0;
    text-align: center;
    font-size: clamp(17px, 1.4vw, 20px);
    color: var(--ink-2);
    max-width: 650px;
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-wrap: balance;
    animation: fadeUp16 0.6s ease-out 0.2s both;
  }
  .ctas {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
    animation: fadeUp16 0.6s ease-out 0.3s both;
  }
  /* Botón principal en 3D: cara en la tinta del sitio levantada 4 px hacia arriba a la izquierda sobre un canto gris
     en diagonal, el mismo gris del filo del botón de reproducir del video. Blanco no: sobre el fondo claro del hero el canto
     desaparecería. El canto son copias de la sombra desplazadas en diagonal; con dos basta (entre ellas la muesca
     mide menos de un cuarto de píxel). Al pasar el mouse, o al tocarla en celular, se asienta en su lugar. 44 px de
     alto, como antes. */
  .btn-pop {
    --pop-raised:
      2px 2px 0 0 hsl(220 14% 72%),
      4px 4px 0 0 hsl(220 14% 72%),
      6px 8px 18px -6px rgb(1 40 100 / 0.35);
    --pop-pressed: 0 2px 8px -4px rgb(1 40 100 / 0.35);
    display: inline-block;
    border-radius: 9999px;
    background: var(--ink);
    color: hsl(0 0% 100%);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    translate: -4px -4px;
    box-shadow: var(--pop-raised);
    transition:
      translate 0.15s ease,
      box-shadow 0.15s ease;
    touch-action: manipulation;
  }
  /* Solo con mouse: en pantallas táctiles el :hover se queda pegado después del toque */
  @media (hover: hover) {
    .btn-pop:hover {
      color: hsl(0 0% 100%);
      translate: none;
      box-shadow: var(--pop-pressed);
    }
  }
  .btn-pop:active {
    translate: none;
    box-shadow: var(--pop-pressed);
  }
  .pop-label {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 24px;
  }
  .btn-pop:active .pop-label {
    translate: 0 1px;
  }
  .media {
    margin-top: 32px;
    width: 100%;
    max-width: 1024px;
    animation: fadeUp30 0.8s ease-out 0.5s both;
  }
  .glass {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    padding: clamp(12px, 1.2vw, 16px);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0.1) 45%, rgba(255, 255, 255, 0.2) 100%);
    border: 1px solid rgba(255, 255, 255, 0.7);
    -webkit-backdrop-filter: blur(14px) saturate(1.5);
    backdrop-filter: blur(14px) saturate(1.5);
    box-shadow:
      0 25px 80px -12px rgba(0, 0, 0, 0.08),
      0 0 0 1px rgba(255, 255, 255, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 -1px 0 rgba(255, 255, 255, 0.3),
      inset 0 0 24px rgba(255, 255, 255, 0.18);
  }
  .glass::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0) 40%);
    -webkit-mask:
      linear-gradient(#000, #000) content-box,
      linear-gradient(#000, #000);
    mask:
      linear-gradient(#000, #000) content-box,
      linear-gradient(#000, #000);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    padding: 1px;
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: hsl(220 24% 96%);
    border-radius: 10px;
    border: 1px solid var(--line);
    overflow: hidden;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
  }
</style>
