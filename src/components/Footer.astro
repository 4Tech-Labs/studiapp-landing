---
import LottieLogo from './LottieLogo.astro';
import { SITE, SOCIAL, LEGAL_LINKS } from '../data/site';

const year = new Date().getFullYear();
const social = [
  {
    label: 'Instagram',
    href: SOCIAL.instagram,
    icon: '<rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"></circle>',
  },
  {
    label: 'LinkedIn',
    href: SOCIAL.linkedin,
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle>',
  },
  {
    label: 'YouTube',
    href: SOCIAL.youtube,
    icon: '<rect x="2.5" y="5.5" width="19" height="13" rx="4"></rect><polygon points="10 9 15 12 10 15 10 9" fill="currentColor"></polygon>',
  },
].filter((s) => s.href);
---

<footer class="footer" data-screen-label="Footer">
  <div aria-hidden="true" class="glow"></div>
  <div class="top">
    <div class="about">
      <a href="/#inicio" aria-label={`${SITE.name}, inicio`} class="brand"><LottieLogo width={24} height={34} />{SITE.name}</a>
      <p>Planeaciones escolares con IA, en las plantillas de tu colegio.</p>
      {
        social.length > 0 && (
          <div class="social">
            {social.map((s) => (
              <a href={s.href} aria-label={s.label} target="_blank" rel="noopener" class="soc">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon}></svg>
              </a>
            ))}
          </div>
        )
      }
    </div>
    <div class="navs">
      <nav aria-labelledby="footer-producto" class="col">
        <p id="footer-producto" class="kicker">Producto</p>
        <a href="/#caracteristicas">Características</a>
        <a href="/#agenda">Agenda una reunión</a>
        <a href={`mailto:${SITE.email}`}>Contacto</a>
      </nav>
      <nav aria-labelledby="footer-legal" class="col">
        <p id="footer-legal" class="kicker">Legal</p>
        {LEGAL_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>
  </div>
  <div class="bottom">
    <span>© {year} {SITE.name}. Todos los derechos reservados.</span>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--gap);
    border-radius: var(--radius);
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, hsl(222 100% 96%) 0%, hsl(222 90% 92%) 100%);
    color: var(--ink);
    padding: clamp(48px, 6vw, 80px) clamp(24px, 5vw, 64px) clamp(24px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }
  .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 50% 70% at 100% 0%, hsl(222 100% 82% / 0.6) 0%, transparent 70%);
  }
  .top {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: clamp(32px, 4vw, 48px) clamp(40px, 6vw, 96px);
  }
  .about {
    flex: 1 1 260px;
    min-width: 0;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-outfit);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .about p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: hsl(222 20% 40%);
    text-wrap: pretty;
  }
  .social {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
  }
  .soc {
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    background: hsl(0 0% 100%);
    box-shadow: inset 0 0 0 1px hsl(222 40% 86%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    transition: box-shadow 0.2s ease;
  }
  .soc:hover {
    box-shadow: inset 0 0 0 1px var(--accent);
    color: var(--accent);
  }
  .navs {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(32px, 4vw, 48px) clamp(40px, 5vw, 80px);
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 150px;
  }
  .kicker {
    margin: 0;
    font-family: var(--font-outfit);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: hsl(222 30% 48%);
  }
  .col a {
    font-size: 15px;
    line-height: 1.4;
    color: hsl(210 14% 20%);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }
  .col a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
  .bottom {
    position: relative;
    border-top: 1px solid hsl(222 40% 84%);
    padding-top: 20px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    font-size: 13px;
    color: hsl(222 20% 44%);
  }
  .bottom a {
    color: hsl(222 20% 44%);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }
  .bottom a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
