---
import { COMPANY } from '../data/site';
import ShapeGrid from './ShapeGrid.astro';
import WaveTitle from './WaveTitle.astro';

// Membresía en NVIDIA Inception (aprobada el 23-oct-2026). El sello es el SVG oficial sin modificar
// (guía: https://design.nvidia.com/partners/inception/nvidia-inception-program/member-badge):
// no cambiar colores, proporciones ni texto, y no mostrarlo más grande que el logo de la empresa si van juntos.
---

<section id="respaldo" aria-labelledby="respaldo-titulo" class="respaldo" data-screen-label="Respaldo">
  {/* Cuadrícula que se desliza y enciende en verde NVIDIA las celdas bajo el cursor; sin JS queda el degradado. */}
  <div aria-hidden="true" class="grid-bg">
    <ShapeGrid
      lineColor="hsl(222 40% 50% / 0.09)"
      hoverColor="#76b900"
      fillOpacity={0.1}
      speed={0.3}
      radius={1.5}
      trail={0.7}
      glow={0.3}
      fade={1}
    />
  </div>
  <div class="inner">
    <p class="kicker">Respaldo</p>
    {/* "Seleccionados" y no "respaldados por NVIDIA": la membresía no implica que NVIDIA avale a la empresa.
        Sin la ola (still): en el home la sección ya tiene su efecto de scroll, el telón de Contacto (ver index.astro). */}
    <h2 id="respaldo-titulo"><WaveTitle parts={[{ text: 'Seleccionados por' }, { text: 'NVIDIA Inception', accent: true }]} still /></h2>
    <p class="lead">
      {COMPANY.name} es parte del programa de NVIDIA para startups que construyen con inteligencia artificial. Eso nos da acceso a <strong>herramientas, formación técnica y expertos de NVIDIA</strong> para construir software con tecnología de primer nivel.
    </p>

    {/* Solo el sello oficial, sin caja alrededor (ya trae su propio recuadro). */}
    <a href="https://www.nvidia.com/en-us/startups/" target="_blank" rel="noopener" class="lockup" aria-label={`${COMPANY.name}, miembro de NVIDIA Inception`}>
      <img src="/nvidia-inception-badge.svg" alt="" width="190" height="82" loading="lazy" decoding="async" class="badge" />
    </a>
  </div>
</section>

<style>
  /* overflow: clip y no hidden: hidden vuelve la sección un contenedor de scroll y la ola del título (WaveTitle)
     seguiría el scroll de la sección, que nunca se mueve, en vez del de la página */
  .respaldo {
    position: relative;
    overflow: clip;
    margin-top: var(--gap);
    border-radius: var(--radius);
    background:
      radial-gradient(ellipse 45% 60% at 50% 0%, hsl(84 100% 40% / 0.1) 0%, transparent 70%),
      radial-gradient(ellipse 60% 70% at 50% 110%, hsl(222 100% 60% / 0.1) 0%, transparent 70%),
      hsl(220 40% 98.5%);
    box-shadow: inset 0 0 0 1px hsl(220 28% 92%);
    padding: clamp(64px, 8vw, 112px) clamp(20px, 4vw, 48px);
    scroll-margin-top: 14px;
  }
  /* Safari < 16 no conoce overflow: clip (tampoco las animaciones ligadas al scroll: ahí la ola va por JavaScript) */
  @supports not (overflow: clip) {
    .respaldo {
      overflow: hidden;
    }
  }
  /* Capa de la cuadrícula animada (ShapeGrid se desvanece sola hacia los bordes). */
  .grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .inner {
    position: relative;
    max-width: 980px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .kicker {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(222 30% 48%);
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .lead {
    margin: 18px 0 0;
    max-width: 560px;
    font-size: clamp(16px, 1.2vw, 17px);
    line-height: 1.6;
    color: hsl(210 10% 34%);
    text-wrap: pretty;
  }
  /* Los beneficios del programa, en la tinta del título para que resalten dentro del párrafo. */
  .lead strong {
    font-weight: 600;
    color: var(--ink);
  }

  /* El sello solo, sin caja: se levanta un poco con sombra al pasar el mouse. */
  .lockup {
    margin-top: clamp(32px, 4vw, 44px);
    display: inline-flex;
    border-radius: 6px;
    transition:
      transform 0.25s ease,
      filter 0.25s ease;
  }
  .lockup:hover {
    transform: translateY(-2px);
    filter: drop-shadow(0 14px 22px hsl(222 70% 30% / 0.18));
  }
  .badge {
    display: block;
    width: auto;
    height: 96px;
  }

  @media (max-width: 479px) {
    .badge {
      height: 76px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lockup:hover {
      transform: none;
    }
  }
</style>
