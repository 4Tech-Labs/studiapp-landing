---
import { Image } from 'astro:assets';
import companyLogo from '../assets/4techlabs-logo.png';
import { COMPANY } from '../data/site';

// Membresía en NVIDIA Inception (aprobada el 23-oct-2026). El sello es el SVG oficial sin modificar
// (guía: https://design.nvidia.com/partners/inception/nvidia-inception-program/member-badge):
// no cambiar colores, proporciones ni texto, y no mostrarlo más grande que el logo de la empresa.
---

<section id="respaldo" aria-labelledby="respaldo-titulo" class="respaldo" data-screen-label="Respaldo">
  <div aria-hidden="true" class="grid-bg"></div>
  <div class="inner">
    <p class="kicker">Respaldo</p>
    <h2 id="respaldo-titulo">Somos parte de <span class="accent">NVIDIA Inception</span></h2>
    <p class="lead">
      {COMPANY.name} fue aceptada en NVIDIA Inception, el programa de NVIDIA para startups que construyen con inteligencia artificial.
    </p>

    <a href="https://www.nvidia.com/en-us/startups/" target="_blank" rel="noopener" class="lockup" aria-label={`${COMPANY.name}, miembro de NVIDIA Inception`}>
      <Image src={companyLogo} alt="" height={96} densities={[1, 2]} class="company" />
      <span aria-hidden="true" class="times">×</span>
      <img src="/nvidia-inception-badge.svg" alt="" width="190" height="82" loading="lazy" decoding="async" class="badge" />
    </a>
  </div>
</section>

<style>
  .respaldo {
    position: relative;
    overflow: hidden;
    margin-top: var(--gap);
    border-radius: var(--radius);
    background:
      radial-gradient(ellipse 45% 60% at 50% 0%, hsl(84 100% 40% / 0.1) 0%, transparent 70%),
      radial-gradient(ellipse 60% 70% at 50% 110%, hsl(222 100% 60% / 0.1) 0%, transparent 70%),
      hsl(220 40% 98.5%);
    box-shadow: inset 0 0 0 1px hsl(220 28% 92%);
    padding: clamp(64px, 8vw, 112px) clamp(20px, 4vw, 48px);
    scroll-margin-top: 14px;
  }
  /* Cuadrícula tenue que se desvanece hacia los bordes. */
  .grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(hsl(222 40% 50% / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, hsl(222 40% 50% / 0.07) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: center top;
    -webkit-mask-image: radial-gradient(ellipse 70% 75% at 50% 45%, #000 30%, transparent 100%);
    mask-image: radial-gradient(ellipse 70% 75% at 50% 45%, #000 30%, transparent 100%);
  }
  .inner {
    position: relative;
    max-width: 980px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .kicker {
    margin: 0 0 14px;
    font-family: var(--font-inter);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(222 30% 48%);
  }
  h2 {
    margin: 0;
    font-family: var(--font-inter-tight);
    font-weight: 600;
    font-size: clamp(2.125rem, 4.4vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .accent {
    color: var(--accent);
  }
  .lead {
    margin: 18px 0 0;
    max-width: 560px;
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.6;
    color: hsl(210 10% 34%);
    text-wrap: pretty;
  }

  /* Logo de la empresa × sello. El sello visible (~59 px de alto) queda más bajo que el logo (96 px). */
  .lockup {
    margin-top: clamp(36px, 4.5vw, 52px);
    display: inline-flex;
    align-items: center;
    gap: clamp(20px, 3.5vw, 40px);
    padding: clamp(22px, 3vw, 32px) clamp(28px, 4.5vw, 56px);
    border-radius: 24px;
    background: hsl(0 0% 100%);
    box-shadow:
      inset 0 0 0 1px hsl(220 28% 91%),
      0 24px 50px -28px hsl(222 70% 30% / 0.35);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .lockup:hover {
    transform: translateY(-2px);
    box-shadow:
      inset 0 0 0 1px hsl(222 60% 82%),
      0 30px 60px -28px hsl(222 70% 30% / 0.45);
  }
  .lockup :global(.company) {
    display: block;
    width: auto;
    height: 96px;
  }
  .times {
    font-family: var(--font-inter-tight);
    font-size: 28px;
    font-weight: 400;
    line-height: 1;
    color: hsl(220 15% 70%);
  }
  .badge {
    display: block;
    width: auto;
    height: 82px;
  }

  @media (max-width: 479px) {
    .lockup {
      gap: 16px;
      padding: 18px 20px;
    }
    .lockup :global(.company) {
      height: 72px;
    }
    .badge {
      height: 62px;
    }
    .times {
      font-size: 22px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lockup:hover {
      transform: none;
    }
  }
</style>
