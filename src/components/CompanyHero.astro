---
import GhostFibers from './GhostFibers.astro';

// Hero del home de la empresa, réplica del diseño de referencia:
// - el titular y la bajada entran palabra por palabra desde un desenfoque;
// - de fondo, las fibras animadas de GhostFibers (azules de la marca, modo claro);
// - al salir del hero con el scroll, el texto se desenfoca y las fibras se desvanecen.
//   El script escribe ese avance en --p (0 a 1); sin JS o con movimiento reducido el hero queda quieto.
// El titular dice qué hacemos con la palabra clave principal (software a la medida); la bajada concreta qué
// construimos y qué gana el cliente con acciones, no adjetivos. El país va en el <title>.
const title = ['Convertimos tus ideas', 'en software a la medida'];
// Bajada: una sola frase partida en dos renglones, como en la referencia (Mobbin); en celular fluye en un solo bloque.
const lead = [
  'Creamos plataformas web, aplicaciones móviles y soluciones con IA',
  'que automatizan tareas, simplifican procesos e impulsan tus resultados.',
];

let i = 0;
const titleLines = title.map((line) => line.split(' ').map((w) => ({ w, i: i++ })));
const leadLines = lead.map((line) => line.split(' ').map((w) => ({ w, i: i++ })));
const ctaDelay = i;
// Botón: cada letra va en su propio span para la animación de cambio al pasar el mouse (los espacios, como espacio duro).
const ctaText = 'Contáctanos';
const ctaChars = [...ctaText].map((c, n) => ({ c: c === ' ' ? '\u00a0' : c, n: n + 1 }));

---

<section id="inicio" aria-labelledby="ch-titulo" class="ch" data-ch data-screen-label="Hero">
  <div class="stage">
    <div aria-hidden="true" class="fibers">
      <GhostFibers
        glowColor="#1d7dd9"
        layers={2}
        twist={0.7}
        threads={120}
        fiberStyle="lines"
        depthOfField={0.45}
        hoverEffect="focus"
        intro={true}
        mouseInteraction={true}
        lineColor="#1d7dd9"
        secondaryColor="#0144a0"
        waves={1.5}
        volume={1.1}
        foldGlow={2}
        particles={0.25}
        sparkle={0.2}
        lightMode
      />
    </div>

    <div class="copy">
      <h1 id="ch-titulo">
        {
          titleLines.map((line) => (
            <span class="line">
              {line.map(({ w, i }) => (
                <>
                  <span class="w" style={`--i:${i}`}>
                    {w}
                  </span>{' '}
                </>
              ))}
            </span>
          ))
        }
      </h1>
      <p class="lead">
        {
          leadLines.map((line) => (
            <span class="line">
              {line.map(({ w, i }) => (
                <>
                  <span class="w" style={`--i:${i}`}>
                    {w}
                  </span>{' '}
                </>
              ))}
            </span>
          ))
        }
      </p>
      <a href="#contacto" class="cta" style={`--i:${ctaDelay}`} aria-label={ctaText}>
        <span class="btn">
          <span aria-hidden="true" class="bg"></span>
          <svg aria-hidden="true" class="splash" viewBox="0 0 342 208" preserveAspectRatio="none" fill="none">
            <path d="M54.1054 99.7837C54.1054 99.7837 40.0984 90.7874 26.6893 97.6362C13.2802 104.485 1.5 97.6362 1.5 97.6362"></path>
            <path d="M285.273 99.7841C285.273 99.7841 299.28 90.7879 312.689 97.6367C326.098 104.486 340.105 95.4893 340.105 95.4893"></path>
            <path class="faint" d="M281.133 64.9917C281.133 64.9917 287.96 49.8089 302.934 48.2295C317.908 46.6501 319.712 36.5272 319.712 36.5272"></path>
            <path class="faint" d="M281.133 138.984C281.133 138.984 287.96 154.167 302.934 155.746C317.908 157.326 319.712 167.449 319.712 167.449"></path>
            <path d="M230.578 57.4476C230.578 57.4476 225.785 41.5051 236.061 30.4998C246.337 19.4945 244.686 12.9998 244.686 12.9998"></path>
            <path d="M230.578 150.528C230.578 150.528 225.785 166.471 236.061 177.476C246.337 188.481 244.686 194.976 244.686 194.976"></path>
            <path class="faint" d="M170.392 57.0278C170.392 57.0278 173.89 42.1322 169.571 29.54C165.252 16.9478 168.751 2.05227 168.751 2.05227"></path>
            <path class="faint" d="M170.392 150.948C170.392 150.948 173.89 165.844 169.571 178.436C165.252 191.028 168.751 205.924 168.751 205.924"></path>
            <path d="M112.609 57.4476C112.609 57.4476 117.401 41.5051 107.125 30.4998C96.8492 19.4945 98.5 12.9998 98.5 12.9998"></path>
            <path d="M112.609 150.528C112.609 150.528 117.401 166.471 107.125 177.476C96.8492 188.481 98.5 194.976 98.5 194.976"></path>
            <path class="faint" d="M62.2941 64.9917C62.2941 64.9917 55.4671 49.8089 40.4932 48.2295C25.5194 46.6501 23.7159 36.5272 23.7159 36.5272"></path>
            <path class="faint" d="M62.2941 145.984C62.2941 145.984 55.4671 161.167 40.4932 162.746C25.5194 164.326 23.7159 174.449 23.7159 174.449"></path>
          </svg>
          <span class="wrap">
            <span aria-hidden="true" class="outline"></span>
            <span aria-hidden="true" class="content">
              <span class="chars">{ctaChars.map(({ c, n }) => <span data-label={c} style={`--n:${n}`}>{c}</span>)}</span>
              <span class="arrow"><span></span></span>
            </span>
          </span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .ch {
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    font-family: var(--font-sans);
    --p: 0;
    --nav-h: 84px;
    position: relative;
    border-radius: var(--radius);
    overflow: clip;
    background: hsl(228 33% 98%);
    color: hsl(232 30% 12%);
  }
  /* Safari < 16 no conoce overflow: clip y las fibras se saldrían de las esquinas redondeadas. Va en @supports y no
     como declaración duplicada porque el minificador de CSS descarta la duplicada. */
  @supports not (overflow: clip) {
    .ch {
      overflow: hidden;
    }
  }
  .stage {
    position: relative;
    padding: calc(var(--nav-h) + 96px) clamp(16px, 4vw, 48px) clamp(24px, 4vw, 48px);
  }

  /* Fibras animadas de fondo: se desvanecen al salir del hero. */
  .fibers {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: calc(1 - var(--p) * 1.2);
    /* Detrás del titular y la bajada las fibras casi desaparecen para que el texto siempre se lea; en los bordes siguen intactas. */
    --mask: radial-gradient(ellipse 44% 24% at 50% 46%, rgb(0 0 0 / 0.08) 0%, rgb(0 0 0 / 0.3) 55%, #000 100%);
    -webkit-mask-image: var(--mask);
    mask-image: var(--mask);
  }

  /* Texto */
  .copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 1120px;
    margin: 0 auto;
    opacity: calc(1 - var(--p) * 2.2);
  }
  /* El desenfoque y la subida solo mientras el hero sale (data-leaving lo pone el script). En reposo no lleva filter
     ni transform: con un filter puesto, aunque sea blur(0), Safari de iPhone pinta el botón como una imagen y la luz
     que gira en su borde se veía pixelada. */
  .ch[data-leaving] .copy {
    filter: blur(calc(var(--p) * 16px));
    transform: translateY(calc(var(--p) * -70px));
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    /* 500 y no 600: a este tamaño el tamaño ya marca la jerarquía, y las landings de software (Linear: Inter 510,
       −0,022em; Stripe, Vercel y Figma más livianas) usan pesos medios en el titular principal. */
    font-weight: 500;
    font-size: clamp(2.3rem, 5.2vw, 4.6rem);
    line-height: 1.06;
    letter-spacing: -0.022em;
    /* En celular el segundo renglón se parte: balanceado queda «que hace crecer / tu negocio» y no una palabra sola */
    text-wrap: balance;
  }
  .line {
    display: block;
  }
  .w {
    display: inline-block;
    animation: blurIn 0.9s calc(0.2s + var(--i) * 0.07s) var(--ease) backwards;
  }
  /* Bajada de 20 px como máximo, en el rango de las landings de referencia (Linear 16, Framer 18, Notion 20 px): en
     22 px se veía tan ancha como el titular y los dos bloques competían */
  .lead {
    margin: 26px 0 0;
    font-size: clamp(17px, 1.4vw, 20px);
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: hsl(232 10% 40%);
    text-wrap: balance;
  }
  .lead .w {
    animation-duration: 0.7s;
    animation-delay: calc(0.2s + var(--i) * 0.045s);
  }
  /* Botón 3D inclinado (adaptado de un diseño de Uiverse) en el azul de la marca:
     sombra escalonada hacia abajo a la izquierda, borde con luz que gira y flecha que se balancea (siempre activos),
     letras que ruedan al pasar el mouse y salpicadura al hacer clic. */
  .cta {
    --white: #eef5ff;
    --b100: #9ccbff;
    --b200: #5c9df0;
    --b300: #2f78d6;
    --b400: #0144a0;
    --b500: #012c6b;
    --r: 16px;
    display: inline-block;
    margin-top: 34px;
    border-radius: var(--r);
    animation: blurIn 0.9s calc(0.2s + var(--i) * 0.045s) var(--ease) backwards;
  }
  .cta:focus-visible {
    outline: 2px solid var(--b300);
    outline-offset: 8px;
  }
  .btn {
    position: relative;
    display: block;
    height: 58px;
    border-radius: inherit;
    transform: rotate(-2deg);
    transition: transform 0.3s var(--ease);
  }
  .bg {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    filter: blur(1px);
  }
  .bg::before,
  .bg::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: calc(var(--r) * 1.1);
    background: var(--b500);
  }
  .bg::before {
    filter: blur(5px);
    transition: all 0.3s ease;
    box-shadow:
      -4px 4px 0 0 rgb(1 50 120 / 30%),
      -9px 9px 4px 0 rgb(1 50 120 / 16%),
      -2px 18px 28px -6px rgb(1 68 160 / 35%);
  }
  .wrap {
    position: relative;
    display: block;
    height: 100%;
    padding: 3px;
    border-radius: inherit;
    overflow: hidden;
    background: linear-gradient(to bottom, var(--b100) 0%, var(--b400) 100%);
    transform: translate(8px, -8px);
    transition: all 0.3s ease;
  }
  .outline {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    opacity: 1;
    transition: all 0.4s ease;
  }
  .outline::before {
    content: '';
    position: absolute;
    inset: 2px;
    width: 120px;
    height: 400px;
    margin: auto;
    background: linear-gradient(to right, transparent 0%, white 50%, transparent 100%);
    animation: spin 3s linear infinite;
  }
  .content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    height: 100%;
    padding: 0 26px;
    border-radius: calc(var(--r) * 0.85);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    background: linear-gradient(to bottom, var(--b300) 0%, var(--b400) 100%);
    box-shadow:
      inset -2px 12px 11px -5px var(--b200),
      inset 1px -3px 11px 0 rgb(0 0 0 / 35%);
    transition: all 0.3s ease;
  }
  .content::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 10;
    width: 80%;
    top: 45%;
    bottom: 35%;
    margin: auto;
    opacity: 0.7;
    background: linear-gradient(to bottom, transparent, var(--b400));
    filter: brightness(1.3) blur(5px);
  }
  /* Las letras van por encima del brillo interno (.content::before), que antes las oscurecía. */
  .chars {
    position: relative;
    z-index: 11;
    display: flex;
    align-items: center;
  }
  .chars span {
    position: relative;
    display: block;
    color: transparent;
  }
  .chars span::before,
  .chars span::after {
    content: attr(data-label);
    position: absolute;
    left: 0;
    color: #fff;
    text-shadow: 0 1px 2px rgb(1 30 80 / 30%);
  }
  .chars span::before {
    opacity: 0;
    transform: translateY(-100%);
  }
  .arrow {
    position: relative;
    z-index: 10;
  }
  .arrow span,
  .arrow span::before,
  .arrow span::after {
    display: block;
    height: 3px;
    border-radius: 1px;
    background-color: var(--white);
  }
  .arrow span {
    position: relative;
    width: 22px;
    transform: scale(0.9);
    background: linear-gradient(to bottom, var(--white), var(--b100));
    box-shadow: -2px 2px 5px var(--b400);
    animation: swingArrow 1.8s ease-in-out infinite;
  }
  .arrow span::before,
  .arrow span::after {
    content: '';
    position: absolute;
    right: 0;
    width: 13px;
    border-radius: 15px;
    transform-origin: center right;
  }
  .arrow span::before {
    top: 1px;
    transform: rotate(44deg);
    box-shadow: 1px -2px 3px -1px var(--b400);
    animation: rotateArrowLine 1s linear infinite;
  }
  .arrow span::after {
    bottom: 1px;
    transform: rotate(316deg);
    box-shadow: -2px 2px 3px 0 var(--b400);
    background: linear-gradient(200deg, var(--white), var(--b100));
    animation: rotateArrowLine2 1s linear infinite;
  }
  .splash {
    position: absolute;
    left: -26%;
    top: -80%;
    width: 155%;
    height: 260%;
    pointer-events: none;
    stroke: var(--b300);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 60 60;
    stroke-dashoffset: 60;
    /* Oculta en reposo: con trazo que no escala, el guion puede asomar aunque el desfase lo esconda. */
    opacity: 0;
  }
  .splash path {
    vector-effect: non-scaling-stroke;
  }
  .splash .faint {
    stroke-opacity: 0.3;
  }

  /* Estados: el efecto de hover (levantado, luz y flecha) está siempre activo; al pasar el mouse ruedan las letras. */
  .cta:hover .btn {
    transform: rotate(-2deg) translateY(-2px);
  }
  .cta:hover .wrap {
    transform: translate(10px, -10px);
    filter: brightness(1.08);
  }
  .cta:hover .chars span::before {
    animation: charAppear 0.7s ease calc(var(--n) * 0.025s);
  }
  .cta:hover .chars span::after {
    opacity: 1;
    animation: charDisappear 0.7s ease calc(var(--n) * 0.025s);
  }
  .cta:active .bg::before {
    opacity: 0.7;
    box-shadow:
      -7px 6px 0 0 rgb(1 50 120 / 40%),
      -14px 12px 0 0 rgb(1 50 120 / 25%),
      -21px 18px 4px 0 rgb(1 50 120 / 15%);
  }
  .cta:active .content {
    box-shadow:
      inset -1px 12px 8px -5px rgb(1 30 90 / 40%),
      inset 0 -3px 8px 0 var(--b200);
  }
  .cta:active .outline {
    opacity: 0;
  }
  .cta:active .wrap {
    transform: translate(3px, -3px);
  }
  .cta:active .splash {
    animation: splash 0.8s cubic-bezier(0.3, 0, 0, 1) forwards 0.05s;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes charAppear {
    0% {
      transform: translateY(50%);
      opacity: 0;
      filter: blur(20px);
    }
    20% {
      transform: translateY(70%);
      opacity: 1;
    }
    50% {
      transform: translateY(-15%);
      opacity: 1;
      filter: blur(0);
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }
  @keyframes charDisappear {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    100% {
      transform: translateY(-70%);
      opacity: 0;
      filter: blur(3px);
    }
  }
  @keyframes swingArrow {
    50% {
      transform: translateX(4px) scale(0.9);
    }
  }
  @keyframes rotateArrowLine {
    50% {
      transform: rotate(30deg);
    }
    80% {
      transform: rotate(55deg);
    }
  }
  @keyframes rotateArrowLine2 {
    50% {
      transform: rotate(330deg);
    }
    80% {
      transform: rotate(300deg);
    }
  }
  @keyframes splash {
    from {
      opacity: 1;
    }
    to {
      opacity: 1;
      stroke-dasharray: 2 60;
      stroke-dashoffset: -60;
    }
  }
  /* Se usa con fill backwards y no both: con both el valor final (filter: blur(0)) se quedaba puesto para siempre y
     Safari de iPhone pintaba el botón como imagen de baja resolución. El final coincide con el estilo normal, así que
     al terminar no salta nada. */
  @keyframes blurIn {
    from {
      opacity: 0;
      filter: blur(12px);
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }
  /* Escritorio: el hero ocupa una pantalla. */
  @media (min-width: 900px) and (min-height: 600px) {
    .stage {
      min-height: calc(100svh - var(--gap) * 2);
      padding-top: calc(var(--nav-h) + 15svh);
    }
  }

  /* Pantallas pequeñas */
  @media (max-width: 899px), (max-height: 599px) {
    .stage {
      padding-top: calc(var(--nav-h) + 80px);
      padding-bottom: 120px;
    }
  }
  @media (max-width: 599px) {
    .fibers {
      --mask: radial-gradient(ellipse 70% 26% at 50% 50%, rgb(0 0 0 / 0.08) 0%, rgb(0 0 0 / 0.3) 55%, #000 100%);
    }
    .stage {
      padding-top: calc(var(--nav-h) + 56px);
    }
    .line {
      display: inline;
    }
  }
</style>

<script>
  // Avance del scroll mientras el hero sale de la pantalla (0 arriba, 1 cuando ya salió). Solo con movimiento
  // permitido, y el listener de scroll solo existe mientras el hero está en pantalla (más abajo --p ya vale 1).
  const hero = document.querySelector<HTMLElement>('[data-ch]');
  if (hero) {
    const mq = matchMedia('(prefers-reduced-motion: no-preference)');
    let frame = 0;
    let inView = false;
    const update = () => {
      frame = 0;
      const r = hero.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / r.height));
      hero.style.setProperty('--p', p.toFixed(4));
      hero.toggleAttribute('data-leaving', p > 0);
    };
    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    const setup = () => {
      if (mq.matches && inView) {
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll);
      } else {
        removeEventListener('scroll', onScroll);
        removeEventListener('resize', onScroll);
      }
      if (mq.matches) update();
      else {
        hero.style.setProperty('--p', '0');
        hero.removeAttribute('data-leaving');
      }
    };
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      setup();
    }).observe(hero);
    mq.addEventListener('change', setup);
  }
</script>
