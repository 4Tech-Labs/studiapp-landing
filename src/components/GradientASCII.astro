---
// Degradado de luz dibujado con caracteres ASCII en WebGL2 (port sin React de <GradientASCII /> de React Bits,
// ver src/lib/gradient-ascii.js). Las props son las mismas del componente original; se pasan al script como JSON en data-options.
// Llena su contenedor: el padre necesita position relative y un alto. Las zonas oscuras quedan transparentes.
interface Props {
  colors?: string[];
  shape?: 'horizon' | 'pinch' | 'rise' | 'eclipse';
  characters?: string;
  cellSize?: number;
  density?: number;
  glyphOpacity?: number;
  gradientOpacity?: number;
  glow?: number;
  depthOfField?: number;
  flicker?: number;
  softness?: number;
  scale?: number;
  flow?: number;
  speed?: number;
  grain?: number;
  variation?: number;
  mouseInteraction?: boolean;
  scrambleRadius?: number;
  clickEffect?: 'wave' | 'burst' | 'none';
  intro?: boolean;
  lightMode?: boolean;
  fontFamily?: string;
  dpr?: number;
  class?: string;
}

// Astro agrega atributos data-astro-cid-* de quien usa el componente: no son opciones del degradado.
const { class: className, ...props } = Astro.props;
const options = Object.fromEntries(Object.entries(props).filter(([key]) => !key.startsWith('data-')));
---

<div class:list={['gradient-ascii-container', className]} data-gradient-ascii data-options={JSON.stringify(options)}>
  <canvas class="gradient-ascii-canvas" aria-hidden="true"></canvas>
</div>

<style>
  .gradient-ascii-container {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .gradient-ascii-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { mountGradientASCII } from '../lib/gradient-ascii.js';

  // Se monta (contexto WebGL, shaders y atlas de caracteres) solo cuando el contenedor se acerca a la pantalla.
  const lazy = new IntersectionObserver(
    (entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        if (!isIntersecting) return;
        lazy.unobserve(target);
        const el = target as HTMLElement;
        mountGradientASCII(el, JSON.parse(el.dataset.options || '{}'));
      });
    },
    { rootMargin: '300px' },
  );
  document.querySelectorAll<HTMLElement>('[data-gradient-ascii]').forEach((el) => lazy.observe(el));
</script>
