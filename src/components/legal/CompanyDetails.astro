---
import { SITE, COMPANY } from '../../data/site';

interface Props {
  /** La dirección física es obligatoria en la política de tratamiento; en el resumen de privacidad basta con los datos de contacto. */
  address?: boolean;
}

const { address = false } = Astro.props;
const tel = `tel:${COMPANY.phone.replace(/\s/g, '')}`;
---

<dl class="company">
  <div>
    <dt>Razón social</dt>
    <dd>{COMPANY.legalName}</dd>
  </div>
  <div>
    <dt>Domicilio</dt>
    <dd>{COMPANY.domicile}</dd>
  </div>
  {
    address && (
      <div>
        <dt>Dirección</dt>
        <dd>{COMPANY.address}</dd>
      </div>
    )
  }
  <div>
    <dt>Correo electrónico</dt>
    <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
  </div>
  <div>
    <dt>Teléfono</dt>
    <dd><a href={tel}>{COMPANY.phone}</a></dd>
  </div>
</dl>

<style>
  .company {
    margin: 16px 0 0;
    padding: clamp(18px, 3vw, 24px) clamp(20px, 3vw, 28px);
    display: grid;
    gap: 12px;
    background: hsl(222 100% 98%);
    border: 1px solid hsl(222 60% 91%);
    border-radius: 16px;
  }
  .company div {
    display: grid;
    grid-template-columns: 10.5rem 1fr;
    gap: 2px 16px;
    align-items: baseline;
  }
  dt {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  dd {
    margin: 0;
    font-weight: 500;
    line-height: 1.6;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  @media (max-width: 479px) {
    .company div {
      grid-template-columns: 1fr;
    }
  }
</style>
