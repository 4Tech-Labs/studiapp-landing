---
import Base from '../layouts/Base.astro';
import CompanyNav from '../components/CompanyNav.astro';
import CompanyHero from '../components/CompanyHero.astro';
import Catalog from '../components/Catalog.astro';
import Team from '../components/Team.astro';
import Nosotros from '../components/Nosotros.astro';
import Respaldo from '../components/Respaldo.astro';
import Agenda from '../components/Agenda.astro';
import Footer from '../components/Footer.astro';
---

<!-- Home de 4Tech Labs: la empresa y su catálogo. Cada producto tiene su propia landing (StudIApp en /studiapp). -->
<Base>
  <CompanyNav />
  <main>
    <CompanyHero />
    <Catalog />
    <Team />
    <Nosotros />
    <Respaldo />
    <Agenda variant="company" />
  </main>
  <Footer />
</Base>
