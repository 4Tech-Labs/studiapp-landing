---
/**
 * Composición de 1200×630 para la imagen Open Graph del sitio de la empresa (public/og-4techlabs.jpg; la de StudIApp
 * sale de /og-studiapp). No aparece en el sitemap y lleva noindex. Se captura con Chrome headless y se pasa a JPG:
 *   chrome --headless=new --screenshot=og.png --window-size=1200,630 --hide-scrollbars http://127.0.0.1:4322/og
 * Si cambia la imagen, se publica con otro nombre (og-4techlabs-2.jpg…): LinkedIn y WhatsApp la guardan en caché por URL.
 */
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import logo from '../assets/4techlabs-logo.png';
import { SITE, COMPANY } from '../data/site';

// Fibras quietas con los azules del hero (GhostFibers no se puede capturar: dibuja en un worker). Dos haces de curvas
// que cruzan de lado a lado; la máscara las borra detrás del texto.
const fibers = (n: number, from: [number, number], to: [number, number], bend: [number, number]) =>
  Array.from({ length: n }, (_, i) => {
    const t = i / (n - 1);
    const y0 = from[0] + (from[1] - from[0]) * t;
    const y1 = to[0] + (to[1] - to[0]) * t;
    const c1 = bend[0] + Math.sin(t * Math.PI) * 90;
    const c2 = bend[1] - Math.cos(t * Math.PI) * 70;
    return { d: `M -40 ${y0.toFixed(1)} C 360 ${c1.toFixed(1)}, 820 ${c2.toFixed(1)}, 1240 ${y1.toFixed(1)}`, t };
  });
const bundles = [
  ...fibers(46, [470, 650], [140, 330], [690, 40]),
  ...fibers(34, [60, 180], [520, 640], [-60, 700]),
];
---

<Base title={`Imagen para compartir | ${SITE.name}`} noindex>
  <div class="og">
    <svg class="fibers" viewBox="0 0 1200 630" preserveAspectRatio="none" aria-hidden="true">
      {bundles.map(({ d, t }, i) => <path d={d} stroke={i % 3 === 0 ? '#0144a0' : '#1d7dd9'} stroke-opacity={(0.18 + 0.32 * Math.sin(t * Math.PI)).toFixed(2)} />)}
    </svg>
    <div class="content">
      <Image src={logo} alt={COMPANY.name} height={92} densities={[1, 2]} loading="eager" class="logo" />
      <h1>Convertimos tus ideas <span>en software a la medida</span></h1>
      <p>Plataformas web, aplicaciones móviles y soluciones con IA.</p>
      <div class="url">{new URL(SITE.url).host}</div>
    </div>
  </div>
</Base>

<style>
  :global(body) {
    padding: 0;
    overflow: hidden;
  }
  /* La barra de Astro en `astro dev` saldría en la captura */
  :global(astro-dev-toolbar) {
    display: none;
  }
  .og {
    position: fixed;
    inset: 0;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background:
      radial-gradient(ellipse 55% 60% at 0% 100%, hsl(214 90% 60% / 0.16) 0%, transparent 70%),
      radial-gradient(ellipse 55% 60% at 100% 0%, hsl(222 95% 46% / 0.12) 0%, transparent 70%),
      hsl(228 33% 98%);
    font-family: var(--font-sans);
    color: hsl(232 30% 12%);
  }
  .fibers {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke-width: 1.1;
    /* Igual que en el hero: detrás del texto las fibras casi desaparecen y en los bordes siguen intactas */
    --mask: radial-gradient(ellipse 46% 42% at 50% 50%, rgb(0 0 0 / 0.05) 0%, rgb(0 0 0 / 0.25) 60%, #000 100%);
    -webkit-mask-image: var(--mask);
    mask-image: var(--mask);
  }
  .content {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 100px;
  }
  .logo {
    width: auto;
    height: 92px;
    margin-bottom: 30px;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 74px;
    line-height: 1.06;
    letter-spacing: -0.022em;
  }
  h1 span {
    display: block;
    color: var(--brand);
  }
  p {
    margin: 24px 0 0;
    font-size: 27px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: hsl(232 10% 40%);
  }
  .url {
    margin-top: 34px;
    padding: 10px 22px;
    border-radius: 9999px;
    background: hsl(0 0% 100% / 0.8);
    box-shadow: 0 0 0 1px hsl(222 60% 50% / 0.18);
    font-size: 19px;
    font-weight: 500;
    color: var(--brand);
  }
</style>
