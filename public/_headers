# Assets con hash en el nombre (imágenes, fuentes, JS): caché inmutable de un año
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/lottie/*
  Cache-Control: public, max-age=604800

# Videos versionados (-v1, -v2…): nombres inmutables, caché de un año
/videos/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes de la raíz (sin hash en el nombre): una semana. Si se reemplaza alguna, puede tardar ese tiempo en
# actualizarse en los navegadores que ya la tienen; para forzarlo, cambiar el nombre del archivo.
/nvidia-inception-badge.svg
  Cache-Control: public, max-age=604800
/logo.webp
  Cache-Control: public, max-age=604800
/4techlabs-logo.png
  Cache-Control: public, max-age=604800
/og-4techlabs.jpg
  Cache-Control: public, max-age=604800
/studiapp-og.jpg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon-96.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/studiapp-favicon.ico
  Cache-Control: public, max-age=604800
/studiapp-favicon-96.png
  Cache-Control: public, max-age=604800
/studiapp-apple-touch-icon.png
  Cache-Control: public, max-age=604800

# HSTS: después de la primera visita por HTTPS el navegador ya no intenta HTTP (un año, también www). Sin preload:
# entrar a la lista de los navegadores es difícil de revertir. La redirección de http:// a https:// la hace Cloudflare
# (SSL/TLS → Edge Certificates → Always Use HTTPS): HSTS no actúa en la primera visita.
# La CSP de scripts y estilos va en un <meta> por página (security.csp en astro.config.ts); frame-ancestors no puede
# ir en un <meta>, así que va aquí.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
